local GuiLibrary = { CurrentWindow = nil }

-- Capture trusted service references once. Real exposes cloneref, but the
-- fallback keeps the library compatible with executors that do not.
local function getService(name)
    local service = game:GetService(name)
    if type(cloneref)=="function" then
        local ok, ref = pcall(cloneref, service)
        if ok and ref then service = ref end
    end
    return service
end

