local elementIdCounts = setmetatable({}, {__mode="k"})

-- The first widget keeps the legacy ID, so old profiles still load. Repeated
-- labels get a deterministic suffix instead of overwriting each other.
local function makeElementId(tab, label, widgetType)
    setupGraceUntil=math.max(setupGraceUntil,os.clock()+0.5)
    local tabName=tostring((tab and tab.Name) or "Tab"):gsub("%s+","_")
    local labelName=tostring(label or widgetType or "Element"):gsub("%s+","_")
    local base=tabName.."_"..labelName.."_"..tostring(widgetType or "Element")
    local counts=elementIdCounts[tab]
    if not counts then counts={}; elementIdCounts[tab]=counts end
    counts[base]=(counts[base] or 0)+1
    if counts[base]==1 then return base end
    return base.."__"..tostring(counts[base])
end

local function disconnectConnection(connection)
    if not connection then return end
    if typeof(connection)=="RBXScriptConnection" then
        if connection.Connected then pcall(function() connection:Disconnect() end) end
    elseif type(connection)=="table" and type(connection.Disconnect)=="function" then
        pcall(connection.Disconnect)
    end
end

local function disconnectConnections(connections)
    for i=#connections,1,-1 do
        disconnectConnection(connections[i])
        connections[i]=nil
    end
end

local function safeCall(callback, ...)
    if type(callback)~="function" then return true, nil end
    local ok, result = pcall(callback, ...)
    if not ok then warn("[GuiLibrary] Callback failed: "..tostring(result)) end
    return ok, result
end

-- CoreGui is the primary parent as requested. gethui is only a compatibility
-- fallback when an executor denies direct CoreGui parenting.
local function parentToCoreGui(screenGui)
    local ok, err = pcall(function() screenGui.Parent=CoreGui end)
    if not ok and type(gethui)=="function" then
        local huiOk, hui = pcall(gethui)
        if huiOk and hui then
            ok, err = pcall(function() screenGui.Parent=hui end)
        end
    end
    if not ok then
        pcall(function() screenGui:Destroy() end)
        warn("[GuiLibrary] Unable to parent ScreenGui: "..tostring(err))
        return false
    end
    screenGui.Archivable=false
    rootGuis[screenGui]=true
    screenGui.Destroying:Connect(function() rootGuis[screenGui]=nil end)
    return true
end

-- ── Extended mouse button (MB4 / MB5) support ────────────────────────────────
-- Roblox's UserInputService only reports MouseButton1-3, so the two side
-- buttons never arrive through InputBegan. We read them straight from the OS
-- with GetAsyncKeyState (VK_XBUTTON1 = 0x05, VK_XBUTTON2 = 0x06), polled every
-- frame while the Roblox window is focused. This works on any executor that
-- exposes a GetAsyncKeyState-style function (Synapse X and most others); if
-- none is found the module stays disabled and everything else keeps working.
local SideButtons = { NAMES = { MB4 = 0x05, MB5 = 0x06 } }
do
    local env = (type(getgenv)=="function" and getgenv()) or _G or {}
    local function pick(...)   -- first callable arg (select handles nil holes)
        for i = 1, select("#", ...) do
            local f = select(i, ...)
            if type(f)=="function" then return f end
        end
        return nil
    end
    local synT = rawget(env,"syn") or rawget(_G,"syn")
    local keyState = pick(
        rawget(env,"GetAsyncKeyState"), rawget(env,"getasynckeystate"),
        rawget(_G ,"GetAsyncKeyState"), rawget(_G ,"getasynckeystate"),
        type(synT)=="table" and (synT.get_async_key_state or synT.getasynckeystate) or nil
    )
    local rbxActive = pick(rawget(env,"isrbxactive"), rawget(_G,"isrbxactive"))

    local function isDownRaw(vk)
        if not keyState then return false end
        local ok, v = pcall(keyState, vk)
        if not ok then return false end
        if type(v)=="boolean" then return v end
        if type(v)=="number"  then return v ~= 0 end   -- nonzero SHORT = held
        return false
    end
    function SideButtons.isDown(name)
        local vk = SideButtons.NAMES[name]
        return vk ~= nil and isDownRaw(vk)
    end

    local began, ended = {}, {}
    local function connect(store, fn)
        store[fn] = true
        return { Disconnect = function() store[fn] = nil end }
    end
    function SideButtons.onBegan(fn) return connect(began, fn) end
    function SideButtons.onEnded(fn) return connect(ended, fn) end

    local polling = false
    local function startPoll()
        if polling then return end
        polling = true
        local down = {}
        local pollConn = RunService.Heartbeat:Connect(function()
            local active = true
            if rbxActive then local ok,r = pcall(rbxActive); if ok then active = (r and true or false) end end
            for name,vk in pairs(SideButtons.NAMES) do
                local now = active and isDownRaw(vk)
                if now ~= (down[vk] or false) then
                    down[vk] = now
                    for fn in pairs(now and began or ended) do pcall(fn, name) end
                end
            end
        end)
        table.insert(libraryConnections, pollConn)
    end

    -- Escape hatch: if your executor exposes the key-state reader under a name we
    -- didn't auto-detect, wire it in with GuiLibrary.SideButtons.setProvider(fn).
    -- fn(virtualKeyCode) should return the WinAPI GetAsyncKeyState value.
    function SideButtons.setProvider(fn)
        if type(fn)~="function" then return false end
        keyState = fn
        SideButtons.enabled = true
        startPoll()
        return true
    end

    SideButtons.enabled = keyState ~= nil
    if SideButtons.enabled then startPoll() end
end
GuiLibrary.SideButtons = SideButtons

local function sanitizeProfileName(name)
    name=tostring(name or ""):gsub("^%s+",""):gsub("%s+$","")
    name=name:gsub("[^%w _%-]","_"):sub(1,64)
    if name=="" or name:lower()=="_active" then return "default" end
    return name
end
local function getPlaceFolder() return AUTO_SAVE_FOLDER .. "/" .. currentPlaceId end
local function getProfilePath(name) return getPlaceFolder() .. "/" .. sanitizeProfileName(name) .. ".json" end
local function getActivePointerPath() return getPlaceFolder() .. "/_active.txt" end
local function getAutoSavePath() return getProfilePath(activeProfile) end
local function ensureProfileFolders()
    pcall(function()
        if not isfolder(AUTO_SAVE_FOLDER) then makefolder(AUTO_SAVE_FOLDER) end
        if not isfolder(getPlaceFolder()) then makefolder(getPlaceFolder()) end
    end)
end
local function listProfiles()
    local out = {}
    pcall(function()
        if not isfolder(getPlaceFolder()) then return end
        for _, fname in ipairs(listfiles(getPlaceFolder()) or {}) do
            local n = tostring(fname):match("([^/\\]+)%.json$")
            if n and sanitizeProfileName(n)==n then table.insert(out, n) end
        end
    end)
    table.sort(out)
    if #out == 0 then table.insert(out, "default") end
    return out
end
local function readActivePointer()
    local name = nil
    pcall(function()
        if isfile(getActivePointerPath()) then
            name = readfile(getActivePointerPath())
            if name then name = (name:gsub("[%s\r\n]+$", ""):gsub("^[%s\r\n]+", "")) end
        end
    end)
    if not name or name == "" then return nil end
    return sanitizeProfileName(name)
end
local function writeActivePointer(name)
    name=sanitizeProfileName(name)
    ensureProfileFolders()
    pcall(function() writefile(getActivePointerPath(), tostring(name or "default")) end)
end
local function migrateOldFormatIfNeeded()
    local oldPath = AUTO_SAVE_FOLDER .. "/" .. currentPlaceId .. ".json"
    local newDefault = getProfilePath("default")
    local oldExists, newExists = false, false
    pcall(function() oldExists = isfile(oldPath) end)
    pcall(function() newExists = isfile(newDefault) end)
    if oldExists and not newExists then
        ensureProfileFolders()
        pcall(function()
            local raw = readfile(oldPath)
            writefile(newDefault, raw)
            delfile(oldPath)
        end)
        dprint("Migrated old config to profile 'default'")
    end
end
local function resolveActiveProfile()
    migrateOldFormatIfNeeded()
    local p = readActivePointer()
    if p then activeProfile = p
    else
        activeProfile = "default"
        ensureProfileFolders()
        writeActivePointer("default")
    end
end
local function countTable(t) local n=0; for _ in pairs(t or {}) do n=n+1 end; return n end
local function createTween(obj, props, t)
    if not obj or not obj.Parent then return nil end
    local ti = TweenInfo.new(t or ANIM_TIME, EASING_STYLE, EASING_DIR)
    local tw = TweenService:Create(obj, ti, props)
    tw:Play(); return tw
end
local function createCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent; return c
end
local function createStroke(parent, thickness, color)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Color = color or COLORS.BORDER
    s.Parent = parent; return s
end
local function updateElementColors(window, instant)
    local function apply(obj, props)
        if not obj then return end
        if instant then for k,v in pairs(props) do obj[k]=v end else createTween(obj,props) end
    end
    if window.MainFrame then
        apply(window.MainFrame, {BackgroundColor3=COLORS.PRIMARY})
        local s = window.MainFrame:FindFirstChildWhichIsA("UIStroke")
        if s then apply(s,{Color=COLORS.BORDER}) end
    end
    local tb = window.MainFrame and window.MainFrame:FindFirstChild("TitleBar")
    if tb then
        apply(tb,  {BackgroundColor3=COLORS.SECONDARY})
        apply(tb:FindFirstChild("TitleBarFill"), {BackgroundColor3=COLORS.SECONDARY})
        apply(tb:FindFirstChild("TitleAccent"),  {BackgroundColor3=COLORS.ACCENT})
        apply(tb:FindFirstChild("TitleLabel"),   {TextColor3=COLORS.TEXT})
        local fps = tb:FindFirstChild("FPSLabel")
        if fps then apply(fps,{BackgroundColor3=COLORS.HOVER,TextColor3=COLORS.SUCCESS}) end
        local sb = tb:FindFirstChild("SettingsButton")
        if sb then apply(sb,{TextColor3=COLORS.TEXT_MUTED}) end
        local cb = tb:FindFirstChild("CloseButton")
        if cb then apply(cb,{BackgroundColor3=COLORS.DANGER}) end
    end
    local cf = window.MainFrame and window.MainFrame:FindFirstChild("ContentFrame")
    if cf then
        local tbar = cf:FindFirstChild("TabBar")
        if tbar then
            apply(tbar, {BackgroundColor3=COLORS.SECONDARY})
            local sep = tbar:FindFirstChild("TabBarSeparator")
            if sep then apply(sep, {BackgroundColor3=COLORS.BORDER}) end
        end
    end
    for tabName, tab in pairs(window.Tabs or {}) do
        if tab.Button then
            local isActive = window.CurrentTab == tabName
            if isActive then
                apply(tab.Button,{BackgroundTransparency=1,TextColor3=COLORS.TEXT})
                tab.Button.Font=Enum.Font.GothamBold
                local ind=tab.Button:FindFirstChild("TabIndicator"); if ind then apply(ind,{BackgroundColor3=COLORS.ACCENT,BackgroundTransparency=0}) end
            else
                apply(tab.Button,{BackgroundTransparency=1,TextColor3=COLORS.TEXT_MUTED})
                tab.Button.Font=Enum.Font.Gotham
                local ind=tab.Button:FindFirstChild("TabIndicator"); if ind then apply(ind,{BackgroundTransparency=1}) end
            end
        end
        if tab.Content then apply(tab.Content,{ScrollBarImageColor3=COLORS.ACCENT}) end
        for _, el in ipairs(tab.Elements or {}) do
            if el and el:IsA("GuiObject") then
                local n = el.Name
                if n:match("Button") and not n:match("Tab") then
                    apply(el,{BackgroundColor3=COLORS.ACCENT,TextColor3=Color3.new(1,1,1)})
                elseif n:match("Toggle") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local sw = el:FindFirstChild("ToggleSwitch")
                    if sw then
                        local ind = sw:FindFirstChild("Indicator")
                        local isOn = el:GetAttribute("ToggleState")==1
                        apply(sw,{BackgroundColor3=isOn and COLORS.SUCCESS or COLORS.BORDER})
                        if ind then apply(ind,{BackgroundColor3=Color3.new(1,1,1)}) end
                    end
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.TEXT})
                elseif n:match("Slider") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local tr = el:FindFirstChild("SliderTrack")
                    if tr then
                        apply(tr,{BackgroundColor3=COLORS.BORDER})
                        local fill = tr:FindFirstChild("SliderFill")
                        if fill then apply(fill,{BackgroundColor3=COLORS.ACCENT}) end
                        local h = tr:FindFirstChild("SliderHandle")
                        if h then apply(h,{BackgroundColor3=Color3.new(1,1,1)}) end
                    end
                    apply(el:FindFirstChild("SliderLabel"),{TextColor3=COLORS.TEXT})
                    apply(el:FindFirstChild("SliderValue"),{TextColor3=COLORS.ACCENT})
                elseif n:match("Section") then
                    local bar = el:FindFirstChild("AccentBar")
                    if bar then apply(bar,{BackgroundColor3=COLORS.ACCENT}) end
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.ACCENT})
                elseif n:match("Label") then
                    apply(el,{TextColor3=COLORS.TEXT_MUTED})
                elseif n:match("Dropdown") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local btn = el:FindFirstChild("DropdownButton")
                    if btn then
                        apply(btn,{BackgroundColor3=COLORS.PRIMARY})
                        local lbl = btn:FindFirstChildWhichIsA("TextLabel")
                        if lbl then apply(lbl,{TextColor3=COLORS.TEXT}) end
                        local arrow = btn:FindFirstChild("DropdownArrow")
                        if arrow then apply(arrow,{TextColor3=COLORS.TEXT_MUTED}) end
                    end
                    local dl = dropdownLists[el]
                    if dl then
                        apply(dl,{BackgroundColor3=COLORS.PRIMARY,ScrollBarImageColor3=COLORS.ACCENT})
                        local ds = dl:FindFirstChildWhichIsA("UIStroke")
                        if ds then apply(ds,{Color=COLORS.BORDER}) end
                        for _,ob in ipairs(dl:GetChildren()) do
                            if ob:IsA("TextButton") then
                                apply(ob,{BackgroundColor3=COLORS.ACCENT})
                                local olbl=ob:FindFirstChildWhichIsA("TextLabel")
                                if olbl then apply(olbl,{TextColor3=COLORS.TEXT_MUTED}) end
                            end
                        end
                    end
                elseif n:match("Input") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local box = el:FindFirstChildWhichIsA("TextBox")
                    if box then apply(box,{BackgroundColor3=COLORS.PRIMARY,TextColor3=COLORS.TEXT,PlaceholderColor3=COLORS.TEXT_MUTED}) end
                elseif n:match("Keybind") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.TEXT})
                    local kb = el:FindFirstChild("KeybindButton")
                    if kb then apply(kb,{BackgroundColor3=COLORS.PRIMARY,TextColor3=COLORS.TEXT}) end
                elseif n:match("ColorPicker") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.TEXT})
                end
            end
        end
    end
end

local function decodeConfig(raw)
    if type(raw)~="string" or #raw==0 or #raw>MAX_CONFIG_BYTES then return nil end
    local ok, decoded=pcall(function() return HttpService:JSONDecode(raw) end)
    if ok and type(decoded)=="table" then return decoded end
    return nil
end

local function readValidFile(path)
    local exists=false
    pcall(function() exists=isfile(path) end)
    if not exists then return nil, nil end
    local ok, raw=pcall(function() return readfile(path) end)
    if not ok then return nil, nil end
    return decodeConfig(raw), raw
end

-- Real has no rename primitive, so use a verified staging file and keep a
-- last-known-good backup. A failed/truncated write is restored automatically.
local function writeConfigVerified(path, json)
    local tempPath=path..".tmp"
    local backupPath=path..".bak"
    local _, oldRaw=readValidFile(path)
    if oldRaw then pcall(function() writefile(backupPath,oldRaw) end) end

    local stagedOk, stagedErr=pcall(function() writefile(tempPath,json) end)
    if not stagedOk then return false, stagedErr end
    local stagedConfig, stagedRaw=readValidFile(tempPath)
    if not stagedConfig or stagedRaw~=json then
        pcall(function() delfile(tempPath) end)
        return false, "staging verification failed"
    end

    local writeOk, writeErr=pcall(function() writefile(path,stagedRaw) end)
    if not writeOk then
        pcall(function() delfile(tempPath) end)
        return false, writeErr
    end
    local finalConfig, finalRaw=readValidFile(path)
    if not finalConfig or finalRaw~=json then
        if oldRaw then pcall(function() writefile(path,oldRaw) end) end
        pcall(function() delfile(tempPath) end)
        return false, "final verification failed"
    end

    pcall(function() writefile(backupPath,json) end)
    pcall(function() delfile(tempPath) end)
    return true
end

local function saveConfig(window, force)
    if isInitializing or isLoadingConfig then return false end
    window = window or GuiLibrary.CurrentWindow
    if not window or not window.CurrentSize then return false end

    -- Constructors can restore values and request saves before the caller has
    -- finished creating all widgets. Queue those requests so a partial widget
    -- list never replaces a complete profile. Explicit/manual saves bypass it.
    if force==false and os.clock()<setupGraceUntil then
        queuedSaveWindow=window
        queuedSaveToken=queuedSaveToken+1
        local token=queuedSaveToken
        task.delay(math.max(setupGraceUntil-os.clock(),0),function()
            if token~=queuedSaveToken then return end
            local pending=queuedSaveWindow
            queuedSaveWindow=nil
            if pending and os.clock()<setupGraceUntil then
                saveConfig(pending,false)
                return
            end
            setupGraceUntil=0
            if pending then saveConfig(pending,true) end
        end)
        return true
    end
    ensureProfileFolders()
    local mfPos = window.MainFrame and window.MainFrame.Position or UDim2.new(0,0,0,0)
    local config = {
        FormatVersion      = 2,
        SavedAt            = os.time(),
        Profile            = activeProfile,
        UIScale            = window.CurrentSize.X.Offset/600,
        SizeWidth          = window.CurrentSize.X.Offset,
        SizeHeight         = window.CurrentSize.Y.Offset,
        PosX               = mfPos.X.Offset,
        PosY               = mfPos.Y.Offset,
        AnimationsEnabled  = (ANIM_TIME>0.05),
        NotificationsEnabled = GuiLibrary.NotificationsEnabled,
        NotificationDuration = GuiLibrary.NotificationDuration,
        LockPosition       = window.LockPosition or false,
        ShowFPS            = window.FPSLabel and window.FPSLabel.Visible or false,
        Theme              = nil,
        Components         = {},
    }
    for name, theme in pairs(themes) do
        local match=true
        for k,v in pairs(theme) do if not COLORS[k] or COLORS[k]~=v then match=false;break end end
        if match then config.Theme=name;break end
    end
    for _, tab in pairs(window.Tabs or {}) do
        for _, el in ipairs(tab.Elements or {}) do
            local id = el:GetAttribute("ElementID")
            if not id then
                local n = el.Name or ""
                id = makeElementId(tab,n,"Element")
                el:SetAttribute("ElementID",id)
            end
            local wt = el:GetAttribute("WidgetType")
            local data = nil
            if wt=="Toggle" then data={Type="Toggle",Value=el:GetAttribute("ToggleState")==1}
            elseif wt=="Slider" then data={Type="Slider",Value=el:GetAttribute("SliderValue") or 0}
            elseif wt=="Dropdown" then local v=el:GetAttribute("DropdownValue"); if v then data={Type="Dropdown",Value=v} end
            elseif wt=="ColorPicker" then local v=el:GetAttribute("ColorValue"); if v then local t=el:GetAttribute("TransparencyValue") or 0; data={Type="ColorPicker",Value=typeof(v)=="Color3" and {R=v.R,G=v.G,B=v.B,T=t} or v} end
            elseif wt=="Input" then local v=el:GetAttribute("InputValue"); if v then data={Type="Input",Value=v} end
            elseif wt=="Textbox" then local v=el:GetAttribute("TextboxValue"); if v then data={Type="Textbox",Value=v} end
            elseif wt=="Keybind" then local v=el:GetAttribute("KeybindValue"); if v and v~="None" then data={Type="Keybind",Value=v} end
            elseif wt=="MultiSelect" then local v=el:GetAttribute("MultiSelectValue"); if v then local ok,t=pcall(function() return HttpService:JSONDecode(v) end); if ok and type(t)=="table" then data={Type="MultiSelect",Value=t} end end
            elseif wt=="BindGroup" then local v=el:GetAttribute("BindGroupValue"); if v then local ok,t=pcall(function() return HttpService:JSONDecode(v) end); if ok and type(t)=="table" then data={Type="BindGroup",Value=t} end end
            elseif wt=="ColorGradient" then local v=el:GetAttribute("ColorGradientValue"); if v then local ok,t=pcall(function() return HttpService:JSONDecode(v) end); if ok and type(t)=="table" then data={Type="ColorGradient",Value=t} end end end
            if data then table.insert(config.Components,{ID=id,Data=data}) end
        end
    end
    local encodeOk, jsonStr = pcall(function() return HttpService:JSONEncode(config) end)
    if not encodeOk or type(jsonStr)~="string" then
        warn("[GuiLibrary] Config encode failed: "..tostring(jsonStr))
        return false
    end
    local wOk,wErr=writeConfigVerified(getAutoSavePath(),jsonStr)
    if wOk then
        dprint(string.format("Config saved → %s | profile=%s, components=%d, size=%dx%d, pos=(%d,%d)",
            getAutoSavePath(), activeProfile, #config.Components,
            config.SizeWidth, config.SizeHeight, config.PosX, config.PosY))
        return true
    else
        warn("[GuiLibrary] Save failed: "..tostring(wErr))
        return false
    end
end
GuiLibrary.SaveConfig = saveConfig
local function loadConfig(window)
    if not window then dprint("loadConfig: no window"); return false end
    resolveActiveProfile()
    local path=getAutoSavePath()
    local config,rawData=readValidFile(path)
    local recovered=false
    if not config then
        config,rawData=readValidFile(path..".bak")
        recovered=config~=nil
    end
    dprint("loadConfig: profile="..activeProfile.." path="..path.." valid="..tostring(config~=nil))
    if not config then dprint("No valid profile or backup → using defaults"); return false end
    if recovered then
        warn("[GuiLibrary] Main profile was invalid; recovered from backup")
        pcall(function() writefile(path,rawData) end)
    end
    dprint("loadConfig: raw bytes = "..#rawData)
    isLoadingConfig=true
    dprint(string.format("loadConfig: parsed | components=%d",
        config.Components and #config.Components or 0))
    if config.AnimationsEnabled~=nil then ANIM_TIME=config.AnimationsEnabled and 0.25 or 0.01 end
    if config.NotificationsEnabled~=nil then GuiLibrary.NotificationsEnabled=config.NotificationsEnabled==true end
    if config.NotificationDuration then GuiLibrary.NotificationDuration=math.clamp(tonumber(config.NotificationDuration) or 3,1,30) end
    if config.LockPosition~=nil then window.LockPosition=config.LockPosition==true end
    if config.ShowFPS~=nil and window.FPSLabel then window.FPSLabel.Visible=config.ShowFPS==true end
    if config.Theme and themes[config.Theme] then for k,v in pairs(themes[config.Theme]) do COLORS[k]=v end end
    local savedWidth, savedHeight = tonumber(config.SizeWidth), tonumber(config.SizeHeight)
    if savedWidth and savedHeight then
        local ns=UDim2.new(0,math.clamp(savedWidth,380,4096),0,math.clamp(savedHeight,280,2160))
        window.CurrentSize=ns; if window.MainFrame then window.MainFrame.Size=ns end
    elseif tonumber(config.UIScale) then
        local scale=math.clamp(tonumber(config.UIScale) or 1,0.5,4)
        local ns=UDim2.new(0,600*scale,0,400*scale)
        window.CurrentSize=ns; if window.MainFrame then window.MainFrame.Size=ns end
    end
    local savedX, savedY = tonumber(config.PosX), tonumber(config.PosY)
    if savedX and savedY then
        window.SavedPosition = UDim2.new(0, math.clamp(savedX,-4096,8192), 0, math.clamp(savedY,-2160,4320))
        if window.MainFrame then window.MainFrame.Position = window.SavedPosition end
    end
    restorationQueue={}
    for _,entry in ipairs(config.Components or {}) do restorationQueue[entry.ID]=entry.Data end
    dprint("loadConfig: restorationQueue populated with "..(config.Components and #config.Components or 0).." entries")
    local restoredCount = 0
    for _,tab in pairs(window.Tabs or {}) do
        for _,el in ipairs(tab.Elements or {}) do
            local id=el:GetAttribute("ElementID")
            if id and restorationQueue[id] then
                local setter=elementSetters[el]
                local val=restorationQueue[id].Value
                if setter and val~=nil then
                    local ok = pcall(setter, val, false)
                    if ok then
                        restoredCount = restoredCount + 1
                        dprint("  ✓ restored "..id.." = "..tostring(val))
                    end
                end
                restorationQueue[id]=nil
            end
        end
    end
    dprint("loadConfig: restored "..restoredCount.." existing widgets, "..countTable(restorationQueue).." pending for late-created widgets")
    updateElementColors(window,true)
    isLoadingConfig=false
    task.delay(2, function()
        GuiLibrary:CreateNotification("Profile",
            "Loaded profile '" .. activeProfile .. "'.", 3, "success")
    end)
    return true
end
GuiLibrary.LoadConfig = loadConfig
function GuiLibrary:TestFileSaving()
    print("[GuiLibrary] ===== FILE I/O TEST =====")
    local f="GuiLibrary_AutoSaves/test_"..tostring(game.PlaceId)..".json"
    local ok1=pcall(function() if not isfolder("GuiLibrary_AutoSaves") then makefolder("GuiLibrary_AutoSaves") end end)
    if not ok1 then print("✗ Folder failed"); return false end
    local ok2=pcall(function() writefile(f, HttpService:JSONEncode({test=true})) end)
    if not ok2 then print("✗ Write failed"); return false end
    local ok3,data=pcall(function() return HttpService:JSONDecode(readfile(f)) end)
    if not ok3 or not data then print("✗ Read failed"); return false end
    pcall(function() delfile(f) end)
    print("[GuiLibrary] ===== ALL PASSED ====="); return true
end
local function createLoader(parent, size)
    local f=Instance.new("Frame"); f.Size=UDim2.new(0,size,0,size)
    f.Position=UDim2.new(0.5,-size/2,0.5,-size/2); f.BackgroundTransparency=1; f.Parent=parent
    local dots={}; local n=8; local r=size*0.3
    for i=1,n do
        local d=Instance.new("Frame"); d.Size=UDim2.new(0,8,0,8); d.BackgroundColor3=COLORS.ACCENT
        d.BorderSizePixel=0; d.BackgroundTransparency=1-i/n; d.Parent=f; createCorner(d,4)
        local a=(i-1)*(2*math.pi/n)
        d.Position=UDim2.new(0.5,math.cos(a)*r-4,0.5,math.sin(a)*r-4)
        table.insert(dots,d)
    end
    task.spawn(function()
        local idx=1
        while f.Parent do
            createTween(dots[idx],{BackgroundTransparency=0},0.1); task.wait(0.08)
            createTween(dots[idx],{BackgroundTransparency=0.85},0.4); idx=(idx%n)+1
        end
    end)
    return f
end
function GuiLibrary:CreateButton(tab, text, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateButton: invalid tab"); return nil end
    text=tostring(text or "Button")
    local btn=Instance.new("TextButton"); btn.Name=text.."Button"
    btn.Size=UDim2.new(1,0,0,38); btn.BackgroundColor3=COLORS.ACCENT
    btn.Text=text; btn.TextColor3=Color3.new(1,1,1); btn.TextSize=13
    btn.Font=Enum.Font.GothamBold; btn.BorderSizePixel=0; btn.AutoButtonColor=false
    btn.Parent=tab.Content; createCorner(btn,8)
    local hl=Instance.new("Frame"); hl.Size=UDim2.new(1,0,0.5,0)
    hl.BackgroundColor3=Color3.new(1,1,1); hl.BackgroundTransparency=0.92
    hl.BorderSizePixel=0; hl.ZIndex=2; hl.Parent=btn; createCorner(hl,8)
    local function accentLighter()
        return Color3.fromRGB(math.min(math.floor(COLORS.ACCENT.R*255)+20,255),math.min(math.floor(COLORS.ACCENT.G*255)+20,255),math.min(math.floor(COLORS.ACCENT.B*255)+20,255))
    end
    local function accentDarker()
        return Color3.fromRGB(math.max(math.floor(COLORS.ACCENT.R*255)-25,0),math.max(math.floor(COLORS.ACCENT.G*255)-25,0),math.max(math.floor(COLORS.ACCENT.B*255)-25,0))
    end
    btn.MouseButton1Click:Connect(function()
        if callback then
            createTween(btn,{BackgroundColor3=accentDarker()},0.06); task.wait(0.09)
            createTween(btn,{BackgroundColor3=COLORS.ACCENT},0.18); safeCall(callback)
        end
    end)
    btn.MouseEnter:Connect(function() createTween(btn,{BackgroundColor3=accentLighter()}) end)
    btn.MouseLeave:Connect(function() createTween(btn,{BackgroundColor3=COLORS.ACCENT}) end)
    table.insert(tab.Elements,btn)
    local api
    api = {
        Instance = btn,
        Frame    = btn,
        GetText  = function() return btn.Text end,
        SetText  = function(newText)
            btn.Text = tostring(newText or "")
            return api
        end,
        SetCallback = function(cb) callback = cb; return api end,
        SetVisible  = function(v) btn.Visible = v and true or false; return api end,
    }
    return api
end
function GuiLibrary:CreateToggle(tab, text, default, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateToggle: invalid tab"); return nil end
    text=tostring(text or "Toggle")
    local f=Instance.new("Frame"); f.Name=text.."Toggle"
    f.Size=UDim2.new(1,0,0,40); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-70,1,0)
    lbl.Position=UDim2.new(0,14,0,0); lbl.BackgroundTransparency=1; lbl.Text=text
    lbl.TextColor3=COLORS.TEXT; lbl.TextSize=13; lbl.Font=Enum.Font.Gotham
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    local sw=Instance.new("TextButton"); sw.Name="ToggleSwitch"
    sw.Size=UDim2.new(0,44,0,24); sw.Position=UDim2.new(1,-54,0.5,-12)
    sw.BackgroundColor3=default and COLORS.SUCCESS or COLORS.BORDER
    sw.Text=""; sw.BorderSizePixel=0; sw.AutoButtonColor=false; sw.Parent=f; createCorner(sw,12)
    local ind=Instance.new("Frame"); ind.Name="Indicator"
    ind.Size=UDim2.new(0,18,0,18)
    ind.Position=default and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
    ind.BackgroundColor3=Color3.new(1,1,1); ind.BorderSizePixel=0; ind.Parent=sw; createCorner(ind,9)
    local isToggled=default or false
    local eid=makeElementId(tab,text,"Toggle")
    f:SetAttribute("ElementID",eid); f:SetAttribute("WidgetType","Toggle"); f:SetAttribute("ToggleState",isToggled and 1 or 0)
    local function setState(state, instant)
        isToggled = state and true or false
        if instant or isInitializing then
            sw.BackgroundColor3 = isToggled and COLORS.SUCCESS or COLORS.BORDER
            ind.Position = isToggled and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
        else
            createTween(sw,{BackgroundColor3=isToggled and COLORS.SUCCESS or COLORS.BORDER})
            createTween(ind,{Position=isToggled and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)})
        end
        f:SetAttribute("ToggleState", isToggled and 1 or 0)
    end
    sw.MouseButton1Click:Connect(function()
        setState(not isToggled)
        safeCall(callback,isToggled)
        saveConfig(nil,false)
    end)
    elementSetters[f]=function(v)
        setState(v)
        if callback then pcall(callback, v) end
    end
    if restorationQueue[eid] and restorationQueue[eid].Type=="Toggle" then
        local sv=restorationQueue[eid].Value
        dprint("CreateToggle["..eid.."]: restoring saved value "..tostring(sv))
        setState(sv)
        if callback then pcall(callback, sv) end; restorationQueue[eid]=nil
    else
        dprint("CreateToggle["..eid.."]: no saved value, using default "..tostring(default))
    end
    table.insert(tab.Elements,f)
    return {Frame=f, GetValue=function() return isToggled end, SetValue=function(v,instant)
        setState(v,instant)
        if not isInitializing then saveConfig(nil,false) end
    end}
end
function GuiLibrary:CreateSlider(tab, text, min, max, default, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateSlider: invalid tab"); return nil end
    text=tostring(text or "Slider")
    min=tonumber(min) or 0; max=tonumber(max) or (min+100)
    if max<=min then max=min+1 end
    default=math.clamp(tonumber(default) or min,min,max)
    local f=Instance.new("Frame"); f.Name=text.."Slider"
    f.Size=UDim2.new(1,0,0,54); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local lbl=Instance.new("TextLabel"); lbl.Name="SliderLabel"
    lbl.Size=UDim2.new(0.65,0,0,22); lbl.Position=UDim2.new(0,14,0,8)
    lbl.BackgroundTransparency=1; lbl.Text=text; lbl.TextColor3=COLORS.TEXT
    lbl.TextSize=13; lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    local val=Instance.new("TextLabel"); val.Name="SliderValue"
    val.Size=UDim2.new(0.35,-14,0,22); val.Position=UDim2.new(0.65,0,0,8)
    val.BackgroundTransparency=1; val.Text=tostring(default or min); val.TextColor3=COLORS.ACCENT
    val.TextSize=13; val.Font=Enum.Font.GothamBold; val.TextXAlignment=Enum.TextXAlignment.Right; val.Parent=f
    local track=Instance.new("Frame"); track.Name="SliderTrack"
    track.Size=UDim2.new(1,-28,0,6); track.Position=UDim2.new(0,14,1,-20)
    track.BackgroundColor3=COLORS.BORDER; track.BorderSizePixel=0; track.Parent=f; createCorner(track,3)
    local fill=Instance.new("Frame"); fill.Name="SliderFill"
    fill.Size=UDim2.new(0,0,1,0); fill.BackgroundColor3=COLORS.ACCENT
    fill.BorderSizePixel=0; fill.Parent=track; createCorner(fill,3)
    local handle=Instance.new("TextButton"); handle.Name="SliderHandle"
    handle.Size=UDim2.new(0,18,0,18); handle.Position=UDim2.new(0,-9,0.5,-9)
    handle.BackgroundColor3=Color3.new(1,1,1); handle.Text=""
    handle.BorderSizePixel=0; handle.AutoButtonColor=false; handle.ZIndex=2; handle.Parent=track
    createCorner(handle,9); createStroke(handle,1.5,COLORS.ACCENT)
    f:SetAttribute("ElementID",makeElementId(tab,text,"Slider"))
    f:SetAttribute("WidgetType","Slider"); f:SetAttribute("SliderMin",min); f:SetAttribute("SliderMax",max)
    local eid=f:GetAttribute("ElementID"); local cur=default or min
    local dragging=false; local curPct=0; local dragInput=nil; local sliderSaveToken=0
    local function updateSlider(v, shouldSave)
        if shouldSave==nil then shouldSave=false end
        cur=math.clamp(tonumber(v) or cur or min,min,max); curPct=(cur-min)/(max-min)
        fill.Size=UDim2.new(curPct,0,1,0); handle.Position=UDim2.new(curPct,-9,0.5,-9)
        val.Text=string.format("%.1f",cur); f:SetAttribute("SliderValue",cur)
        safeCall(callback,cur)
        if shouldSave and not isInitializing then saveConfig(nil,false) end
        if dragging and not shouldSave and not isInitializing then
            sliderSaveToken=sliderSaveToken+1
            local token=sliderSaveToken
            task.delay(0.25,function()
                if token==sliderSaveToken and f.Parent then saveConfig(nil,false) end
            end)
        end
    end
    handle.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragInput=inp
        end
    end)
    handle.MouseEnter:Connect(function()
        if not dragging then createTween(handle,{Size=UDim2.new(0,22,0,22),Position=UDim2.new(curPct,-11,0.5,-11)}) end
    end)
    handle.MouseLeave:Connect(function()
        if not dragging then createTween(handle,{Size=UDim2.new(0,18,0,18),Position=UDim2.new(curPct,-9,0.5,-9)}) end
    end)
    local endConn=UserInputService.InputEnded:Connect(function(inp)
        if dragging and (inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch) then
            dragging=false; dragInput=nil
            sliderSaveToken=sliderSaveToken+1
            createTween(handle,{Size=UDim2.new(0,18,0,18),Position=UDim2.new(curPct,-9,0.5,-9)})
            if not isInitializing then saveConfig(nil,false) end
        end
    end); table.insert(activeInputConnections,endConn)
    local chgConn=UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp==dragInput) then
            local pct=math.clamp((inp.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
            updateSlider(min+(max-min)*pct)
        end
    end); table.insert(activeInputConnections,chgConn)
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragInput=inp
            local pct=math.clamp((inp.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
            updateSlider(min+(max-min)*pct)
        end
    end)
    elementSetters[f]=updateSlider
    elementCallbacks[f]=callback
    if restorationQueue[eid] and restorationQueue[eid].Type=="Slider" then
        local sv=tonumber(restorationQueue[eid].Value)
        dprint("CreateSlider["..eid.."]: restoring saved value "..tostring(sv))
        updateSlider(sv~=nil and sv or cur,false); restorationQueue[eid]=nil
    else
        dprint("CreateSlider["..eid.."]: no saved value, using default "..tostring(cur))
        updateSlider(cur,false)
    end
    table.insert(tab.Elements,f)
    return {Frame=f, GetValue=function() return cur end, SetValue=function(v) updateSlider(v,false); if not isInitializing then saveConfig(nil,false) end end}
end
function GuiLibrary:CreateDropdown(tab, text, options, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateDropdown: invalid tab"); return nil end
    text=tostring(text or "Dropdown"); if type(options)~="table" then options={} end
    local mf = GuiLibrary.CurrentWindow and GuiLibrary.CurrentWindow.MainFrame
    local dropFrame=Instance.new("Frame"); dropFrame.Name=text.."Dropdown"
    dropFrame.Size=UDim2.new(1,0,0,40); dropFrame.BackgroundColor3=COLORS.HOVER
    dropFrame.BorderSizePixel=0; dropFrame.Parent=tab.Content
    createCorner(dropFrame,8); createStroke(dropFrame,1,COLORS.BORDER)
    local dropBtn=Instance.new("TextButton"); dropBtn.Name="DropdownButton"
    dropBtn.Size=UDim2.new(1,-16,0,28); dropBtn.Position=UDim2.new(0,8,0.5,-14)
    dropBtn.BackgroundColor3=COLORS.PRIMARY; dropBtn.Text=""
    dropBtn.BorderSizePixel=0; dropBtn.AutoButtonColor=false; dropBtn.ZIndex=2; dropBtn.Parent=dropFrame
    createCorner(dropBtn,6)
    local dropLbl=Instance.new("TextLabel"); dropLbl.Name="DropdownLabel"
    dropLbl.Size=UDim2.new(1,-30,1,0); dropLbl.Position=UDim2.new(0,10,0,0)
    dropLbl.BackgroundTransparency=1; dropLbl.Text=text..":  "..(options[1] or "None")
    dropLbl.TextColor3=COLORS.TEXT; dropLbl.TextSize=12; dropLbl.Font=Enum.Font.Gotham
    dropLbl.TextXAlignment=Enum.TextXAlignment.Left; dropLbl.ZIndex=3; dropLbl.Parent=dropBtn
    local dropArrow=Instance.new("TextLabel"); dropArrow.Name="DropdownArrow"
    dropArrow.Size=UDim2.new(0,20,1,0); dropArrow.Position=UDim2.new(1,-22,0,0)
    dropArrow.BackgroundTransparency=1; dropArrow.Text="v"; dropArrow.TextColor3=COLORS.TEXT_MUTED
    dropArrow.TextSize=11; dropArrow.Font=Enum.Font.GothamBold; dropArrow.ZIndex=3; dropArrow.Parent=dropBtn
    local dropList=Instance.new("ScrollingFrame"); dropList.Name="DropdownList_"..text
    dropList.Size=UDim2.new(0,0,0,0); dropList.BackgroundColor3=COLORS.PRIMARY
    dropList.Visible=false; dropList.ZIndex=600; dropList.ScrollBarThickness=4
    dropList.ScrollBarImageColor3=COLORS.ACCENT; dropList.BorderSizePixel=0
    dropList.Parent=mf or tab.Content; createCorner(dropList,8); createStroke(dropList,1,COLORS.BORDER)
    dropdownLists[dropFrame]=dropList
    local listLayout=Instance.new("UIListLayout"); listLayout.SortOrder=Enum.SortOrder.LayoutOrder; listLayout.Parent=dropList
    local listPad=Instance.new("UIPadding"); listPad.PaddingTop=UDim.new(0,4); listPad.PaddingBottom=UDim.new(0,4)
    listPad.PaddingLeft=UDim.new(0,4); listPad.PaddingRight=UDim.new(0,4); listPad.Parent=dropList
    local curOpts={table.unpack(options)}; local curSel=curOpts[1] or "None"; local isOpen=false
    local function getListRect()
        local btnAbs = dropBtn.AbsolutePosition
        local mfAbs  = mf and mf.AbsolutePosition or Vector2.new(0,0)
        local w      = dropBtn.AbsoluteSize.X
        local h      = math.min(#curOpts*28+8, 136)
        local relX   = btnAbs.X - mfAbs.X
        local relY   = btnAbs.Y - mfAbs.Y + dropBtn.AbsoluteSize.Y + 6
        return relX, relY, w, h
    end
    local function closeInstant()
        isOpen=false; dropArrow.Text="v"; dropList.Visible=false
        dropList.Size=UDim2.new(0,dropList.Size.X.Offset,0,0)
        dropArrow.Rotation=0
    end
    dropdownClosers[dropFrame]=closeInstant
    local function buildOptions(opts)
        for _,c in ipairs(dropList:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        dropList.CanvasSize=UDim2.new(0,0,0,#opts*28+8)
        for i,opt in ipairs(opts) do
            local ob=Instance.new("TextButton"); ob.Size=UDim2.new(1,0,0,28)
            ob.BackgroundColor3=COLORS.ACCENT; ob.BackgroundTransparency=1
            ob.Text=""; ob.BorderSizePixel=0; ob.LayoutOrder=i; ob.ZIndex=601; ob.Parent=dropList
            createCorner(ob,5)
            local ol=Instance.new("TextLabel"); ol.Size=UDim2.new(1,-12,1,0); ol.Position=UDim2.new(0,10,0,0)
            ol.BackgroundTransparency=1; ol.Text=opt; ol.TextColor3=COLORS.TEXT_MUTED; ol.TextSize=12
            ol.Font=Enum.Font.Gotham; ol.TextXAlignment=Enum.TextXAlignment.Left; ol.ZIndex=602; ol.Parent=ob
            ob.MouseButton1Click:Connect(function()
                curSel=opt; dropLbl.Text=text..":  "..opt; dropFrame:SetAttribute("DropdownValue",opt)
                closeInstant()
                safeCall(callback,opt); saveConfig(nil,false)
            end)
            ob.MouseEnter:Connect(function() createTween(ob,{BackgroundTransparency=0.82}); createTween(ol,{TextColor3=COLORS.TEXT}) end)
            ob.MouseLeave:Connect(function() createTween(ob,{BackgroundTransparency=1}); createTween(ol,{TextColor3=COLORS.TEXT_MUTED}) end)
        end
    end
    buildOptions(curOpts)
    dropBtn.MouseButton1Click:Connect(function()
        isOpen=not isOpen
        if isOpen then
            local rx,ry,w,h=getListRect()
            dropList.Position=UDim2.new(0,rx,0,ry)
            dropList.Size=UDim2.new(0,w,0,0)
            dropList.CanvasSize=UDim2.new(0,0,0,#curOpts*28+8)
            dropList.Visible=true
            createTween(dropArrow,{Rotation=180}); createTween(dropList,{Size=UDim2.new(0,w,0,h)})
        else
            createTween(dropArrow,{Rotation=0})
            createTween(dropList,{Size=UDim2.new(0,dropList.Size.X.Offset,0,0)})
            task.wait(ANIM_TIME); dropList.Visible=false; dropArrow.Rotation=0; isOpen=false
        end
    end)
    dropFrame.AncestryChanged:Connect(function()
        if not dropFrame:IsDescendantOf(game) then pcall(function() dropList:Destroy() end) end
    end)
    local function setVal(v)
        if not v then return end
        for _,opt in ipairs(curOpts) do
            if opt==v then curSel=opt; dropLbl.Text=text..":  "..tostring(opt); dropFrame:SetAttribute("DropdownValue",tostring(opt)); safeCall(callback,opt); return end
        end
    end
    local function updateOptions(newOpts, keep)
        if isOpen then closeInstant() end
        curOpts={table.unpack(newOpts)}; buildOptions(curOpts)
        local valid=false
        if keep then for _,o in ipairs(curOpts) do if o==curSel then valid=true;break end end end
        if valid then
            dropLbl.Text=text..":  "..curSel; dropFrame:SetAttribute("DropdownValue",curSel)
        else
            curSel=curOpts[1] or "None"; dropLbl.Text=text..":  "..curSel
            dropFrame:SetAttribute("DropdownValue",tostring(curSel)); safeCall(callback,curSel)
        end
        if not isInitializing then saveConfig(nil,false) end
    end
    dropFrame:SetAttribute("ElementID",makeElementId(tab,text,"Dropdown"))
    dropFrame:SetAttribute("WidgetType","Dropdown"); dropFrame:SetAttribute("DropdownValue",curSel)
    elementSetters[dropFrame]=function(v) setVal(v); if not isInitializing then saveConfig(nil,false) end end
    elementCallbacks[dropFrame]=callback
    dropFrame.AncestryChanged:Connect(function()
        if not dropFrame:IsDescendantOf(game) then
            dropdownLists[dropFrame]=nil
            dropdownClosers[dropFrame]=nil
        end
    end)
    local eid=dropFrame:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="Dropdown" then
        setVal(restorationQueue[eid].Value); restorationQueue[eid]=nil
    end
    table.insert(tab.Elements,dropFrame)
    return {Frame=dropFrame, GetValue=function() return curSel end, SetValue=function(v)
        setVal(v)
        if not isInitializing then saveConfig(nil,false) end
    end, UpdateOptions=updateOptions}
end
function GuiLibrary:CreateLabel(tab, text)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateLabel: invalid tab"); return nil end
    text=tostring(text or "")
    text = text or ""
    local lbl=Instance.new("TextLabel"); lbl.Name=text.."Label"
    lbl.Size=UDim2.new(1,0,0,13); lbl.BackgroundTransparency=1; lbl.Text=text
    lbl.TextColor3=COLORS.TEXT_MUTED; lbl.TextSize=12; lbl.Font=Enum.Font.Gotham
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextYAlignment=Enum.TextYAlignment.Center
    lbl.Parent=tab.Content
    local p=Instance.new("UIPadding"); p.PaddingLeft=UDim.new(0,14); p.Parent=lbl
    table.insert(tab.Elements,lbl)
    local api
    api = {
        Instance = lbl,
        Frame    = lbl,
        GetText  = function() return lbl.Text end,
        SetText  = function(newText)
            lbl.Text = tostring(newText or "")
            return api
        end,
        SetColor = function(c3)
            if typeof(c3)=="Color3" then lbl.TextColor3 = c3 end
            return api
        end,
        SetVisible = function(v)
            lbl.Visible = v and true or false
            return api
        end,
    }
    return api
end
function GuiLibrary:CreateSection(tab, title)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateSection: invalid tab"); return nil end
    title=tostring(title or "Section")
    title = title or ""
    local f=Instance.new("Frame"); f.Name=title.."Section"
    f.Size=UDim2.new(1,0,0,26); f.BackgroundTransparency=1; f.BorderSizePixel=0; f.Parent=tab.Content
    local bar=Instance.new("Frame"); bar.Name="AccentBar"
    bar.Size=UDim2.new(0,3,1,-10); bar.Position=UDim2.new(0,0,0,5)
    bar.BackgroundColor3=COLORS.ACCENT; bar.BorderSizePixel=0; bar.Parent=f; createCorner(bar,2)
    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-12,1,0)
    lbl.Position=UDim2.new(0,10,0,0); lbl.BackgroundTransparency=1; lbl.Text=string.upper(title)
    lbl.TextColor3=COLORS.ACCENT; lbl.TextSize=10; lbl.Font=Enum.Font.GothamBold
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    table.insert(tab.Elements,f)
    local api
    api = {
        Instance = f,
        Frame    = f,
        GetText  = function() return lbl.Text end,
        SetText  = function(newText)
            lbl.Text = string.upper(tostring(newText or ""))
            return api
        end,
        SetVisible = function(v)
            f.Visible = v and true or false
            return api
        end,
    }
    return api
end
function GuiLibrary:CreateInput(tab, placeholder, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateInput: invalid tab"); return nil end
    placeholder=tostring(placeholder or "")
    local f=Instance.new("Frame"); f.Name=placeholder.."Input"
    f.Size=UDim2.new(1,0,0,40); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local box=Instance.new("TextBox"); box.Size=UDim2.new(1,-20,1,-12); box.Position=UDim2.new(0,10,0,6)
    box.BackgroundColor3=COLORS.PRIMARY; box.PlaceholderText=placeholder; box.PlaceholderColor3=COLORS.TEXT_MUTED
    box.Text=""; box.TextColor3=COLORS.TEXT; box.TextSize=12; box.Font=Enum.Font.Gotham
    box.BorderSizePixel=0; box.ClearTextOnFocus=false; box.Parent=f; createCorner(box,6)
    local bp=Instance.new("UIPadding"); bp.PaddingLeft=UDim.new(0,8); bp.Parent=box
    box.FocusLost:Connect(function(enter)
        f:SetAttribute("InputValue",box.Text)
        if enter then safeCall(callback,box.Text) end; saveConfig(nil,false)
    end)
    box.Focused:Connect(function() createStroke(box,1.5,COLORS.ACCENT) end)
    box.FocusLost:Connect(function() local s=box:FindFirstChildWhichIsA("UIStroke"); if s then s:Destroy() end end)
    f:SetAttribute("ElementID",makeElementId(tab,placeholder,"Input"))
    f:SetAttribute("WidgetType","Input"); f:SetAttribute("InputValue","")
    local function setInput(v)
        if type(v)=="string" then box.Text=v; f:SetAttribute("InputValue",v)
            safeCall(callback,v); if not isInitializing then saveConfig(nil,false) end end
    end
    elementSetters[f]=setInput
    elementCallbacks[f]=callback
    local eid=f:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="Input" then setInput(restorationQueue[eid].Value); restorationQueue[eid]=nil end
    table.insert(tab.Elements,f)
    return {Frame=f, TextBox=box, GetValue=function() return box.Text end}
end
function GuiLibrary:CreateColorPicker(tab, text, defaultColor, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateColorPicker: invalid tab"); return nil end
    local baseH=50
    local cf=Instance.new("Frame"); cf.Name=text.."ColorPicker"
    cf.Size=UDim2.new(1,0,0,baseH); cf.BackgroundColor3=COLORS.HOVER
    cf.BorderSizePixel=0; cf.ClipsDescendants=false; cf.Parent=tab.Content
    createCorner(cf,8); createStroke(cf,1,COLORS.BORDER)
    local swatch=Instance.new("TextButton"); swatch.Size=UDim2.new(0,34,0,34)
    swatch.Position=UDim2.new(0,8,0,8); swatch.BackgroundColor3=defaultColor or Color3.new(1,1,1)
    swatch.Text=""; swatch.BorderSizePixel=0; swatch.AutoButtonColor=false
    swatch.ZIndex=210; swatch.Parent=cf
    createCorner(swatch,8); createStroke(swatch,1.5,COLORS.BORDER)
    local clbl=Instance.new("TextLabel"); clbl.Size=UDim2.new(0.5,0,0,20)
    clbl.Position=UDim2.new(0,52,0,7); clbl.BackgroundTransparency=1; clbl.Text=text
    clbl.TextColor3=COLORS.TEXT; clbl.TextSize=13; clbl.Font=Enum.Font.Gotham
    clbl.TextXAlignment=Enum.TextXAlignment.Left; clbl.Parent=cf
    local function mkBox(lx, defVal)
        local box=Instance.new("TextBox"); box.Size=UDim2.new(0,38,0,18)
        box.Position=UDim2.new(0,lx,0,28); box.BackgroundColor3=COLORS.PRIMARY
        box.Text=tostring(defVal); box.PlaceholderText="0-255"; box.PlaceholderColor3=COLORS.TEXT_MUTED
        box.TextColor3=COLORS.TEXT; box.TextSize=11; box.Font=Enum.Font.GothamBold
        box.TextXAlignment=Enum.TextXAlignment.Center; box.BorderSizePixel=0; box.Parent=cf; createCorner(box,4)
        return box
    end
    local dc=defaultColor or Color3.new(1,1,1)
    local rBox=mkBox(52, math.floor(dc.R*255))
    local gBox=mkBox(95, math.floor(dc.G*255))
    local bBox=mkBox(138,math.floor(dc.B*255))
    for i,pair in ipairs({{"R",52},{"G",95},{"B",138}}) do
        local lb=Instance.new("TextLabel"); lb.Size=UDim2.new(0,10,0,18); lb.Position=UDim2.new(0,pair[2]-12,0,28)
        lb.BackgroundTransparency=1; lb.Text=pair[1]; lb.TextColor3=COLORS.TEXT_MUTED
        lb.TextSize=9; lb.Font=Enum.Font.GothamBold; lb.Parent=cf
    end
    local curColor=dc; local hue,sat,val=Color3.toHSV(dc)
    local transparency=0
    local popOpen=false; local dragSV,dragHue,dragTran=false,false,false
    local popup=Instance.new("Frame"); popup.Name="ColorPickerPopup"
    popup.Size=UDim2.new(0,318,0,236); popup.Position=UDim2.new(0,0,0,baseH+4)
    popup.BackgroundColor3=COLORS.PRIMARY; popup.Visible=false; popup.ClipsDescendants=false
    popup.ZIndex=200; popup.Parent=cf; createCorner(popup,10); createStroke(popup,1,COLORS.BORDER)
    local svF=Instance.new("Frame"); svF.Name="SVFrame"; svF.Size=UDim2.new(0,184,0,184)
    svF.Position=UDim2.new(0,10,0,10); svF.BackgroundColor3=Color3.fromHSV(hue,1,1)
    svF.BorderSizePixel=0; svF.ZIndex=201; svF.Parent=popup; createCorner(svF,6)
    local svW=Instance.new("Frame"); svW.Size=UDim2.new(1,0,1,0); svW.BackgroundColor3=Color3.new(1,1,1)
    svW.BorderSizePixel=0; svW.ZIndex=202; svW.Parent=svF
    local sg=Instance.new("UIGradient"); sg.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}); sg.Parent=svW
    local svB=Instance.new("Frame"); svB.Size=UDim2.new(1,0,1,0); svB.BackgroundColor3=Color3.new(0,0,0)
    svB.BorderSizePixel=0; svB.ZIndex=203; svB.Parent=svF
    local vg=Instance.new("UIGradient"); vg.Rotation=90
    vg.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.new(0,0,0)),ColorSequenceKeypoint.new(1,Color3.new(0,0,0))})
    vg.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}); vg.Parent=svB
    local svMark=Instance.new("Frame"); svMark.Size=UDim2.new(0,12,0,12)
    svMark.AnchorPoint=Vector2.new(0.5,0.5); svMark.BackgroundColor3=Color3.new(1,1,1)
    svMark.BorderSizePixel=0; svMark.ZIndex=204; svMark.Parent=svF; createCorner(svMark,6)
    createStroke(svMark,1.5,Color3.new(0,0,0))
    local hueF=Instance.new("Frame"); hueF.Name="HueFrame"; hueF.Size=UDim2.new(0,18,0,184)
    hueF.Position=UDim2.new(0,202,0,10); hueF.BorderSizePixel=0; hueF.ZIndex=201; hueF.Parent=popup; createCorner(hueF,6)
    local hg=Instance.new("UIGradient"); hg.Rotation=90
    hg.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(255,0,0)),
        ColorSequenceKeypoint.new(0.17,Color3.fromRGB(255,255,0)),
        ColorSequenceKeypoint.new(0.33,Color3.fromRGB(0,255,0)),
        ColorSequenceKeypoint.new(0.50,Color3.fromRGB(0,255,255)),
        ColorSequenceKeypoint.new(0.67,Color3.fromRGB(0,0,255)),
        ColorSequenceKeypoint.new(0.83,Color3.fromRGB(255,0,255)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(255,0,0)),
    }); hg.Parent=hueF
    local hueMark=Instance.new("Frame"); hueMark.Size=UDim2.new(1,4,0,4)
    hueMark.Position=UDim2.new(0,-2,hue,-2); hueMark.AnchorPoint=Vector2.new(0,0.5)
    hueMark.BackgroundColor3=Color3.new(1,1,1); hueMark.BorderSizePixel=0; hueMark.ZIndex=202; hueMark.Parent=hueF; createCorner(hueMark,2)
    local tranF=Instance.new("Frame"); tranF.Name="TranFrame"; tranF.Size=UDim2.new(0,18,0,184)
    tranF.Position=UDim2.new(0,236,0,10); tranF.BackgroundColor3=Color3.fromRGB(180,180,180)
    tranF.BorderSizePixel=0; tranF.ZIndex=201; tranF.Parent=popup; createCorner(tranF,6)
    local tranC=Instance.new("Frame"); tranC.Name="TranColor"; tranC.Size=UDim2.new(1,0,1,0)
    tranC.BackgroundColor3=curColor; tranC.BorderSizePixel=0; tranC.ZIndex=202; tranC.Parent=tranF
    createCorner(tranC,6)
    local tg=Instance.new("UIGradient"); tg.Rotation=90
    tg.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)})
    tg.Parent=tranC
    local tranMark=Instance.new("Frame"); tranMark.Size=UDim2.new(1,4,0,4)
    tranMark.Position=UDim2.new(0,-2,0,-2); tranMark.AnchorPoint=Vector2.new(0,0.5)
    tranMark.BackgroundColor3=Color3.new(1,1,1); tranMark.BorderSizePixel=0; tranMark.ZIndex=203; tranMark.Parent=tranF; createCorner(tranMark,2)
    local infoBar=Instance.new("Frame"); infoBar.Size=UDim2.new(1,-20,0,20); infoBar.Position=UDim2.new(0,10,1,-24)
    infoBar.BackgroundColor3=COLORS.HOVER; infoBar.BorderSizePixel=0; infoBar.ZIndex=205; infoBar.Parent=popup
    createCorner(infoBar,5)
    local hexLbl=Instance.new("TextLabel"); hexLbl.Size=UDim2.new(0.55,0,1,0); hexLbl.Position=UDim2.new(0,8,0,0)
    hexLbl.BackgroundTransparency=1; hexLbl.Text="#FFFFFF"; hexLbl.TextColor3=COLORS.TEXT
    hexLbl.TextSize=11; hexLbl.Font=Enum.Font.Code
    hexLbl.TextXAlignment=Enum.TextXAlignment.Left; hexLbl.ZIndex=206; hexLbl.Parent=infoBar
    local alphaLbl=Instance.new("TextLabel"); alphaLbl.Size=UDim2.new(0.45,-8,1,0); alphaLbl.Position=UDim2.new(0.55,0,0,0)
    alphaLbl.BackgroundTransparency=1; alphaLbl.Text="α 100%"; alphaLbl.TextColor3=COLORS.TEXT_MUTED
    alphaLbl.TextSize=11; alphaLbl.Font=Enum.Font.Code
    alphaLbl.TextXAlignment=Enum.TextXAlignment.Right; alphaLbl.ZIndex=206; alphaLbl.Parent=infoBar
    local function updateMarkers()
        svMark.Position=UDim2.new(0,sat*svF.AbsoluteSize.X,0,(1-val)*svF.AbsoluteSize.Y)
        hueMark.Position=UDim2.new(0,-2,hue,-2)
        tranMark.Position=UDim2.new(0,-2,transparency,-2)
    end
    local function setHSV(h,s,v,t)
        hue=math.clamp(h or hue,0,1); sat=math.clamp(s or sat,0,1); val=math.clamp(v or val,0,1)
        transparency=math.clamp(t or transparency,0,1)
        curColor=Color3.fromHSV(hue,sat,val)
        rBox.Text=tostring(math.floor(curColor.R*255))
        gBox.Text=tostring(math.floor(curColor.G*255))
        bBox.Text=tostring(math.floor(curColor.B*255))
        swatch.BackgroundColor3=curColor; swatch.BackgroundTransparency=transparency
        cf:SetAttribute("ColorValue",curColor); cf:SetAttribute("TransparencyValue",transparency)
        svF.BackgroundColor3=Color3.fromHSV(hue,1,1); tranC.BackgroundColor3=curColor
        hexLbl.Text=string.format("#%02X%02X%02X",
            math.floor(curColor.R*255+0.5), math.floor(curColor.G*255+0.5), math.floor(curColor.B*255+0.5))
        alphaLbl.Text=string.format("α %d%%", math.floor((1-transparency)*100+0.5))
        updateMarkers()
        safeCall(callback,curColor,transparency)
        if not isInitializing then saveConfig(nil,false) end
    end
    local function setColor(inp, t)
        local c=nil
        if typeof(inp)=="Color3" then c=inp
        elseif type(inp)=="table" and inp.R then
            c=Color3.new(inp.R,inp.G,inp.B)
            if t==nil and inp.T then t=inp.T end
        end
        if c then curColor=c; hue,sat,val=Color3.toHSV(c); setHSV(hue,sat,val,t); return true end
        return false
    end
    local function setTransparency(t) setHSV(hue,sat,val,t) end
    local function sp(inp)
        local p=(inp and inp.Position) and inp.Position or UserInputService:GetMouseLocation()
        return typeof(p)=="Vector3" and Vector2.new(p.X,p.Y) or (typeof(p)=="Vector2" and p or UserInputService:GetMouseLocation())
    end
    local function isPress(i) return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch end
    local function isMove(i) return i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch end
    svF.InputBegan:Connect(function(i) if isPress(i) then dragSV=true;local c=sp(i);local x=math.clamp((c.X-svF.AbsolutePosition.X)/svF.AbsoluteSize.X,0,1);local y=math.clamp((c.Y-svF.AbsolutePosition.Y)/svF.AbsoluteSize.Y,0,1);setHSV(hue,x,1-y) end end)
    svF.InputChanged:Connect(function(i) if dragSV and isMove(i) then local c=sp(i);local x=math.clamp((c.X-svF.AbsolutePosition.X)/svF.AbsoluteSize.X,0,1);local y=math.clamp((c.Y-svF.AbsolutePosition.Y)/svF.AbsoluteSize.Y,0,1);setHSV(hue,x,1-y) end end)
    svF.InputEnded:Connect(function(i) if isPress(i) then dragSV=false end end)
    hueF.InputBegan:Connect(function(i) if isPress(i) then dragHue=true;local c=sp(i);setHSV(math.clamp((c.Y-hueF.AbsolutePosition.Y)/hueF.AbsoluteSize.Y,0,1),sat,val) end end)
    hueF.InputChanged:Connect(function(i) if dragHue and isMove(i) then local c=sp(i);setHSV(math.clamp((c.Y-hueF.AbsolutePosition.Y)/hueF.AbsoluteSize.Y,0,1),sat,val) end end)
    hueF.InputEnded:Connect(function(i) if isPress(i) then dragHue=false end end)
    tranF.InputBegan:Connect(function(i) if isPress(i) then dragTran=true;local c=sp(i);setHSV(hue,sat,val,math.clamp((c.Y-tranF.AbsolutePosition.Y)/tranF.AbsoluteSize.Y,0,1)) end end)
    tranF.InputChanged:Connect(function(i) if dragTran and isMove(i) then local c=sp(i);setHSV(hue,sat,val,math.clamp((c.Y-tranF.AbsolutePosition.Y)/tranF.AbsoluteSize.Y,0,1)) end end)
    tranF.InputEnded:Connect(function(i) if isPress(i) then dragTran=false end end)
    local function onRGB()
        local r=math.clamp(tonumber(rBox.Text) or 0,0,255)
        local g=math.clamp(tonumber(gBox.Text) or 0,0,255)
        local b=math.clamp(tonumber(bBox.Text) or 0,0,255)
        setColor(Color3.new(r/255,g/255,b/255))
    end
    rBox.FocusLost:Connect(onRGB); gBox.FocusLost:Connect(onRGB); bBox.FocusLost:Connect(onRGB)
    local function setPopOpen(state)
        popOpen=state
        if popOpen then
            popup.Visible=true
            createTween(cf,{Size=UDim2.new(1,0,0,baseH+4+popup.Size.Y.Offset)})
        else
            createTween(cf,{Size=UDim2.new(1,0,0,baseH)})
            task.delay(ANIM_TIME, function() if not popOpen then popup.Visible=false end end)
        end
    end
    swatch.MouseButton1Click:Connect(function() setPopOpen(not popOpen) end)
    local closePop=Instance.new("TextButton"); closePop.Size=UDim2.new(0,22,0,22)
    closePop.Position=UDim2.new(1,-28,0,6); closePop.BackgroundColor3=COLORS.DANGER
    closePop.BackgroundTransparency=0.4; closePop.Text="X"; closePop.TextColor3=Color3.new(1,1,1)
    closePop.TextSize=12; closePop.Font=Enum.Font.GothamBold; closePop.BorderSizePixel=0
    closePop.AutoButtonColor=false; closePop.ZIndex=215; closePop.Parent=popup; createCorner(closePop,6)
    closePop.MouseButton1Click:Connect(function() setPopOpen(false) end)
    closePop.MouseEnter:Connect(function() createTween(closePop,{BackgroundTransparency=0}) end)
    closePop.MouseLeave:Connect(function() createTween(closePop,{BackgroundTransparency=0.4}) end)
    cf:SetAttribute("ElementID",makeElementId(tab,text,"ColorPicker"))
    cf:SetAttribute("WidgetType","ColorPicker"); cf:SetAttribute("ColorValue",curColor)
    cf:SetAttribute("TransparencyValue",transparency)
    elementSetters[cf]=setColor
    elementCallbacks[cf]=callback
    local eid=cf:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="ColorPicker" then
        if setColor(restorationQueue[eid].Value) then restorationQueue[eid]=nil end
    end
    table.insert(tab.Elements,cf)
    return {
        Frame=cf,
        GetValue=function() return curColor end,
        GetTransparency=function() return transparency end,
        SetColor=setColor,
        SetTransparency=setTransparency,
    }
end
-- Mouse button support (MB1-MB5). Roblox's UserInputType only *defines*
-- MouseButton1-3, so we parse/build names dynamically instead of using a fixed
-- table. That way any mouse button an executor actually delivers through
-- InputBegan (e.g. the side buttons 4/5) is captured, named, and restorable.
local function mouseName(uit)
    local n = tostring(uit):match("MouseButton(%d+)")
    return n and ("MB"..n) or nil
end
local function isMouseButton(uit)
    return typeof(uit)=="EnumItem" and uit.EnumType==Enum.UserInputType and mouseName(uit)~=nil
end
-- The left mouse button is never bindable: binding it makes every click fire
-- the keybind, and you can no longer click anything (including "unbind") — it
-- locks you out of the whole GUI.
local function isBindableMouse(uit)
    return isMouseButton(uit) and uit~=Enum.UserInputType.MouseButton1
end
local function bindIsBanned(b)
    return b~=nil and b.type=="mouse" and b.value==Enum.UserInputType.MouseButton1
end
-- Map a typed character back to a KeyCode. On the Real executor the keyboard is
-- delivered as TextInput into a focused TextBox (not as Keyboard/InputBegan), so
-- when capturing a keybind we read the character the box received and turn it
-- into a bindable key — letting keys register without tabbing out of the GUI.
local DIGIT_KC = {["0"]="Zero",["1"]="One",["2"]="Two",["3"]="Three",["4"]="Four",
                  ["5"]="Five",["6"]="Six",["7"]="Seven",["8"]="Eight",["9"]="Nine"}
local function charToKeyCode(ch)
    if type(ch)~="string" or ch=="" then return nil end
    if ch==" " then return Enum.KeyCode.Space end
    local up=ch:upper()
    local name
    if up:match("^%a$") then name=up
    elseif DIGIT_KC[ch] then name=DIGIT_KC[ch] end
    if not name then return nil end
    local ok, kc = pcall(function() return Enum.KeyCode[name] end)
    if ok and kc then return kc end
    return nil
end
local function bindToString(b)
    if not b then return "None" end
    if b.type=="key"  then return b.value.Name end
    if b.type=="side" then return b.name end          -- MB4 / MB5 (OS-polled)
    if b.type=="mouse" then return mouseName(b.value) or "None" end
    return "None"
end
local function stringToBind(s)
    if not s or s=="" or s=="None" then return nil end
    if SideButtons.NAMES[s] then return {type="side", name=s} end   -- MB4 / MB5
    local mb = s:match("^MB(%d+)$")
    if mb then
        local ok, uit = pcall(function() return Enum.UserInputType["MouseButton"..mb] end)
        if ok and uit then return {type="mouse",value=uit} end
        return nil
    end
    local ok, kc = pcall(function() return Enum.KeyCode[s] end)
    if ok and kc then return {type="key",value=kc} end
    return nil
end
local function matchesBind(b, inp)
    if not b then return false end
    if b.type=="key"   then return inp.UserInputType==Enum.UserInputType.Keyboard and inp.KeyCode==b.value end
    if b.type=="mouse" then return inp.UserInputType==b.value end
    return false
end
function GuiLibrary:CreateKeybind(tab, text, defaultKey, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateKeybind: invalid tab"); return nil end
    text=tostring(text or "Keybind")
    local f=Instance.new("Frame"); f.Name=text.."Keybind"
    f.Size=UDim2.new(1,0,0,40); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-90,1,0); lbl.Position=UDim2.new(0,14,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=text; lbl.TextColor3=COLORS.TEXT
    lbl.TextSize=13; lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    local curBind
    if typeof(defaultKey)=="EnumItem" then
        if defaultKey.EnumType==Enum.KeyCode then curBind={type="key",value=defaultKey}
        elseif isMouseButton(defaultKey) then
            curBind={type="mouse",value=defaultKey} end
    end
    local kbBtn=Instance.new("TextButton"); kbBtn.Name="KeybindButton"
    kbBtn.Size=UDim2.new(0,72,0,26); kbBtn.Position=UDim2.new(1,-80,0.5,-13)
    kbBtn.BackgroundColor3=COLORS.PRIMARY; kbBtn.Text=bindToString(curBind)
    kbBtn.TextColor3=COLORS.TEXT; kbBtn.TextSize=11; kbBtn.Font=Enum.Font.GothamBold
    kbBtn.BorderSizePixel=0; kbBtn.AutoButtonColor=false; kbBtn.Parent=f
    createCorner(kbBtn,6); createStroke(kbBtn,1,COLORS.BORDER)
    local listening=false; local lastTrig=0
    local function commit()
        kbBtn.Text=bindToString(curBind)
        f:SetAttribute("KeybindValue",bindToString(curBind))
    end
    local function setKeybind(v)
        if v==nil or v==false or v=="None" or v=="" then curBind=nil; commit(); return true end
        local b
        if typeof(v)=="EnumItem" then
            if v.EnumType==Enum.KeyCode then b={type="key",value=v}
            elseif isMouseButton(v) then b={type="mouse",value=v} end
        elseif type(v)=="string" then
            b=stringToBind(v)
        end
        if bindIsBanned(b) then curBind=nil; commit(); return true end  -- drop stuck MB1 binds
        if b then curBind=b; commit(); return true end
        return false
    end
    commit()
    kbBtn.MouseButton1Click:Connect(function()
        if listening then return end; listening=true; kbBtn.Text="..."
        createTween(kbBtn,{BackgroundColor3=COLORS.WARNING})
        -- NOTE: we deliberately do NOT ignore gameProcessedEvent (gp) here.
        -- While listening we want to grab the key even when the pointer is over
        -- the GUI, so you no longer have to tab out for it to register.
        local uisConn, sideConn, textConn, focusConn, box, done
        local function finish(newBind)
            if done then return end; done=true
            curBind=newBind; commit()
            listening=false; createTween(kbBtn,{BackgroundColor3=COLORS.PRIMARY})
            if uisConn then uisConn:Disconnect() end
            if sideConn then sideConn:Disconnect() end
            if textConn then textConn:Disconnect() end
            if focusConn then focusConn:Disconnect() end
            if box then box:Destroy() end
            saveConfig(nil,false)
        end
        -- On Real, letters/numbers arrive as TextInput (into a focused TextBox),
        -- while numpad / F-keys / mouse arrive through InputBegan — so we listen
        -- on BOTH. A hidden box grabs the typed character (mapped back to a
        -- KeyCode); InputBegan handles the rest. (Modifier keys — Shift/Ctrl/Alt
        -- — send no readable input on Real and cannot be bound.)
        box=Instance.new("TextBox")
        box.Size=UDim2.new(0,1,0,1); box.BackgroundTransparency=1; box.TextTransparency=1
        box.Text=""; box.ClearTextOnFocus=false; box.MultiLine=false; box.Parent=f
        textConn=box:GetPropertyChangedSignal("Text"):Connect(function()
            local t=box.Text; if t=="" then return end
            local kc=charToKeyCode(t:sub(-1)); box.Text=""
            if kc then finish({type="key",value=kc}) end
        end)
        focusConn=box.FocusLost:Connect(function(_, inp)
            if inp and inp.KeyCode==Enum.KeyCode.Escape then finish(nil) end
        end)
        uisConn=UserInputService.InputBegan:Connect(function(inp,gp)
            if inp.UserInputType==Enum.UserInputType.Keyboard then
                local kc=inp.KeyCode
                if kc==Enum.KeyCode.Backspace or kc==Enum.KeyCode.Delete or kc==Enum.KeyCode.Escape then finish(nil)
                elseif kc~=Enum.KeyCode.Unknown then finish({type="key",value=kc}) end
            elseif isBindableMouse(inp.UserInputType) then  -- MB1 never bindable (locks you out)
                finish({type="mouse",value=inp.UserInputType})
            end
        end)
        sideConn=SideButtons.onBegan(function(name) finish({type="side",name=name}) end)
        task.defer(function() if not done and box then pcall(function() box:CaptureFocus() end) end end)
        task.delay(10, function() finish(curBind) end)  -- auto-cancel if nothing pressed
    end)
    -- Right-click the keybind button to clear it — a reliable unbind that never
    -- depends on the bound input, so you can always recover from a bad bind.
    kbBtn.MouseButton2Click:Connect(function()
        if listening then return end
        setKeybind(nil); if not isInitializing then saveConfig(nil,false) end
    end)
    -- Keyboard binds fire even when gameProcessedEvent is true (on Real the GUI
    -- being focused sets gp=true for keyboard, which used to swallow every key),
    -- skipping only while a text box is focused. Mouse binds still respect gp so
    -- a click on the GUI itself never fires the bind.
    local kbConn=UserInputService.InputBegan:Connect(function(inp,gp)
        if listening then return end
        if UserInputService:GetFocusedTextBox() then return end
        if curBind and curBind.type=="mouse" and gp then return end
        if tick()-lastTrig<0.2 then return end
        if matchesBind(curBind, inp) then lastTrig=tick(); safeCall(callback) end
    end); table.insert(activeInputConnections,kbConn)
    local sideTrig=SideButtons.onBegan(function(name)
        if listening then return end
        if not (curBind and curBind.type=="side" and curBind.name==name) then return end
        if tick()-lastTrig<0.2 then return end
        lastTrig=tick(); safeCall(callback)
    end); table.insert(activeInputConnections,sideTrig)
    f:SetAttribute("ElementID",makeElementId(tab,text,"Keybind"))
    f:SetAttribute("WidgetType","Keybind"); f:SetAttribute("KeybindValue",bindToString(curBind))
    elementSetters[f]=function(v) if setKeybind(v) and not isInitializing then saveConfig(nil,false) end end
    local eid=f:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="Keybind" then
        if setKeybind(restorationQueue[eid].Value) then restorationQueue[eid]=nil end
    end
    table.insert(tab.Elements,f)
    return {
        Frame=f,
        GetKey=function() return curBind and curBind.type=="key" and curBind.value or nil end,
        GetBind=function() return curBind and {type=curBind.type, value=curBind.value, name=curBind.name} or nil end,
        IsDown=function()
            if not curBind then return false end
            if curBind.type=="side" then return SideButtons.isDown(curBind.name) end
            if curBind.type=="key"  then return UserInputService:IsKeyDown(curBind.value) end
            if curBind.type=="mouse" then return UserInputService:IsMouseButtonPressed(curBind.value) end
            return false
        end,
        SetKey=function(v)
            local ok=setKeybind(v)
            if ok and not isInitializing then saveConfig(nil,false) end
            return ok
        end,
    }
end
function GuiLibrary:CreateTextbox(tab, label, default, onChange, opts)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateTextbox: invalid tab"); return nil end
    opts = opts or {}
    local f=Instance.new("Frame"); f.Name=label.."Textbox"
    f.Size=UDim2.new(1,0,0,52); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content
    createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-20,0,16); lbl.Position=UDim2.new(0,10,0,5)
    lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=COLORS.TEXT_MUTED
    lbl.TextSize=11; lbl.Font=Enum.Font.GothamBold
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    local box=Instance.new("TextBox"); box.Name="TextboxField"
    box.Size=UDim2.new(1,-20,0,22); box.Position=UDim2.new(0,10,1,-26)
    box.BackgroundColor3=COLORS.PRIMARY; box.Text=tostring(default or "")
    box.PlaceholderText=opts.placeholder or ""; box.PlaceholderColor3=COLORS.TEXT_MUTED
    box.TextColor3=COLORS.TEXT; box.TextSize=12; box.Font=Enum.Font.Gotham
    box.TextXAlignment=Enum.TextXAlignment.Left; box.BorderSizePixel=0
    box.ClearTextOnFocus=false; box.Parent=f; createCorner(box,5)
    if opts.password then box.Text=string.rep("*", #box.Text) end
    local bp=Instance.new("UIPadding"); bp.PaddingLeft=UDim.new(0,6); bp.PaddingRight=UDim.new(0,6); bp.Parent=box
    local lastValid = box.Text
    local function tryApply(text, fromKeystroke)
        local accept = true
        if opts.validate then
            local ok, result=safeCall(opts.validate,text)
            accept=ok and result~=false
        end
        if accept and onChange then
            local ok, result=safeCall(onChange,text)
            if not ok or result==false then accept = false end
        end
        if accept then
            lastValid = text
            f:SetAttribute("TextboxValue", text)
            if not isInitializing and not fromKeystroke then saveConfig(nil,false) end
        else
            if not fromKeystroke then box.Text = lastValid end
        end
    end
    if opts.live then
        box:GetPropertyChangedSignal("Text"):Connect(function() tryApply(box.Text, true) end)
    end
    box.FocusLost:Connect(function() tryApply(box.Text, false) end)
    f:SetAttribute("ElementID",makeElementId(tab,label,"Textbox"))
    f:SetAttribute("WidgetType","Textbox"); f:SetAttribute("TextboxValue", box.Text)
    elementSetters[f]=function(v) if type(v)=="string" then box.Text=v; tryApply(v, false) end end
    local eid=f:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="Textbox" then
        box.Text=tostring(restorationQueue[eid].Value or ""); lastValid=box.Text
        f:SetAttribute("TextboxValue", box.Text); restorationQueue[eid]=nil
    end
    table.insert(tab.Elements,f)
    return {
        Frame=f, Instance=f, TextBox=box,
        GetValue=function() return box.Text end,
        SetValue=function(v) if type(v)=="string" then box.Text=v; tryApply(v, false) end end,
    }
end
function GuiLibrary:CreateMultiSelect(tab, text, options, defaults, callback)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateMultiSelect: invalid tab"); return nil end
    local mf = GuiLibrary.CurrentWindow and GuiLibrary.CurrentWindow.MainFrame
    local dropFrame=Instance.new("Frame"); dropFrame.Name=text.."MultiSelect"
    dropFrame.Size=UDim2.new(1,0,0,40); dropFrame.BackgroundColor3=COLORS.HOVER
    dropFrame.BorderSizePixel=0; dropFrame.Parent=tab.Content
    createCorner(dropFrame,8); createStroke(dropFrame,1,COLORS.BORDER)
    local dropBtn=Instance.new("TextButton"); dropBtn.Name="DropdownButton"
    dropBtn.Size=UDim2.new(1,-16,0,28); dropBtn.Position=UDim2.new(0,8,0.5,-14)
    dropBtn.BackgroundColor3=COLORS.PRIMARY; dropBtn.Text=""
    dropBtn.BorderSizePixel=0; dropBtn.AutoButtonColor=false; dropBtn.ZIndex=2; dropBtn.Parent=dropFrame
    createCorner(dropBtn,6)
    local dropLbl=Instance.new("TextLabel"); dropLbl.Size=UDim2.new(1,-30,1,0); dropLbl.Position=UDim2.new(0,10,0,0)
    dropLbl.BackgroundTransparency=1; dropLbl.TextColor3=COLORS.TEXT; dropLbl.TextSize=12; dropLbl.Font=Enum.Font.Gotham
    dropLbl.TextXAlignment=Enum.TextXAlignment.Left; dropLbl.ZIndex=3; dropLbl.Parent=dropBtn
    local dropArrow=Instance.new("TextLabel"); dropArrow.Size=UDim2.new(0,20,1,0); dropArrow.Position=UDim2.new(1,-22,0,0)
    dropArrow.BackgroundTransparency=1; dropArrow.Text="v"; dropArrow.TextColor3=COLORS.TEXT_MUTED
    dropArrow.TextSize=11; dropArrow.Font=Enum.Font.GothamBold; dropArrow.ZIndex=3; dropArrow.Parent=dropBtn
    local dropList=Instance.new("ScrollingFrame"); dropList.Name="MultiSelectList_"..text
    dropList.Size=UDim2.new(0,0,0,0); dropList.BackgroundColor3=COLORS.PRIMARY
    dropList.Visible=false; dropList.ZIndex=600; dropList.ScrollBarThickness=4
    dropList.ScrollBarImageColor3=COLORS.ACCENT; dropList.BorderSizePixel=0
    dropList.Parent=mf or tab.Content; createCorner(dropList,8); createStroke(dropList,1,COLORS.BORDER)
    dropdownLists[dropFrame]=dropList
    local lp=Instance.new("UIListLayout"); lp.SortOrder=Enum.SortOrder.LayoutOrder; lp.Parent=dropList
    local ldp=Instance.new("UIPadding"); ldp.PaddingTop=UDim.new(0,4); ldp.PaddingBottom=UDim.new(0,4)
    ldp.PaddingLeft=UDim.new(0,4); ldp.PaddingRight=UDim.new(0,4); ldp.Parent=dropList
    local curOpts={table.unpack(options)}
    local selected={}; for _,o in ipairs(defaults or {}) do selected[o]=true end
    local isOpen=false
    local function summary()
        local n=0; for _,v in pairs(selected) do if v then n=n+1 end end
        if n==0 then return text..":  none"
        elseif n<=3 then
            local parts={}; for _,o in ipairs(curOpts) do if selected[o] then table.insert(parts,o) end end
            return text..":  "..table.concat(parts,", ")
        else return text..":  "..n.." selected" end
    end
    local function refreshLabel() dropLbl.Text=summary() end
    local function getListRect()
        local btnAbs=dropBtn.AbsolutePosition; local mfAbs=mf and mf.AbsolutePosition or Vector2.new(0,0)
        local w=dropBtn.AbsoluteSize.X
        local h=math.min(#curOpts*28+8, 200)
        return btnAbs.X-mfAbs.X, btnAbs.Y-mfAbs.Y+dropBtn.AbsoluteSize.Y+6, w, h
    end
    local function closeInstant()
        isOpen=false; dropArrow.Text="v"; dropArrow.Rotation=0
        dropList.Visible=false; dropList.Size=UDim2.new(0,dropList.Size.X.Offset,0,0)
    end
    dropdownClosers[dropFrame]=closeInstant
    local function buildOptions()
        for _,c in ipairs(dropList:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        dropList.CanvasSize=UDim2.new(0,0,0,#curOpts*28+8)
        for i,opt in ipairs(curOpts) do
            local row=Instance.new("TextButton"); row.Size=UDim2.new(1,0,0,28)
            row.BackgroundColor3=COLORS.ACCENT; row.BackgroundTransparency=1
            row.Text=""; row.BorderSizePixel=0; row.LayoutOrder=i; row.ZIndex=601; row.Parent=dropList
            createCorner(row,5)
            local check=Instance.new("TextLabel"); check.Size=UDim2.new(0,18,0,18); check.Position=UDim2.new(0,6,0.5,-9)
            check.BackgroundTransparency=1; check.Text=selected[opt] and "✓" or ""
            check.TextColor3=COLORS.SUCCESS; check.TextSize=14; check.Font=Enum.Font.GothamBold
            check.ZIndex=602; check.Parent=row
            local rl=Instance.new("TextLabel"); rl.Size=UDim2.new(1,-32,1,0); rl.Position=UDim2.new(0,28,0,0)
            rl.BackgroundTransparency=1; rl.Text=opt; rl.TextColor3=COLORS.TEXT_MUTED; rl.TextSize=12
            rl.Font=Enum.Font.Gotham; rl.TextXAlignment=Enum.TextXAlignment.Left; rl.ZIndex=602; rl.Parent=row
            row.MouseButton1Click:Connect(function()
                selected[opt] = not selected[opt]
                check.Text = selected[opt] and "✓" or ""
                refreshLabel()
                local snap={}; for k,v in pairs(selected) do if v then snap[k]=true end end
                dropFrame:SetAttribute("MultiSelectValue", HttpService:JSONEncode(snap))
                safeCall(callback,snap)
                if not isInitializing then saveConfig(nil,false) end
            end)
            row.MouseEnter:Connect(function() createTween(row,{BackgroundTransparency=0.82}); createTween(rl,{TextColor3=COLORS.TEXT}) end)
            row.MouseLeave:Connect(function() createTween(row,{BackgroundTransparency=1}); createTween(rl,{TextColor3=COLORS.TEXT_MUTED}) end)
        end
    end
    buildOptions(); refreshLabel()
    dropBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            local rx,ry,w,h=getListRect()
            dropList.Position=UDim2.new(0,rx,0,ry); dropList.Size=UDim2.new(0,w,0,0)
            dropList.CanvasSize=UDim2.new(0,0,0,#curOpts*28+8); dropList.Visible=true
            createTween(dropArrow,{Rotation=180}); createTween(dropList,{Size=UDim2.new(0,w,0,h)})
        else
            createTween(dropArrow,{Rotation=0})
            createTween(dropList,{Size=UDim2.new(0,dropList.Size.X.Offset,0,0)})
            task.wait(ANIM_TIME); dropList.Visible=false
        end
    end)
    dropFrame.AncestryChanged:Connect(function()
        if not dropFrame:IsDescendantOf(game) then
            pcall(function() dropList:Destroy() end)
            dropdownLists[dropFrame]=nil; dropdownClosers[dropFrame]=nil
        end
    end)
    local function setSel(v)
        if type(v)~="table" then return false end
        selected={}; for k,b in pairs(v) do if b then selected[k]=true end end
        buildOptions(); refreshLabel()
        dropFrame:SetAttribute("MultiSelectValue", HttpService:JSONEncode(selected))
        if callback then local snap={}; for k,b in pairs(selected) do if b then snap[k]=true end end; safeCall(callback,snap) end
        return true
    end
    local function updateOptions(newOpts, keepSel)
        if isOpen then closeInstant() end
        curOpts={table.unpack(newOpts)}
        if not keepSel then selected={} end
        buildOptions(); refreshLabel()
        dropFrame:SetAttribute("MultiSelectValue", HttpService:JSONEncode(selected))
        if not isInitializing then saveConfig(nil,false) end
    end
    dropFrame:SetAttribute("ElementID",makeElementId(tab,text,"MultiSelect"))
    dropFrame:SetAttribute("WidgetType","MultiSelect")
    dropFrame:SetAttribute("MultiSelectValue", HttpService:JSONEncode(selected))
    elementSetters[dropFrame]=function(v) if setSel(v) and not isInitializing then saveConfig(nil,false) end end
    local eid=dropFrame:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="MultiSelect" then
        setSel(restorationQueue[eid].Value); restorationQueue[eid]=nil
    end
    table.insert(tab.Elements, dropFrame)
    return {
        Frame=dropFrame, Instance=dropFrame,
        GetValue=function() local snap={}; for k,b in pairs(selected) do if b then snap[k]=true end end; return snap end,
        SetValue=function(v)
            local ok=setSel(v)
            if ok and not isInitializing then saveConfig(nil,false) end
            return ok
        end,
        UpdateOptions=updateOptions,
    }
end
function GuiLibrary:CreateSearch(tab, placeholder, getItems, onPick)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateSearch: invalid tab"); return nil end
    local rowH = 26
    local maxRows = 6
    local f=Instance.new("Frame"); f.Name="Search"
    f.Size=UDim2.new(1,0,0,36+rowH*maxRows+8); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local box=Instance.new("TextBox"); box.Size=UDim2.new(1,-20,0,26); box.Position=UDim2.new(0,10,0,5)
    box.BackgroundColor3=COLORS.PRIMARY; box.Text=""
    box.PlaceholderText=placeholder or "Search..."; box.PlaceholderColor3=COLORS.TEXT_MUTED
    box.TextColor3=COLORS.TEXT; box.TextSize=12; box.Font=Enum.Font.Gotham
    box.TextXAlignment=Enum.TextXAlignment.Left; box.BorderSizePixel=0
    box.ClearTextOnFocus=false; box.Parent=f; createCorner(box,5)
    local bp=Instance.new("UIPadding"); bp.PaddingLeft=UDim.new(0,8); bp.PaddingRight=UDim.new(0,8); bp.Parent=box
    local list=Instance.new("ScrollingFrame"); list.Size=UDim2.new(1,-16,1,-44); list.Position=UDim2.new(0,8,0,38)
    list.BackgroundColor3=COLORS.PRIMARY; list.BorderSizePixel=0; list.ScrollBarThickness=3
    list.ScrollBarImageColor3=COLORS.ACCENT; list.Parent=f; createCorner(list,6)
    local ll=Instance.new("UIListLayout"); ll.SortOrder=Enum.SortOrder.LayoutOrder; ll.Padding=UDim.new(0,2); ll.Parent=list
    local lpp=Instance.new("UIPadding"); lpp.PaddingTop=UDim.new(0,4); lpp.PaddingLeft=UDim.new(0,4); lpp.PaddingRight=UDim.new(0,4); lpp.PaddingBottom=UDim.new(0,4); lpp.Parent=list
    local function refresh()
        for _,c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local _, items = safeCall(getItems,box.Text)
        if type(items)~="table" then items={} end
        local q = box.Text:lower()
        local shown = {}
        for _,item in ipairs(items) do
            local name = type(item)=="string" and item or tostring(item.Name or item)
            if q=="" or name:lower():find(q,1,true) then table.insert(shown,item) end
        end
        for i,item in ipairs(shown) do
            local name = type(item)=="string" and item or tostring(item.Name or item)
            local row=Instance.new("TextButton"); row.Size=UDim2.new(1,0,0,rowH-2)
            row.BackgroundColor3=COLORS.HOVER; row.BackgroundTransparency=0.5
            row.Text=""; row.BorderSizePixel=0; row.LayoutOrder=i; row.AutoButtonColor=false; row.Parent=list
            createCorner(row,4)
            local rl=Instance.new("TextLabel"); rl.Size=UDim2.new(1,-16,1,0); rl.Position=UDim2.new(0,10,0,0)
            rl.BackgroundTransparency=1; rl.Text=name; rl.TextColor3=COLORS.TEXT; rl.TextSize=12
            rl.Font=Enum.Font.Gotham; rl.TextXAlignment=Enum.TextXAlignment.Left; rl.Parent=row
            row.MouseEnter:Connect(function() createTween(row,{BackgroundTransparency=0.2,BackgroundColor3=COLORS.ACCENT}) end)
            row.MouseLeave:Connect(function() createTween(row,{BackgroundTransparency=0.5,BackgroundColor3=COLORS.HOVER}) end)
            row.MouseButton1Click:Connect(function() safeCall(onPick,item) end)
        end
        list.CanvasSize=UDim2.new(0,0,0,#shown*rowH+8)
    end
    box:GetPropertyChangedSignal("Text"):Connect(refresh)
    refresh()
    table.insert(tab.Elements,f)
    return {Frame=f, Instance=f, Refresh=refresh, GetQuery=function() return box.Text end, SetQuery=function(q) box.Text=tostring(q or "") end}
end
function GuiLibrary:CreateProgressBar(tab, label, getValue, opts)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateProgressBar: invalid tab"); return nil end
    opts = opts or {}
    local pollInterval = math.clamp(tonumber(opts.interval) or 0.1,0.03,60)
    local f=Instance.new("Frame"); f.Name=label.."ProgressBar"
    f.Size=UDim2.new(1,0,0,44); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(0.6,-10,0,16); lbl.Position=UDim2.new(0,10,0,4)
    lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=COLORS.TEXT
    lbl.TextSize=12; lbl.Font=Enum.Font.GothamBold
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    local valLbl=Instance.new("TextLabel"); valLbl.Size=UDim2.new(0.4,-10,0,16); valLbl.Position=UDim2.new(0.6,0,0,4)
    valLbl.BackgroundTransparency=1; valLbl.Text="0%"; valLbl.TextColor3=COLORS.ACCENT
    valLbl.TextSize=12; valLbl.Font=Enum.Font.GothamBold
    valLbl.TextXAlignment=Enum.TextXAlignment.Right; valLbl.Parent=f
    local track=Instance.new("Frame"); track.Name="ProgressTrack"
    track.Size=UDim2.new(1,-20,0,8); track.Position=UDim2.new(0,10,1,-14)
    track.BackgroundColor3=COLORS.BORDER; track.BorderSizePixel=0; track.Parent=f; createCorner(track,4)
    local fill=Instance.new("Frame"); fill.Name="ProgressFill"
    fill.Size=UDim2.new(0,0,1,0); fill.BackgroundColor3=COLORS.ACCENT
    fill.BorderSizePixel=0; fill.Parent=track; createCorner(fill,4)
    local running=true; local lastV = -1
    task.spawn(function()
        while running and f.Parent do
            local ok, v = pcall(getValue)
            if ok and type(v)=="number" then
                v = math.clamp(v, 0, 1)
                if math.abs(v - lastV) > 0.001 then
                    fill.Size = UDim2.new(v, 0, 1, 0)
                    valLbl.Text = string.format("%d%%", math.floor(v*100+0.5))
                    lastV = v
                end
            end
            task.wait(pollInterval)
        end
    end)
    f.AncestryChanged:Connect(function() if not f:IsDescendantOf(game) then running=false end end)
    table.insert(tab.Elements,f)
    return {Frame=f, Instance=f, Stop=function() running=false end, Start=function()
        if running then return end; running=true
        task.spawn(function() while running and f.Parent do local ok,v=pcall(getValue); if ok and type(v)=="number" then v=math.clamp(v,0,1); fill.Size=UDim2.new(v,0,1,0); valLbl.Text=string.format("%d%%",math.floor(v*100+0.5)) end; task.wait(pollInterval) end end)
    end, SetGetter=function(fn) getValue=fn end}
end
function GuiLibrary:CreateGauge(tab, label, minVal, maxVal, getValue, opts)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateGauge: invalid tab"); return nil end
    opts = opts or {}
    minVal=tonumber(minVal) or 0; maxVal=tonumber(maxVal) or (minVal+100)
    if maxVal<=minVal then maxVal=minVal+1 end
    local pollInterval = math.clamp(tonumber(opts.interval) or 0.1,0.03,60)
    local fmt = opts.format or "%.0f"
    local f=Instance.new("Frame"); f.Name=label.."Gauge"
    f.Size=UDim2.new(1,0,0,48); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(0.6,-10,0,16); lbl.Position=UDim2.new(0,10,0,4)
    lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=COLORS.TEXT
    lbl.TextSize=12; lbl.Font=Enum.Font.GothamBold
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    local valLbl=Instance.new("TextLabel"); valLbl.Size=UDim2.new(0.4,-10,0,16); valLbl.Position=UDim2.new(0.6,0,0,4)
    valLbl.BackgroundTransparency=1; valLbl.Text="-"; valLbl.TextColor3=COLORS.ACCENT
    valLbl.TextSize=12; valLbl.Font=Enum.Font.GothamBold
    valLbl.TextXAlignment=Enum.TextXAlignment.Right; valLbl.Parent=f
    local track=Instance.new("Frame"); track.Size=UDim2.new(1,-20,0,6); track.Position=UDim2.new(0,10,1,-14)
    track.BackgroundColor3=COLORS.BORDER; track.BorderSizePixel=0; track.Parent=f; createCorner(track,3)
    local fill=Instance.new("Frame"); fill.Size=UDim2.new(0,0,1,0); fill.BackgroundColor3=COLORS.ACCENT
    fill.BorderSizePixel=0; fill.Parent=track; createCorner(fill,3)
    local minLbl=Instance.new("TextLabel"); minLbl.Size=UDim2.new(0,40,0,12); minLbl.Position=UDim2.new(0,10,1,-4)
    minLbl.BackgroundTransparency=1; minLbl.Text=string.format(fmt,minVal); minLbl.TextColor3=COLORS.TEXT_MUTED
    minLbl.TextSize=9; minLbl.Font=Enum.Font.Gotham; minLbl.TextXAlignment=Enum.TextXAlignment.Left; minLbl.Parent=f
    local maxLbl=Instance.new("TextLabel"); maxLbl.Size=UDim2.new(0,40,0,12); maxLbl.Position=UDim2.new(1,-50,1,-4)
    maxLbl.BackgroundTransparency=1; maxLbl.Text=string.format(fmt,maxVal); maxLbl.TextColor3=COLORS.TEXT_MUTED
    maxLbl.TextSize=9; maxLbl.Font=Enum.Font.Gotham; maxLbl.TextXAlignment=Enum.TextXAlignment.Right; maxLbl.Parent=f
    local running=true
    task.spawn(function()
        while running and f.Parent do
            local ok, v = pcall(getValue)
            if ok and type(v)=="number" then
                local pct = math.clamp((v-minVal)/(maxVal-minVal), 0, 1)
                fill.Size = UDim2.new(pct,0,1,0)
                valLbl.Text = string.format(fmt, v)
            end
            task.wait(pollInterval)
        end
    end)
    f.AncestryChanged:Connect(function() if not f:IsDescendantOf(game) then running=false end end)
    table.insert(tab.Elements,f)
    return {Frame=f, Instance=f, Stop=function() running=false end, SetGetter=function(fn) getValue=fn end}
end
function GuiLibrary:CreatePlayerList(tab, onPickPlayer, opts)
    if not tab or not tab.Content then warn("[GuiLibrary] CreatePlayerList: invalid tab"); return nil end
    opts = opts or {}
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local includeLocal = opts.includeLocal == true
    local rowH = 30; local maxRows = opts.maxRows or 6
    local f=Instance.new("Frame"); f.Name="PlayerList"
    f.Size=UDim2.new(1,0,0,rowH*maxRows+12); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local list=Instance.new("ScrollingFrame"); list.Size=UDim2.new(1,-12,1,-12); list.Position=UDim2.new(0,6,0,6)
    list.BackgroundColor3=COLORS.PRIMARY; list.BorderSizePixel=0; list.ScrollBarThickness=3
    list.ScrollBarImageColor3=COLORS.ACCENT; list.Parent=f; createCorner(list,6)
    local ll=Instance.new("UIListLayout"); ll.SortOrder=Enum.SortOrder.Name; ll.Padding=UDim.new(0,2); ll.Parent=list
    local lpp=Instance.new("UIPadding"); lpp.PaddingTop=UDim.new(0,4); lpp.PaddingLeft=UDim.new(0,4); lpp.PaddingRight=UDim.new(0,4); lpp.PaddingBottom=UDim.new(0,4); lpp.Parent=list
    local function refresh()
        for _,c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local count=0
        for _,p in ipairs(Players:GetPlayers()) do
            if includeLocal or p~=LocalPlayer then
                count = count + 1
                local row=Instance.new("TextButton"); row.Name=p.Name; row.Size=UDim2.new(1,0,0,rowH-2)
                row.BackgroundColor3=COLORS.HOVER; row.BackgroundTransparency=0.5
                row.Text=""; row.BorderSizePixel=0; row.AutoButtonColor=false; row.Parent=list
                createCorner(row,4)
                local img=Instance.new("ImageLabel"); img.Size=UDim2.new(0,20,0,20); img.Position=UDim2.new(0,6,0.5,-10)
                img.BackgroundTransparency=1; img.BorderSizePixel=0
                img.Image=string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", p.UserId)
                img.Parent=row; createCorner(img,10)
                local nm=Instance.new("TextLabel"); nm.Size=UDim2.new(1,-36,1,0); nm.Position=UDim2.new(0,32,0,0)
                nm.BackgroundTransparency=1
                nm.Text=p.DisplayName~=p.Name and (p.DisplayName.." (@"..p.Name..")") or p.Name
                nm.TextColor3=COLORS.TEXT; nm.TextSize=12; nm.Font=Enum.Font.Gotham
                nm.TextXAlignment=Enum.TextXAlignment.Left; nm.Parent=row
                row.MouseEnter:Connect(function() createTween(row,{BackgroundTransparency=0.2,BackgroundColor3=COLORS.ACCENT}) end)
                row.MouseLeave:Connect(function() createTween(row,{BackgroundTransparency=0.5,BackgroundColor3=COLORS.HOVER}) end)
                row.MouseButton1Click:Connect(function() if onPickPlayer then onPickPlayer(p) end end)
            end
        end
        list.CanvasSize=UDim2.new(0,0,0,count*rowH+8)
    end
    refresh()
    local addConn = Players.PlayerAdded:Connect(refresh)
    local remConn = Players.PlayerRemoving:Connect(refresh)
    table.insert(activeInputConnections, addConn)
    table.insert(activeInputConnections, remConn)
    f.AncestryChanged:Connect(function()
        if not f:IsDescendantOf(game) then
            pcall(function() addConn:Disconnect() end); pcall(function() remConn:Disconnect() end)
        end
    end)
    table.insert(tab.Elements,f)
    return {Frame=f, Instance=f, Refresh=refresh}
end
function GuiLibrary:CreateBindGroup(tab, title, list)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateBindGroup: invalid tab"); return nil end
    list = list or {}
    local rowH = 30
    local headerH = title and 22 or 0
    local totalH = headerH + #list * rowH + 12
    local f=Instance.new("Frame"); f.Name=(title or "BindGroup").."BindGroup"
    f.Size=UDim2.new(1,0,0,totalH); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    if title then
        local titleLbl=Instance.new("TextLabel"); titleLbl.Size=UDim2.new(1,-20,0,headerH); titleLbl.Position=UDim2.new(0,12,0,4)
        titleLbl.BackgroundTransparency=1; titleLbl.Text=title; titleLbl.TextColor3=COLORS.ACCENT
        titleLbl.TextSize=11; titleLbl.Font=Enum.Font.GothamBold
        titleLbl.TextXAlignment=Enum.TextXAlignment.Left; titleLbl.Parent=f
    end
    local bindings = {}
    for i,entry in ipairs(list) do
        local row=Instance.new("Frame"); row.Size=UDim2.new(1,-12,0,rowH-4); row.Position=UDim2.new(0,6,0,headerH+(i-1)*rowH+6)
        row.BackgroundTransparency=1; row.BorderSizePixel=0; row.Parent=f
        local rl=Instance.new("TextLabel"); rl.Size=UDim2.new(1,-90,1,0); rl.Position=UDim2.new(0,8,0,0)
        rl.BackgroundTransparency=1; rl.Text=entry.label or ("Bind "..i); rl.TextColor3=COLORS.TEXT
        rl.TextSize=12; rl.Font=Enum.Font.Gotham; rl.TextXAlignment=Enum.TextXAlignment.Left; rl.Parent=row
        local kbBtn=Instance.new("TextButton"); kbBtn.Size=UDim2.new(0,70,0,22); kbBtn.Position=UDim2.new(1,-78,0.5,-11)
        kbBtn.BackgroundColor3=COLORS.PRIMARY
        kbBtn.TextColor3=COLORS.TEXT; kbBtn.TextSize=10; kbBtn.Font=Enum.Font.GothamBold
        kbBtn.BorderSizePixel=0; kbBtn.AutoButtonColor=false; kbBtn.Parent=row
        createCorner(kbBtn,5); createStroke(kbBtn,1,COLORS.BORDER)
        local curBind
        if typeof(entry.default)=="EnumItem" then
            if entry.default.EnumType==Enum.KeyCode then curBind={type="key",value=entry.default}
            elseif isBindableMouse(entry.default) then
                curBind={type="mouse",value=entry.default} end
        end
        kbBtn.Text = bindToString(curBind)
        local listening=false; local lastTrig=0
        kbBtn.MouseButton1Click:Connect(function()
            if listening then return end; listening=true; kbBtn.Text="..."
            createTween(kbBtn,{BackgroundColor3=COLORS.WARNING})
            -- Same as CreateKeybind: don't ignore gp while listening, so the key
            -- is captured without needing to tab out of the GUI.
            local uisConn, sideConn, textConn, focusConn, box, done
            local function finish(nb)
                if done then return end; done=true
                curBind=nb; kbBtn.Text=bindToString(curBind)
                listening=false; createTween(kbBtn,{BackgroundColor3=COLORS.PRIMARY})
                if uisConn then uisConn:Disconnect() end
                if sideConn then sideConn:Disconnect() end
                if textConn then textConn:Disconnect() end
                if focusConn then focusConn:Disconnect() end
                if box then box:Destroy() end
                local snap = {}; for k,b in pairs(bindings) do snap[k] = bindToString(b.getBind()) end
                f:SetAttribute("BindGroupValue", HttpService:JSONEncode(snap))
                saveConfig(nil,false)
            end
            box=Instance.new("TextBox")  -- catches letters/numbers (TextInput on Real)
            box.Size=UDim2.new(0,1,0,1); box.BackgroundTransparency=1; box.TextTransparency=1
            box.Text=""; box.ClearTextOnFocus=false; box.MultiLine=false; box.Parent=kbBtn
            textConn=box:GetPropertyChangedSignal("Text"):Connect(function()
                local t=box.Text; if t=="" then return end
                local kc=charToKeyCode(t:sub(-1)); box.Text=""
                if kc then finish({type="key",value=kc}) end
            end)
            focusConn=box.FocusLost:Connect(function(_, inp)
                if inp and inp.KeyCode==Enum.KeyCode.Escape then finish(nil) end
            end)
            uisConn=UserInputService.InputBegan:Connect(function(inp,gp)
                if inp.UserInputType==Enum.UserInputType.Keyboard then
                    local kc=inp.KeyCode
                    if kc==Enum.KeyCode.Backspace or kc==Enum.KeyCode.Delete or kc==Enum.KeyCode.Escape then finish(nil)
                    elseif kc~=Enum.KeyCode.Unknown then finish({type="key",value=kc}) end
                elseif isBindableMouse(inp.UserInputType) then  -- MB1 never bindable
                    finish({type="mouse",value=inp.UserInputType})
                end
            end)
            sideConn=SideButtons.onBegan(function(name) finish({type="side",name=name}) end)
            task.defer(function() if not done and box then pcall(function() box:CaptureFocus() end) end end)
            task.delay(10, function() finish(curBind) end)
        end)
        kbBtn.MouseButton2Click:Connect(function()  -- right-click to clear
            if listening then return end
            curBind=nil; kbBtn.Text=bindToString(curBind)
            local snap = {}; for k,b in pairs(bindings) do snap[k] = bindToString(b.getBind()) end
            f:SetAttribute("BindGroupValue", HttpService:JSONEncode(snap))
            if not isInitializing then saveConfig(nil,false) end
        end)
        local trigConn = UserInputService.InputBegan:Connect(function(inp,gp)
            if listening then return end
            if UserInputService:GetFocusedTextBox() then return end
            if curBind and curBind.type=="mouse" and gp then return end
            if tick()-lastTrig<0.2 then return end
            if matchesBind(curBind, inp) then lastTrig=tick(); safeCall(entry.callback) end
        end); table.insert(activeInputConnections, trigConn)
        local sideTrig = SideButtons.onBegan(function(name)
            if listening then return end
            if not (curBind and curBind.type=="side" and curBind.name==name) then return end
            if tick()-lastTrig<0.2 then return end
            lastTrig=tick(); safeCall(entry.callback)
        end); table.insert(activeInputConnections, sideTrig)
        bindings[entry.label or ("Bind "..i)] = {
            getBind = function() return curBind end,
            setBind = function(s) local b=stringToBind(s); if bindIsBanned(b) then b=nil end; curBind=b; kbBtn.Text=bindToString(curBind) end,
            kbBtn = kbBtn,
            callback = entry.callback,
        }
    end
    local function snapshot()
        local snap = {}; for k,b in pairs(bindings) do snap[k] = bindToString(b.getBind()) end; return snap
    end
    f:SetAttribute("ElementID",makeElementId(tab,title or "Group","BindGroup"))
    f:SetAttribute("WidgetType","BindGroup")
    f:SetAttribute("BindGroupValue", HttpService:JSONEncode(snapshot()))
    elementSetters[f]=function(v)
        if type(v)~="table" then return end
        for label, bs in pairs(v) do if bindings[label] then bindings[label].setBind(bs) end end
        f:SetAttribute("BindGroupValue", HttpService:JSONEncode(snapshot()))
    end
    local eid=f:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="BindGroup" then
        local v = restorationQueue[eid].Value
        if type(v)=="table" then for label,bs in pairs(v) do if bindings[label] then bindings[label].setBind(bs) end end end
        restorationQueue[eid]=nil
    end
    table.insert(tab.Elements,f)
    return {
        Frame=f, Instance=f,
        GetBinds=snapshot,
        SetBind=function(label,s)
            if not bindings[label] then return false end
            bindings[label].setBind(s)
            f:SetAttribute("BindGroupValue", HttpService:JSONEncode(snapshot()))
            if not isInitializing then saveConfig(nil,false) end
            return true
        end,
    }
end
function GuiLibrary:CreateColorGradient(tab, label, defaultStops, onChange)
    if not tab or not tab.Content then warn("[GuiLibrary] CreateColorGradient: invalid tab"); return nil end
    defaultStops = defaultStops or { Color3.fromRGB(255,80,80), Color3.fromRGB(80,80,255) }
    local function normStop(v)
        if typeof(v)=="Color3" then return {color=v, transparency=0} end
        if type(v)=="table" then return {color=v.color or Color3.new(1,1,1), transparency=v.transparency or 0} end
        return {color=Color3.new(1,1,1), transparency=0}
    end
    local stops = { normStop(defaultStops[1]), normStop(defaultStops[2]) }
    local mf = GuiLibrary.CurrentWindow and GuiLibrary.CurrentWindow.MainFrame
    local f=Instance.new("Frame"); f.Name=label.."ColorGradient"
    f.Size=UDim2.new(1,0,0,76); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)
    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-110,0,16); lbl.Position=UDim2.new(0,10,0,5)
    lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=COLORS.TEXT
    lbl.TextSize=12; lbl.Font=Enum.Font.GothamBold
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f
    local function mkSwatch(xPos)
        local s=Instance.new("TextButton"); s.Size=UDim2.new(0,26,0,26); s.Position=UDim2.new(1,xPos,0,6)
        s.Text=""; s.BorderSizePixel=0; s.AutoButtonColor=false; s.Parent=f
        createCorner(s,6); createStroke(s,1.5,COLORS.BORDER)
        return s
    end
    local sw1=mkSwatch(-72)
    local sw2=mkSwatch(-36)
    local strip=Instance.new("Frame"); strip.Size=UDim2.new(1,-20,0,14); strip.Position=UDim2.new(0,10,0,36)
    strip.BackgroundColor3=Color3.fromRGB(180,180,180); strip.BorderSizePixel=0; strip.Parent=f; createCorner(strip,4)
    local stripInner=Instance.new("Frame"); stripInner.Size=UDim2.new(1,0,1,0); stripInner.BackgroundColor3=Color3.new(1,1,1)
    stripInner.BorderSizePixel=0; stripInner.Parent=strip; createCorner(stripInner,4)
    local grad=Instance.new("UIGradient"); grad.Parent=stripInner
    local info=Instance.new("TextLabel"); info.Size=UDim2.new(1,-20,0,14); info.Position=UDim2.new(0,10,0,56)
    info.BackgroundTransparency=1; info.TextColor3=COLORS.TEXT_MUTED
    info.TextSize=10; info.Font=Enum.Font.Code
    info.TextXAlignment=Enum.TextXAlignment.Left; info.Parent=f
    local function hex(c)
        return string.format("#%02X%02X%02X",
            math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
    end
    local function emit()
        sw1.BackgroundColor3=stops[1].color; sw1.BackgroundTransparency=stops[1].transparency
        sw2.BackgroundColor3=stops[2].color; sw2.BackgroundTransparency=stops[2].transparency
        local seq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, stops[1].color),
            ColorSequenceKeypoint.new(1, stops[2].color),
        })
        grad.Color = seq
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, stops[1].transparency),
            NumberSequenceKeypoint.new(1, stops[2].transparency),
        })
        info.Text = string.format("Start %s α %d%%   →   End %s α %d%%",
            hex(stops[1].color), math.floor((1-stops[1].transparency)*100+0.5),
            hex(stops[2].color), math.floor((1-stops[2].transparency)*100+0.5))
        f:SetAttribute("ColorGradientValue", HttpService:JSONEncode({
            {R=stops[1].color.R, G=stops[1].color.G, B=stops[1].color.B, T=stops[1].transparency},
            {R=stops[2].color.R, G=stops[2].color.G, B=stops[2].color.B, T=stops[2].transparency},
        }))
        safeCall(onChange,seq,grad.Transparency)
        if not isInitializing then saveConfig(nil,false) end
    end
    local popup, popupCtl
    local activeStopIdx = 1
    local function buildPopup()
        popup=Instance.new("Frame"); popup.Name="GradientStopPicker"
        popup.Size=UDim2.new(0,318,0,236); popup.BackgroundColor3=COLORS.PRIMARY
        popup.BorderSizePixel=0; popup.Visible=false; popup.ZIndex=800
        popup.Parent = mf or f; createCorner(popup,10); createStroke(popup,1,COLORS.BORDER)
        local hue,sat,val,transparency=0,1,1,0
        local curColor=Color3.fromHSV(0,1,1)
        local svF=Instance.new("Frame"); svF.Size=UDim2.new(0,184,0,184)
        svF.Position=UDim2.new(0,10,0,10); svF.BackgroundColor3=Color3.fromHSV(hue,1,1)
        svF.BorderSizePixel=0; svF.ZIndex=801; svF.Parent=popup; createCorner(svF,6)
        local svW=Instance.new("Frame"); svW.Size=UDim2.new(1,0,1,0); svW.BackgroundColor3=Color3.new(1,1,1)
        svW.BorderSizePixel=0; svW.ZIndex=802; svW.Parent=svF
        local sg=Instance.new("UIGradient"); sg.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}); sg.Parent=svW
        local svB=Instance.new("Frame"); svB.Size=UDim2.new(1,0,1,0); svB.BackgroundColor3=Color3.new(0,0,0)
        svB.BorderSizePixel=0; svB.ZIndex=803; svB.Parent=svF
        local vg=Instance.new("UIGradient"); vg.Rotation=90
        vg.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.new(0,0,0)),ColorSequenceKeypoint.new(1,Color3.new(0,0,0))})
        vg.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}); vg.Parent=svB
        local svMark=Instance.new("Frame"); svMark.Size=UDim2.new(0,12,0,12); svMark.AnchorPoint=Vector2.new(0.5,0.5)
        svMark.BackgroundColor3=Color3.new(1,1,1); svMark.BorderSizePixel=0; svMark.ZIndex=804; svMark.Parent=svF
        createCorner(svMark,6); createStroke(svMark,1.5,Color3.new(0,0,0))
        local hueF=Instance.new("Frame"); hueF.Size=UDim2.new(0,18,0,184)
        hueF.Position=UDim2.new(0,202,0,10); hueF.BorderSizePixel=0; hueF.ZIndex=801; hueF.Parent=popup; createCorner(hueF,6)
        local hg=Instance.new("UIGradient"); hg.Rotation=90
        hg.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(0.17,Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.33,Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(0.50,Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.67,Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(0.83,Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(255,0,0)),
        }); hg.Parent=hueF
        local hueMark=Instance.new("Frame"); hueMark.Size=UDim2.new(1,4,0,4); hueMark.AnchorPoint=Vector2.new(0,0.5)
        hueMark.BackgroundColor3=Color3.new(1,1,1); hueMark.BorderSizePixel=0; hueMark.ZIndex=802; hueMark.Parent=hueF; createCorner(hueMark,2)
        local tranF=Instance.new("Frame"); tranF.Size=UDim2.new(0,18,0,184)
        tranF.Position=UDim2.new(0,236,0,10); tranF.BackgroundColor3=Color3.fromRGB(180,180,180)
        tranF.BorderSizePixel=0; tranF.ZIndex=801; tranF.Parent=popup; createCorner(tranF,6)
        local tranC=Instance.new("Frame"); tranC.Size=UDim2.new(1,0,1,0); tranC.BackgroundColor3=curColor
        tranC.BorderSizePixel=0; tranC.ZIndex=802; tranC.Parent=tranF; createCorner(tranC,6)
        local tg=Instance.new("UIGradient"); tg.Rotation=90
        tg.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}); tg.Parent=tranC
        local tranMark=Instance.new("Frame"); tranMark.Size=UDim2.new(1,4,0,4); tranMark.AnchorPoint=Vector2.new(0,0.5)
        tranMark.BackgroundColor3=Color3.new(1,1,1); tranMark.BorderSizePixel=0; tranMark.ZIndex=803; tranMark.Parent=tranF; createCorner(tranMark,2)
        local function mkBox(lx, defVal)
            local box=Instance.new("TextBox"); box.Size=UDim2.new(0,38,0,18); box.Position=UDim2.new(0,lx,0,200)
            box.BackgroundColor3=COLORS.HOVER; box.Text=tostring(defVal); box.PlaceholderText="0-255"
            box.PlaceholderColor3=COLORS.TEXT_MUTED; box.TextColor3=COLORS.TEXT; box.TextSize=11
            box.Font=Enum.Font.GothamBold; box.TextXAlignment=Enum.TextXAlignment.Center
            box.BorderSizePixel=0; box.ZIndex=805; box.Parent=popup; createCorner(box,4); return box
        end
        local rBox=mkBox(10,255); local gBox=mkBox(54,255); local bBox=mkBox(98,255)
        local hexLbl=Instance.new("TextLabel"); hexLbl.Size=UDim2.new(0,90,0,18); hexLbl.Position=UDim2.new(0,148,0,200)
        hexLbl.BackgroundTransparency=1; hexLbl.Text="#FFFFFF"; hexLbl.TextColor3=COLORS.TEXT
        hexLbl.TextSize=11; hexLbl.Font=Enum.Font.Code; hexLbl.ZIndex=805
        hexLbl.TextXAlignment=Enum.TextXAlignment.Left; hexLbl.Parent=popup
        local alphaLbl=Instance.new("TextLabel"); alphaLbl.Size=UDim2.new(0,70,0,18); alphaLbl.Position=UDim2.new(0,242,0,200)
        alphaLbl.BackgroundTransparency=1; alphaLbl.Text="α 100%"; alphaLbl.TextColor3=COLORS.TEXT_MUTED
        alphaLbl.TextSize=11; alphaLbl.Font=Enum.Font.Code; alphaLbl.ZIndex=805
        alphaLbl.TextXAlignment=Enum.TextXAlignment.Right; alphaLbl.Parent=popup
        local closeBtn=Instance.new("TextButton"); closeBtn.Size=UDim2.new(0,22,0,22); closeBtn.Position=UDim2.new(1,-28,0,6)
        closeBtn.BackgroundColor3=COLORS.DANGER; closeBtn.BackgroundTransparency=0.4
        closeBtn.Text="X"; closeBtn.TextColor3=Color3.new(1,1,1); closeBtn.TextSize=12
        closeBtn.Font=Enum.Font.GothamBold; closeBtn.BorderSizePixel=0
        closeBtn.AutoButtonColor=false; closeBtn.ZIndex=815; closeBtn.Parent=popup; createCorner(closeBtn,6)
        local dragSV,dragHue,dragTran=false,false,false
        local function updateMarkers()
            svMark.Position=UDim2.new(0,sat*svF.AbsoluteSize.X,0,(1-val)*svF.AbsoluteSize.Y)
            hueMark.Position=UDim2.new(0,-2,hue,-2)
            tranMark.Position=UDim2.new(0,-2,transparency,-2)
        end
        local function applyHSV()
            curColor=Color3.fromHSV(hue,sat,val)
            rBox.Text=tostring(math.floor(curColor.R*255))
            gBox.Text=tostring(math.floor(curColor.G*255))
            bBox.Text=tostring(math.floor(curColor.B*255))
            svF.BackgroundColor3=Color3.fromHSV(hue,1,1)
            tranC.BackgroundColor3=curColor
            hexLbl.Text=string.format("#%02X%02X%02X",
                math.floor(curColor.R*255+0.5), math.floor(curColor.G*255+0.5), math.floor(curColor.B*255+0.5))
            alphaLbl.Text=string.format("α %d%%", math.floor((1-transparency)*100+0.5))
            updateMarkers()
            stops[activeStopIdx].color = curColor
            stops[activeStopIdx].transparency = transparency
            emit()
        end
        local function setHSV(h,s,v,t)
            hue=math.clamp(h or hue,0,1); sat=math.clamp(s or sat,0,1); val=math.clamp(v or val,0,1)
            transparency=math.clamp(t or transparency,0,1)
            applyHSV()
        end
        local function setColor(c, t)
            if typeof(c)=="Color3" then curColor=c; hue,sat,val=Color3.toHSV(c) end
            transparency = math.clamp(t or 0, 0, 1)
            applyHSV()
        end
        local function sp(inp)
            local p=(inp and inp.Position) and inp.Position or UserInputService:GetMouseLocation()
            return typeof(p)=="Vector3" and Vector2.new(p.X,p.Y) or (typeof(p)=="Vector2" and p or UserInputService:GetMouseLocation())
        end
        local function isPress(i) return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch end
        local function isMove(i) return i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch end
        svF.InputBegan:Connect(function(i) if isPress(i) then dragSV=true;local c=sp(i);local x=math.clamp((c.X-svF.AbsolutePosition.X)/svF.AbsoluteSize.X,0,1);local y=math.clamp((c.Y-svF.AbsolutePosition.Y)/svF.AbsoluteSize.Y,0,1);setHSV(hue,x,1-y) end end)
        svF.InputChanged:Connect(function(i) if dragSV and isMove(i) then local c=sp(i);local x=math.clamp((c.X-svF.AbsolutePosition.X)/svF.AbsoluteSize.X,0,1);local y=math.clamp((c.Y-svF.AbsolutePosition.Y)/svF.AbsoluteSize.Y,0,1);setHSV(hue,x,1-y) end end)
        svF.InputEnded:Connect(function(i) if isPress(i) then dragSV=false end end)
        hueF.InputBegan:Connect(function(i) if isPress(i) then dragHue=true;local c=sp(i);setHSV(math.clamp((c.Y-hueF.AbsolutePosition.Y)/hueF.AbsoluteSize.Y,0,1),sat,val) end end)
        hueF.InputChanged:Connect(function(i) if dragHue and isMove(i) then local c=sp(i);setHSV(math.clamp((c.Y-hueF.AbsolutePosition.Y)/hueF.AbsoluteSize.Y,0,1),sat,val) end end)
        hueF.InputEnded:Connect(function(i) if isPress(i) then dragHue=false end end)
        tranF.InputBegan:Connect(function(i) if isPress(i) then dragTran=true;local c=sp(i);setHSV(hue,sat,val,math.clamp((c.Y-tranF.AbsolutePosition.Y)/tranF.AbsoluteSize.Y,0,1)) end end)
        tranF.InputChanged:Connect(function(i) if dragTran and isMove(i) then local c=sp(i);setHSV(hue,sat,val,math.clamp((c.Y-tranF.AbsolutePosition.Y)/tranF.AbsoluteSize.Y,0,1)) end end)
        tranF.InputEnded:Connect(function(i) if isPress(i) then dragTran=false end end)
        local function onRGB()
            local r=math.clamp(tonumber(rBox.Text) or 0,0,255)
            local g=math.clamp(tonumber(gBox.Text) or 0,0,255)
            local b=math.clamp(tonumber(bBox.Text) or 0,0,255)
            setColor(Color3.new(r/255,g/255,b/255), transparency)
        end
        rBox.FocusLost:Connect(onRGB); gBox.FocusLost:Connect(onRGB); bBox.FocusLost:Connect(onRGB)
        closeBtn.MouseButton1Click:Connect(function() popup.Visible=false end)
        closeBtn.MouseEnter:Connect(function() createTween(closeBtn,{BackgroundTransparency=0}) end)
        closeBtn.MouseLeave:Connect(function() createTween(closeBtn,{BackgroundTransparency=0.4}) end)
        popupCtl = {SetColor=setColor, Frame=popup}
    end
    local function showPopup(stopIdx)
        activeStopIdx = stopIdx
        if not popup then buildPopup() end
        popupCtl.SetColor(stops[stopIdx].color, stops[stopIdx].transparency)
        if mf then
            local fAbs = f.AbsolutePosition; local mfAbs = mf.AbsolutePosition
            local x = fAbs.X - mfAbs.X
            local y = fAbs.Y - mfAbs.Y + f.AbsoluteSize.Y + 4
            local maxX = mf.AbsoluteSize.X - popup.Size.X.Offset - 8
            local maxY = mf.AbsoluteSize.Y - popup.Size.Y.Offset - 8
            x = math.max(8, math.min(x, maxX))
            y = math.max(8, math.min(y, maxY))
            popup.Position = UDim2.new(0, x, 0, y)
        end
        popup.Visible = true
    end
    sw1.MouseButton1Click:Connect(function() showPopup(1) end)
    sw2.MouseButton1Click:Connect(function() showPopup(2) end)
    f:SetAttribute("ElementID",makeElementId(tab,label,"ColorGradient"))
    f:SetAttribute("WidgetType","ColorGradient")
    emit()
    local function setStops(a, b)
        if a then
            if typeof(a)=="Color3" then stops[1].color=a
            elseif type(a)=="table" then if a.color then stops[1].color=a.color end; if a.transparency then stops[1].transparency=a.transparency end end
        end
        if b then
            if typeof(b)=="Color3" then stops[2].color=b
            elseif type(b)=="table" then if b.color then stops[2].color=b.color end; if b.transparency then stops[2].transparency=b.transparency end end
        end
        emit()
    end
    elementSetters[f]=function(v)
        if type(v)~="table" or not v[1] or not v[2] then return end
        for i=1,2 do
            local s=v[i]
            if s and s.R~=nil and s.G~=nil and s.B~=nil then
                stops[i].color = Color3.new(s.R, s.G, s.B)
                stops[i].transparency = s.T or 0
            end
        end
        emit()
    end
    local eid=f:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="ColorGradient" then
        elementSetters[f](restorationQueue[eid].Value); restorationQueue[eid]=nil
    end
    f.AncestryChanged:Connect(function()
        if not f:IsDescendantOf(game) and popup then pcall(function() popup:Destroy() end) end
    end)
    table.insert(tab.Elements,f)
    return {
        Frame=f, Instance=f,
        GetValue=function()
            return ColorSequence.new({
                ColorSequenceKeypoint.new(0, stops[1].color),
                ColorSequenceKeypoint.new(1, stops[2].color),
            })
        end,
        GetTransparencySequence=function()
            return NumberSequence.new({
                NumberSequenceKeypoint.new(0, stops[1].transparency),
                NumberSequenceKeypoint.new(1, stops[2].transparency),
            })
        end,
        GetStops=function() return stops[1], stops[2] end,
        SetStops=setStops,
    }
end
function GuiLibrary:CreateModal(title, body, buttons)
    buttons = buttons or {{text="OK", style="primary"}}
    if type(buttons)~="table" then buttons={{text="OK", style="primary"}} end
    local sg = Instance.new("ScreenGui"); sg.Name="GuiLibraryModal"
    sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true
    sg.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder = 1000
    if not parentToCoreGui(sg) then return nil end
    local backdrop=Instance.new("TextButton"); backdrop.Size=UDim2.new(1,0,1,0)
    backdrop.BackgroundColor3=Color3.new(0,0,0); backdrop.BackgroundTransparency=1
    backdrop.Text=""; backdrop.AutoButtonColor=false; backdrop.BorderSizePixel=0
    backdrop.Parent=sg
    createTween(backdrop,{BackgroundTransparency=0.55})
    local card=Instance.new("Frame"); card.Size=UDim2.new(0,360,0,180); card.AnchorPoint=Vector2.new(0.5,0.5)
    card.Position=UDim2.new(0.5,0,0.5,-20); card.BackgroundColor3=COLORS.PRIMARY
    card.BorderSizePixel=0; card.BackgroundTransparency=1
    card.Parent=sg; createCorner(card,12); createStroke(card,1,COLORS.BORDER)
    createTween(card,{BackgroundTransparency=0, Position=UDim2.new(0.5,0,0.5,0)},0.25)
    local titleLbl=Instance.new("TextLabel"); titleLbl.Size=UDim2.new(1,-30,0,28); titleLbl.Position=UDim2.new(0,15,0,12)
    titleLbl.BackgroundTransparency=1; titleLbl.Text=tostring(title or "Confirm")
    titleLbl.TextColor3=COLORS.TEXT; titleLbl.TextSize=15; titleLbl.Font=Enum.Font.GothamBold
    titleLbl.TextXAlignment=Enum.TextXAlignment.Left; titleLbl.Parent=card
    local bodyLbl=Instance.new("TextLabel"); bodyLbl.Size=UDim2.new(1,-30,0,80); bodyLbl.Position=UDim2.new(0,15,0,44)
    bodyLbl.BackgroundTransparency=1; bodyLbl.Text=tostring(body or "")
    bodyLbl.TextColor3=COLORS.TEXT_MUTED; bodyLbl.TextSize=12; bodyLbl.Font=Enum.Font.Gotham
    bodyLbl.TextXAlignment=Enum.TextXAlignment.Left; bodyLbl.TextYAlignment=Enum.TextYAlignment.Top
    bodyLbl.TextWrapped=true; bodyLbl.Parent=card
    local closed=false
    local function close()
        if closed then return end; closed=true
        createTween(backdrop,{BackgroundTransparency=1},0.2)
        createTween(card,{BackgroundTransparency=1, Position=UDim2.new(0.5,0,0.5,20)},0.2)
        task.delay(0.25, function() sg:Destroy() end)
    end
    local btnW = 90; local btnH = 30; local gap=8
    local totalW = #buttons*btnW + (#buttons-1)*gap
    local startX = (360 - totalW)/2
    for i,bd in ipairs(buttons) do
        local b=Instance.new("TextButton"); b.Size=UDim2.new(0,btnW,0,btnH)
        b.Position=UDim2.new(0,startX+(i-1)*(btnW+gap),1,-btnH-12)
        local style=bd.style or "primary"
        b.BackgroundColor3 = (style=="danger" and COLORS.DANGER) or (style=="ghost" and COLORS.HOVER) or COLORS.ACCENT
        b.Text=tostring(bd.text or "Button"); b.TextColor3=Color3.new(1,1,1)
        b.TextSize=12; b.Font=Enum.Font.GothamBold; b.BorderSizePixel=0
        b.AutoButtonColor=false; b.Parent=card; createCorner(b,6)
        b.MouseButton1Click:Connect(function()
            safeCall(bd.callback)
            close()
        end)
        b.MouseEnter:Connect(function() createTween(b,{BackgroundTransparency=0.15}) end)
        b.MouseLeave:Connect(function() createTween(b,{BackgroundTransparency=0}) end)
    end
    backdrop.MouseButton1Click:Connect(close)
    return {ScreenGui=sg, Close=close}
end
GuiLibrary.NotificationsEnabled = true
GuiLibrary.NotificationDuration = 3
local activeNotifs = {}
local NOTIF_HEIGHT = 76
local NOTIF_GAP    = 10
local NOTIF_TOP    = 60
local function reflowNotifs()
    for i, entry in ipairs(activeNotifs) do
        if entry.Frame and entry.Frame.Parent then
            local y = NOTIF_TOP + (i-1) * (NOTIF_HEIGHT + NOTIF_GAP)
            entry.TargetY = y
            createTween(entry.Frame, {Position=UDim2.new(1,-310,0,y)}, 0.25)
        end
    end
end
function GuiLibrary:CreateNotification(title, message, duration, notifType)
    if GuiLibrary.NotificationsEnabled==false then return end
    duration=math.clamp(tonumber(duration) or tonumber(GuiLibrary.NotificationDuration) or 3,0.25,30)
    notifType=notifType or "info"
    local tColors={info=COLORS.ACCENT,success=COLORS.SUCCESS,warning=COLORS.WARNING,error=COLORS.DANGER}
    local tIcons ={info="i",success="✓",warning="!",error="x"}
    local nc=tColors[notifType] or COLORS.ACCENT
    local sg=Instance.new("ScreenGui"); sg.Name="NotificationGui"
    sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true
    sg.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; sg.DisplayOrder=900
    if not parentToCoreGui(sg) then return nil end
    local nf=Instance.new("Frame"); nf.Size=UDim2.new(0,300,0,NOTIF_HEIGHT)
    nf.BackgroundColor3=COLORS.PRIMARY
    nf.BorderSizePixel=0; nf.Parent=sg; createCorner(nf,10); createStroke(nf,1,COLORS.BORDER)
    local bar=Instance.new("Frame"); bar.Size=UDim2.new(0,4,1,-20); bar.Position=UDim2.new(0,0,0,10)
    bar.BackgroundColor3=nc; bar.BorderSizePixel=0; bar.Parent=nf; createCorner(bar,2)
    local ic=Instance.new("Frame"); ic.Size=UDim2.new(0,28,0,28); ic.Position=UDim2.new(0,14,0.5,-14)
    ic.BackgroundColor3=nc; ic.BackgroundTransparency=0.8; ic.BorderSizePixel=0; ic.Parent=nf; createCorner(ic,14)
    local il=Instance.new("TextLabel"); il.Size=UDim2.new(1,0,1,0); il.BackgroundTransparency=1
    il.Text=tIcons[notifType] or "i"; il.TextColor3=nc; il.TextSize=13; il.Font=Enum.Font.GothamBold; il.Parent=ic
    local tl=Instance.new("TextLabel"); tl.Size=UDim2.new(1,-58,0,22); tl.Position=UDim2.new(0,52,0,12)
    tl.BackgroundTransparency=1; tl.Text=tostring(title or ""); tl.TextColor3=COLORS.TEXT; tl.TextSize=13
    tl.Font=Enum.Font.GothamBold; tl.TextXAlignment=Enum.TextXAlignment.Left; tl.Parent=nf
    local ml=Instance.new("TextLabel"); ml.Size=UDim2.new(1,-58,0,30); ml.Position=UDim2.new(0,52,0,34)
    ml.BackgroundTransparency=1; ml.Text=tostring(message or ""); ml.TextColor3=COLORS.TEXT_MUTED; ml.TextSize=11
    ml.Font=Enum.Font.Gotham; ml.TextXAlignment=Enum.TextXAlignment.Left; ml.TextWrapped=true; ml.Parent=nf
    local pbg=Instance.new("Frame"); pbg.Size=UDim2.new(1,-16,0,2); pbg.Position=UDim2.new(0,8,1,-6)
    pbg.BackgroundColor3=COLORS.BORDER; pbg.BorderSizePixel=0; pbg.Parent=nf; createCorner(pbg,1)
    local pf=Instance.new("Frame"); pf.Size=UDim2.new(1,0,1,0); pf.BackgroundColor3=nc
    pf.BorderSizePixel=0; pf.Parent=pbg; createCorner(pf,1)
    local slotY = NOTIF_TOP + (#activeNotifs) * (NOTIF_HEIGHT + NOTIF_GAP)
    local entry = {Frame=nf, ScreenGui=sg, TargetY=slotY}
    table.insert(activeNotifs, entry)
    nf.Position = UDim2.new(1, 20, 0, slotY)
    task.spawn(function()
        local inInfo=TweenInfo.new(0.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
        TweenService:Create(nf,inInfo,{Position=UDim2.new(1,-310,0,slotY)}):Play()
        local drainInfo=TweenInfo.new(duration,Enum.EasingStyle.Linear,Enum.EasingDirection.Out)
        TweenService:Create(pf,drainInfo,{Size=UDim2.new(0,0,1,0)}):Play()
        task.wait(duration)
        local outY = entry.TargetY or slotY
        createTween(nf,{Position=UDim2.new(1,20,0,outY),BackgroundTransparency=1},0.3)
        task.wait(0.35)
        if sg.Parent then sg:Destroy() end
        for i,e in ipairs(activeNotifs) do
            if e==entry then table.remove(activeNotifs,i); break end
        end
        reflowNotifs()
    end)
    return entry
end
function GuiLibrary:CreateSettingsTab(window)
    local tabContent=Instance.new("ScrollingFrame"); tabContent.Name="SettingsContent"
    tabContent.Size=UDim2.new(1,0,1,0); tabContent.BackgroundTransparency=1
    tabContent.BorderSizePixel=0; tabContent.ScrollBarThickness=4
    tabContent.ScrollBarImageColor3=COLORS.ACCENT; tabContent.Visible=false
    tabContent.Parent=window.TabContentContainer
    local cl=Instance.new("UIListLayout"); cl.SortOrder=Enum.SortOrder.LayoutOrder; cl.Padding=UDim.new(0,5); cl.Parent=tabContent
    local cp=Instance.new("UIPadding"); cp.PaddingTop=UDim.new(0,12); cp.PaddingLeft=UDim.new(0,12); cp.PaddingRight=UDim.new(0,12); cp.PaddingBottom=UDim.new(0,12); cp.Parent=tabContent
    local function updateSettingsCanvas()
        local extraH = cp.PaddingTop.Offset + cp.PaddingBottom.Offset
        tabContent.CanvasSize = UDim2.new(0, 0, 0, cl.AbsoluteContentSize.Y + extraH)
    end
    cl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSettingsCanvas)
    tabContent:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateSettingsCanvas)
    updateSettingsCanvas()
    local settingsTab={Button=nil,Content=tabContent,Name="Settings",Elements={},Order=999}
    window.Tabs["Settings"]=settingsTab
    GuiLibrary:CreateSection(settingsTab,"Library by cyber_modz")
    GuiLibrary:CreateKeybind(settingsTab,"Toggle GUI",Enum.KeyCode.Insert,function() window.Toggle() end)
    GuiLibrary:CreateDropdown(settingsTab,"Theme",{"Dark","Light","Midnight","Forest","Ocean"},function(t)
        if not themes[t] then return end
        for k,c in pairs(themes[t]) do COLORS[k]=c end; updateElementColors(window)
        if not isInitializing then saveConfig(nil,false) end
    end)
    GuiLibrary:CreateSection(settingsTab,"Preferences")
    GuiLibrary:CreateToggle(settingsTab,"Enable Animations",true,function(state)
        ANIM_TIME=state and 0.25 or 0.01
        if not isInitializing then saveConfig(nil,false) end
    end)
    GuiLibrary:CreateToggle(settingsTab,"Show FPS",false,function(state)
        if window.FPSLabel then window.FPSLabel.Visible=state end
        if not isInitializing then saveConfig(nil,false) end
    end)
    GuiLibrary:CreateToggle(settingsTab,"Notifications",true,function(state)
        GuiLibrary.NotificationsEnabled=state
        if not isInitializing then saveConfig(nil,false) end
    end)
    GuiLibrary:CreateToggle(settingsTab,"Lock Window Position",false,function(state)
        window.LockPosition=state
        if not isInitializing then saveConfig(nil,false) end
    end)
    GuiLibrary:CreateSlider(settingsTab,"Notification Duration",1,10,3,function(v)
        GuiLibrary.NotificationDuration=v
    end)
    GuiLibrary:CreateSection(settingsTab,"Window")
    GuiLibrary:CreateButton(settingsTab,"Center Window",function()
        local vp=workspace.CurrentCamera.ViewportSize
        local sz=window.CurrentSize
        local cx=math.max((vp.X-sz.X.Offset)/2,0); local cy=math.max((vp.Y-sz.Y.Offset)/2,0)
        createTween(window.MainFrame,{Position=UDim2.new(0,cx,0,cy)},0.3)
        if not isInitializing then saveConfig(nil,false) end
    end)
    GuiLibrary:CreateButton(settingsTab,"Reset Window Size",function()
        local def=UDim2.new(0,600,0,400)
        window.CurrentSize=def
        createTween(window.MainFrame,{Size=def},0.3)
        if not isInitializing then saveConfig(nil,false) end
    end)
    GuiLibrary:CreateSection(settingsTab,"Profiles")
    local profileNameInput
    local profileDropdown
    profileNameInput = GuiLibrary:CreateInput(settingsTab,
        "Profile name (e.g. rage, legit, exploration)...", function(text) end)
    profileDropdown = GuiLibrary:CreateDropdown(settingsTab, "Active Profile",
        listProfiles(),
        function(name)
            if not name or name == activeProfile or name == "(no profiles)" then return end
            activeProfile = name
            writeActivePointer(name)
            if not isInitializing then
                pcall(function() GuiLibrary.LoadConfig(window) end)
                GuiLibrary:CreateNotification("Profile",
                    "Switched to '" .. name .. "'.", 2, "info")
            end
        end)
    pcall(function() profileDropdown.SetValue(activeProfile) end)
    GuiLibrary:CreateButton(settingsTab,"New Profile (from input)",function()
        local rawName = profileNameInput.GetValue()
        if not rawName or tostring(rawName):match("^%s*$") then
            GuiLibrary:CreateNotification("Profile","Enter a name first.",2,"warning"); return
        end
        local name = sanitizeProfileName(rawName)
        if isfile and pcall(function() return isfile(getProfilePath(name)) end) and isfile(getProfilePath(name)) then
            GuiLibrary:CreateNotification("Profile","Profile '"..name.."' already exists.",2,"warning"); return
        end
        ensureProfileFolders()
        local previous = activeProfile
        activeProfile = name
        writeActivePointer(name)
        saveConfig(nil, true)
        profileDropdown.UpdateOptions(listProfiles(), false)
        profileDropdown.SetValue(name)
        GuiLibrary:CreateNotification("Profile",
            "Created '" .. name .. "' from current state.", 2, "success")
    end)
    GuiLibrary:CreateButton(settingsTab,"Rename Active Profile",function()
        local rawName = profileNameInput.GetValue()
        if not rawName or tostring(rawName):match("^%s*$") then
            GuiLibrary:CreateNotification("Profile","Enter a new name first.",2,"warning"); return
        end
        local newName = sanitizeProfileName(rawName)
        if newName == activeProfile then
            GuiLibrary:CreateNotification("Profile","New name matches the current one.",2,"warning"); return
        end
        local oldPath = getProfilePath(activeProfile)
        local newPath = getProfilePath(newName)
        local ok = pcall(function()
            local raw = readfile(oldPath)
            writefile(newPath, raw)
            delfile(oldPath)
        end)
        if not ok then
            GuiLibrary:CreateNotification("Profile","Rename failed.",2,"error"); return
        end
        activeProfile = newName
        writeActivePointer(newName)
        profileDropdown.UpdateOptions(listProfiles(), false)
        profileDropdown.SetValue(newName)
        GuiLibrary:CreateNotification("Profile",
            "Renamed to '" .. newName .. "'.", 2, "success")
    end)
    GuiLibrary:CreateButton(settingsTab,"Delete Active Profile",function()
        local toDelete = activeProfile
        local existing = listProfiles()
        if #existing <= 1 then
            GuiLibrary:CreateNotification("Profile",
                "Can't delete the only profile.", 2, "warning"); return
        end
        GuiLibrary:CreateModal("Delete profile?",
            "Permanently delete profile '" .. toDelete .. "'? This cannot be undone.",
            {
                {text="Cancel", style="ghost"},
                {text="Delete", style="danger", callback=function()
                    pcall(function() delfile(getProfilePath(toDelete)) end)
                    local remaining = listProfiles()
                    local newActive = remaining[1] or "default"
                    activeProfile = newActive
                    writeActivePointer(newActive)
                    profileDropdown.UpdateOptions(listProfiles(), false)
                    profileDropdown.SetValue(newActive)
                    pcall(function() GuiLibrary.LoadConfig(window) end)
                    GuiLibrary:CreateNotification("Profile",
                        "Deleted '" .. toDelete .. "'. Active: '" .. newActive .. "'.", 3, "info")
                end},
            })
    end)
    GuiLibrary:CreateButton(settingsTab,"Save Now",function()
        saveConfig(nil,true)
        GuiLibrary:CreateNotification("Profile",
            "Saved '" .. activeProfile .. "'.", 2, "success")
    end)
    GuiLibrary:CreateButton(settingsTab,"Reset Active Profile",function()
        GuiLibrary:CreateModal("Reset profile?",
            "Reset '" .. activeProfile .. "' to defaults (Dark theme, default size/position, all widgets back to their built-in defaults)? This cannot be undone.",
            {
                {text="Cancel", style="ghost"},
                {text="Reset",  style="danger", callback=function()
                    for k,c in pairs(themes["Dark"]) do COLORS[k]=c end
                    window.MainFrame.Size=UDim2.new(0,600,0,400)
                    window.CurrentSize=UDim2.new(0,600,0,400)
                    ANIM_TIME=0.25
                    updateElementColors(window)
                    pcall(function() delfile(getProfilePath(activeProfile)) end)
                    saveConfig(nil, true)
                    GuiLibrary:CreateNotification("Profile",
                        "Reset '" .. activeProfile .. "' to defaults.", 2, "info")
                end},
            })
    end)
end
-- Preview-only mannequin. No player, avatar service, remote, or game module is
-- needed; custom providers can replace it with a cloned model later.
local function createPreviewDummy()
    local model=Instance.new("Model"); model.Name="PreviewDummy"
    local function part(name,size,position,color)
        local p=Instance.new("Part"); p.Name=name; p.Size=size
        p.CFrame=CFrame.new(position); p.Color=color; p.Material=Enum.Material.SmoothPlastic
        p.Anchored=true; p.CanCollide=false; p.TopSurface=Enum.SurfaceType.Smooth
        p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=model
        return p
    end
    local dark=Color3.fromRGB(65,72,85); local grey=Color3.fromRGB(120,130,145)
    part("Torso",Vector3.new(2,2,1),Vector3.new(0,3,0),dark)
    part("Head",Vector3.new(1.25,1.25,1.15),Vector3.new(0,4.65,0),grey)
    part("Left Arm",Vector3.new(0.8,2,0.9),Vector3.new(-1.45,3,0),grey)
    part("Right Arm",Vector3.new(0.8,2,0.9),Vector3.new(1.45,3,0),grey)
    part("Left Leg",Vector3.new(0.9,2,0.95),Vector3.new(-0.55,1,0),dark)
    part("Right Leg",Vector3.new(0.9,2,0.95),Vector3.new(0.55,1,0),dark)
    part("Visor",Vector3.new(1.05,0.28,0.1),Vector3.new(0,4.8,-0.61),Color3.fromRGB(85,130,195))
    return model
end

function GuiLibrary:CreateESPPreview(window, options)
    assert(type(window)=="table" and window.MainFrame and window.ScreenGui,
        "CreateESPPreview requires a library window")
    options=type(options)=="table" and options or {}
    if window.ESPPreview and not window.ESPPreview.IsDestroyed() then
        local preview=window.ESPPreview
        preview.SetOptions(options)
        if options.Model then
            local ok,err=preview.SetModel(options.Model)
            if not ok then warn("[GuiLibrary] Preview model failed: "..tostring(err)) end
        end
        if options.SkeletonMap then preview.SetSkeleton(options.SkeletonMap) end
        if options.Provider then
            local ok,err=preview.SetProvider(options.Provider)
            if not ok then warn("[GuiLibrary] Preview provider failed: "..tostring(err)) end
        end
        preview.SetEnabled(true)
        return preview
    end
    local main=window.MainFrame
    local screen=window.ScreenGui
    local connections={}
    local destroyed=false
    local requestId=0
    local model=nil
    local provider=nil
    local skeleton=nil
    local lines={}
    local api={}
    local settings={
        Enabled=true, Width=280, Gap=16, Side="Auto", Rotation=0,
        Box=true, BoxColor=Color3.fromRGB(160,160,175),
        Skeleton=true, SkeletonColor=Color3.fromRGB(230,230,245), SkeletonThickness=2,
        HealthBar=true, Health=100, MaxHealth=100, HealthColor=Color3.fromRGB(0,255,60),
        Distance="5m", Name="Preview character", Weapon="Weapon", WeaponIcon="",
        Tint=true, TintColor=COLORS.ACCENT, TintTransparency=0.55,
    }
    local function finite(value,fallback,lo,hi)
        local n=tonumber(value)
        if not n or n~=n or math.abs(n)==math.huge then return fallback end
        return math.clamp(n,lo,hi)
    end
    local function make(class,parent,props)
        local object=Instance.new(class)
        for key,value in pairs(props) do object[key]=value end
        object.Parent=parent
        return object
    end
    local panel=make("Frame",screen,{
        Name="ESPPreview",Size=UDim2.fromOffset(280,430),BackgroundColor3=COLORS.SECONDARY,
        BorderSizePixel=0,ClipsDescendants=true,Visible=false,
    })
    createCorner(panel,10); local border=createStroke(panel,1,COLORS.BORDER)
    local header=make("TextLabel",panel,{
        Name="Header",Size=UDim2.new(1,0,0,40),BackgroundColor3=COLORS.PRIMARY,
        BorderSizePixel=0,Text="ESP Preview",Font=Enum.Font.GothamBold,TextSize=15,TextColor3=COLORS.TEXT,
    })
    local healthBack=make("Frame",panel,{
        Name="HealthBar",Position=UDim2.fromOffset(18,55),Size=UDim2.new(1,-55,0,9),
        BackgroundColor3=COLORS.BORDER,BorderSizePixel=0,
    })
    createCorner(healthBack,3)
    local healthFill=make("Frame",healthBack,{
        Name="Fill",Size=UDim2.fromScale(1,1),BackgroundColor3=settings.HealthColor,BorderSizePixel=0,
    })
    createCorner(healthFill,3)
    local distance=make("TextLabel",panel,{
        Name="Distance",Position=UDim2.new(1,-35,0,49),Size=UDim2.fromOffset(32,20),
        BackgroundTransparency=1,Text=settings.Distance,TextColor3=COLORS.TEXT,
        TextSize=11,Font=Enum.Font.Gotham,TextTruncate=Enum.TextTruncate.AtEnd,
    })
    local viewport=make("ViewportFrame",panel,{
        Name="CharacterViewport",Position=UDim2.fromOffset(16,76),Size=UDim2.new(1,-32,1,-130),
        BackgroundColor3=Color3.fromRGB(18,17,25),BorderSizePixel=0,
        Ambient=Color3.fromRGB(180,180,195),LightColor=Color3.new(1,1,1),LightDirection=Vector3.new(-1,-1,-1),
    })
    local world=Instance.new("WorldModel"); world.Name="PreviewWorld"; world.Parent=viewport
    local camera=Instance.new("Camera"); camera.FieldOfView=35
    camera.Parent=viewport; viewport.CurrentCamera=camera
    local overlay=make("Frame",panel,{
        Name="Overlay",Position=viewport.Position,Size=viewport.Size,
        BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,ZIndex=2,
    })
    local tint=make("Frame",overlay,{
        Name="Tint",Size=UDim2.fromScale(1,1),BackgroundColor3=settings.TintColor,
        BackgroundTransparency=settings.TintTransparency,BorderSizePixel=0,ZIndex=2,
    })
    local fade=Instance.new("UIGradient"); fade.Rotation=90
    fade.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)})
    fade.Parent=tint
    local box=make("Frame",overlay,{
        Name="Box",BackgroundTransparency=1,BorderSizePixel=0,ZIndex=3,Visible=false,
    })
    local boxStroke=createStroke(box,1.5,settings.BoxColor)
    local nameLabel=make("TextLabel",panel,{
        Name="CharacterName",Position=UDim2.new(0,8,1,-48),Size=UDim2.new(1,-16,0,18),
        BackgroundTransparency=1,Text=settings.Name,TextColor3=COLORS.TEXT_MUTED,
        Font=Enum.Font.Gotham,TextSize=10,TextTruncate=Enum.TextTruncate.AtEnd,
    })
    local weapon=make("TextLabel",panel,{
        Name="Weapon",Position=UDim2.new(0,8,1,-28),Size=UDim2.new(1,-16,0,20),
        BackgroundTransparency=1,Text=settings.Weapon,TextColor3=COLORS.TEXT,
        Font=Enum.Font.GothamBold,TextSize=12,TextTruncate=Enum.TextTruncate.AtEnd,
    })
    local weaponIcon=make("ImageLabel",panel,{
        Name="WeaponIcon",Position=UDim2.new(0.5,-40,1,-28),Size=UDim2.fromOffset(80,20),
        BackgroundTransparency=1,Image="",ScaleType=Enum.ScaleType.Fit,Visible=false,
    })
    local function connect(signal,callback)
        local connection=signal:Connect(callback)
        table.insert(connections,connection)
    end
    local function clearLines()
        for _,entry in ipairs(lines) do entry.Frame:Destroy() end
        table.clear(lines)
    end
    local function rebuildSkeleton()
        clearLines()
        if not model then return end
        local pairsList={}
        if skeleton then
            for _,edge in ipairs(skeleton) do
                local a=model:FindFirstChild(edge[1],true)
                local b=model:FindFirstChild(edge[2],true)
                if a and b then table.insert(pairsList,{a,b}) end
            end
        else
            for _,joint in ipairs(model:GetDescendants()) do
                if joint:IsA("Motor6D") and joint.Part0 and joint.Part1
                    and joint.Part0:IsDescendantOf(model) and joint.Part1:IsDescendantOf(model) then
                    table.insert(pairsList,{joint.Part0,joint.Part1})
                end
            end
            if #pairsList==0 then
                for _,names in ipairs({{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
                    {"Torso","Left Leg"},{"Torso","Right Leg"}}) do
                    local a=model:FindFirstChild(names[1],true); local b=model:FindFirstChild(names[2],true)
                    if a and b then table.insert(pairsList,{a,b}) end
                end
            end
        end
        for i,edge in ipairs(pairsList) do
            if i>128 then break end
            local line=make("Frame",overlay,{
                Name="SkeletonLine",AnchorPoint=Vector2.new(0.5,0.5),BorderSizePixel=0,
                BackgroundColor3=settings.SkeletonColor,ZIndex=4,Visible=false,
            })
            table.insert(lines,{Frame=line,A=edge[1],B=edge[2]})
        end
    end
    local function point(instance)
        if instance:IsA("BasePart") then return instance.Position end
        if instance:IsA("Bone") then return instance.TransformedWorldCFrame.Position end
        if instance:IsA("Attachment") then return instance.WorldPosition end
        return nil
    end
    -- Project using the ViewportFrame dimensions, not the game's camera viewport.
    local function project(position)
        local p=camera.CFrame:PointToObjectSpace(position)
        if p.Z>=-0.001 then return nil end
        local size=viewport.AbsoluteSize
        local focal=size.Y/(2*math.tan(math.rad(camera.FieldOfView/2)))
        return Vector2.new(size.X/2+p.X*focal/-p.Z,size.Y/2-p.Y*focal/-p.Z)
    end
    local function render()
        if destroyed or not model or viewport.AbsoluteSize.Y<2 then return end
        local cf,size=model:GetBoundingBox()
        local aspect=math.max(viewport.AbsoluteSize.X/viewport.AbsoluteSize.Y,0.1)
        local halfAngle=math.tan(math.rad(camera.FieldOfView/2))
        local dist=math.max(size.Y/(2*halfAngle),size.X/(2*halfAngle*aspect))*1.15+size.Z/2
        camera.CFrame=CFrame.lookAt(cf.Position+Vector3.new(0,0,-dist),cf.Position)
        local low=Vector2.new(math.huge,math.huge); local high=Vector2.new(-math.huge,-math.huge)
        for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do
            local p=project(cf:PointToWorldSpace(Vector3.new(x*size.X/2,y*size.Y/2,z*size.Z/2)))
            if p then
                low=Vector2.new(math.min(low.X,p.X),math.min(low.Y,p.Y))
                high=Vector2.new(math.max(high.X,p.X),math.max(high.Y,p.Y))
            end
        end end end
        box.Visible=settings.Box and high.X>low.X
        if box.Visible then box.Position=UDim2.fromOffset(low.X,low.Y); box.Size=UDim2.fromOffset(high.X-low.X,high.Y-low.Y) end
        for _,entry in ipairs(lines) do
            local a=point(entry.A); local b=point(entry.B)
            local pa=a and project(a); local pb=b and project(b)
            entry.Frame.Visible=settings.Skeleton and pa~=nil and pb~=nil
            if pa and pb then
                local delta=pb-pa; local midpoint=(pa+pb)/2
                entry.Frame.Position=UDim2.fromOffset(midpoint.X,midpoint.Y)
                entry.Frame.Size=UDim2.fromOffset(delta.Magnitude,settings.SkeletonThickness)
                entry.Frame.Rotation=math.deg(math.atan2(delta.Y,delta.X))
                entry.Frame.BackgroundColor3=settings.SkeletonColor
            end
        end
    end
    local function layout()
        if destroyed then return end
        local viewSize=screen.AbsoluteSize
        local right=viewSize.X-(main.AbsolutePosition.X+main.AbsoluteSize.X)-settings.Gap-6
        local left=main.AbsolutePosition.X-settings.Gap-6
        local side=settings.Side
        if side=="Auto" then side=(right>=settings.Width or right>=left) and "Right" or "Left" end
        local available=side=="Right" and right or left
        local width=math.min(settings.Width,math.max(0,available))
        panel.Size=UDim2.fromOffset(width,main.AbsoluteSize.Y)
        local dx=side=="Right" and (main.AbsoluteSize.X+settings.Gap) or (-width-settings.Gap)
        panel.Position=UDim2.new(main.Position.X.Scale,main.Position.X.Offset+dx,
            main.Position.Y.Scale,main.Position.Y.Offset)
        panel.Visible=settings.Enabled and main.Visible and main.AbsoluteSize.Y>=180 and width>=120
            and (not window.ContentFrame or window.ContentFrame.Visible)
        panel.BackgroundColor3=COLORS.SECONDARY; header.BackgroundColor3=COLORS.PRIMARY
        header.TextColor3=COLORS.TEXT; border.Color=COLORS.BORDER
        nameLabel.TextColor3=COLORS.TEXT_MUTED; weapon.TextColor3=COLORS.TEXT
        distance.TextColor3=COLORS.TEXT
        render()
    end
    local function cleanup()
        if destroyed then return end
        destroyed=true; requestId=requestId+1
        disconnectConnections(connections)
        model=nil; provider=nil; table.clear(lines)
        if window.ESPPreview==api then window.ESPPreview=nil end
    end
    function api.Destroy()
        if destroyed then return end
        cleanup(); panel:Destroy()
    end
    function api.IsDestroyed() return destroyed end
    function api.SetSkeleton(edges)
        if destroyed then return false,"Preview destroyed" end
        if edges~=nil then
            if type(edges)~="table" then return false,"Skeleton must be a list of name pairs" end
            local copy={}
            for i,edge in ipairs(edges) do
                if i>128 then return false,"Skeleton is limited to 128 edges" end
                if type(edge)~="table" or type(edge[1])~="string" or type(edge[2])~="string" then
                    return false,"Skeleton endpoints must be part, attachment, or bone names"
                end
                table.insert(copy,{edge[1],edge[2]})
            end
            edges=copy
        end
        skeleton=edges; rebuildSkeleton(); render(); return true
    end
    function api.SetModel(source)
        if destroyed then return false,"Preview destroyed" end
        requestId=requestId+1
        if typeof(source)~="Instance" or not source:IsA("Model") then return false,"Expected a Model" end
        local clone=nil
        local ok,err=pcall(function()
            clone=source:Clone()
            assert(clone,"Model is not Archivable; provide a cloneable template")
            local descendants=clone:GetDescendants()
            assert(#descendants<=2000,"Preview models are limited to 2000 descendants")
            local partCount=0
            for _,item in ipairs(descendants) do
                if item:IsA("LuaSourceContainer") or item:IsA("Sound") or item:IsA("ParticleEmitter")
                    or item:IsA("Trail") or item:IsA("Beam") or item:IsA("ClickDetector") or item:IsA("ProximityPrompt") then
                    item:Destroy()
                elseif item:IsA("BasePart") then
                    partCount=partCount+1; item.Anchored=true; item.CanCollide=false
                    item.CanTouch=false; item.CanQuery=false
                end
            end
            assert(partCount>0,"Model has no visible geometry")
            clone:PivotTo(CFrame.Angles(0,math.rad(settings.Rotation),0))
            local _,size=clone:GetBoundingBox()
            assert(size.Magnitude>0 and size.Magnitude<10000,"Invalid or oversized model bounds")
        end)
        if not ok then if clone then clone:Destroy() end; return false,tostring(err) end
        clone.Parent=world
        if model then model:Destroy() end
        model=clone; rebuildSkeleton(); render()
        return true
    end
    function api.RefreshModel()
        if destroyed then return false,"Preview destroyed" end
        if not provider then return false,"No custom model provider set" end
        requestId=requestId+1; local token=requestId
        local callback=type(provider)=="function" and provider or provider.GetModel
        local ok,result=pcall(callback,window)
        if destroyed or token~=requestId then return false,"Superseded provider request" end
        if not ok then return false,tostring(result) end
        local success,err=api.SetModel(result)
        if success then
            local edges=type(provider)=="table" and provider.Skeleton or nil
            return api.SetSkeleton(edges)
        end
        return false,err
    end
    function api.SetProvider(value)
        if destroyed then return false,"Preview destroyed" end
        if type(value)~="function" and not (type(value)=="table" and type(value.GetModel)=="function") then
            return false,"Provider must be a function or a table with GetModel(window)"
        end
        provider=value; return api.RefreshModel()
    end
    function api.SetOptions(values)
        if destroyed or type(values)~="table" then return false end
        for key,value in pairs(values) do
            if settings[key]~=nil and typeof(value)==typeof(settings[key]) then settings[key]=value end
        end
        settings.Width=finite(settings.Width,280,160,600); settings.Gap=finite(settings.Gap,16,0,80)
        settings.Health=finite(settings.Health,100,0,1e9); settings.MaxHealth=finite(settings.MaxHealth,100,1,1e9)
        settings.TintTransparency=finite(settings.TintTransparency,0.55,0,1)
        settings.SkeletonThickness=finite(settings.SkeletonThickness,2,1,8)
        settings.Rotation=finite(settings.Rotation,0,-36000,36000)
        if settings.Side~="Left" and settings.Side~="Right" then settings.Side="Auto" end
        healthBack.Visible=settings.HealthBar
        healthFill.Size=UDim2.fromScale(math.clamp(settings.Health/settings.MaxHealth,0,1),1)
        healthFill.BackgroundColor3=settings.HealthColor
        distance.Text=settings.Distance; nameLabel.Text=settings.Name; weapon.Text=settings.Weapon
        weaponIcon.Image=settings.WeaponIcon; weaponIcon.Visible=settings.WeaponIcon~=""
        weapon.Visible=not weaponIcon.Visible
        tint.Visible=settings.Tint; tint.BackgroundColor3=settings.TintColor
        tint.BackgroundTransparency=settings.TintTransparency; boxStroke.Color=settings.BoxColor
        if model then model:PivotTo(CFrame.Angles(0,math.rad(settings.Rotation),0)) end
        layout(); return true
    end
    function api.SetEnabled(value) return api.SetOptions({Enabled=value==true}) end
    api.SetVisible=api.SetEnabled
    function api.GetEnabled() return not destroyed and settings.Enabled end
    function api.SetHealth(value,maximum) return api.SetOptions({Health=value,MaxHealth=maximum or settings.MaxHealth}) end
    function api.SetDistance(value) return api.SetOptions({Distance=tostring(value or "")}) end
    function api.SetName(value) return api.SetOptions({Name=tostring(value or "")}) end
    function api.SetWeapon(value,icon) return api.SetOptions({Weapon=tostring(value or ""),WeaponIcon=tostring(icon or "")}) end
    function api.SetRotation(value) return api.SetOptions({Rotation=value}) end
    function api.GetModel() return model end -- preview clone only; never the source model
    api.Frame=panel; api.Viewport=viewport; api.WorldModel=world; api.Camera=camera
    window.ESPPreview=api
    connect(panel.Destroying,cleanup)
    connect(main.Destroying,api.Destroy)
    for _,property in ipairs({"AbsolutePosition","AbsoluteSize","Visible"}) do
        connect(main:GetPropertyChangedSignal(property),layout)
    end
    connect(screen:GetPropertyChangedSignal("AbsoluteSize"),layout)
    connect(viewport:GetPropertyChangedSignal("AbsoluteSize"),render)
    if window.ContentFrame then connect(window.ContentFrame:GetPropertyChangedSignal("Visible"),layout) end
    -- Palette changes are rare; observe the main frame instead of polling.
    connect(main:GetPropertyChangedSignal("BackgroundColor3"),layout)
    api.SetOptions(options)
    local dummy=createPreviewDummy()
    local ok,err=api.SetModel(dummy); dummy:Destroy()
    if not ok then warn("[GuiLibrary] Preview dummy failed: "..tostring(err)) end
    if options.Model then
        ok,err=api.SetModel(options.Model)
        if not ok then warn("[GuiLibrary] Preview model failed: "..tostring(err)) end
    end
    if options.SkeletonMap then api.SetSkeleton(options.SkeletonMap) end
    if options.Provider then
        ok,err=api.SetProvider(options.Provider)
        if not ok then warn("[GuiLibrary] Preview provider failed: "..tostring(err)) end
    end
    layout()
    return api
end

function GuiLibrary:CreateWindow(title, size, iconAsset, options)
    if type(options)=="boolean" then options={ESPPreview=options} end
    options=type(options)=="table" and options or {}
    title=tostring(title or "GUI Library")
    if typeof(size)~="UDim2" then size=UDim2.new(0,600,0,400) end
    iconAsset = iconAsset or GuiLibrary.Icon
    local sg=Instance.new("ScreenGui"); sg.Name="GuiLibraryUI"
    sg.ResetOnSpawn=false; sg.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    sg.IgnoreGuiInset=true; sg.DisplayOrder=100
    if not parentToCoreGui(sg) then return nil end
    local loader=createLoader(sg,90)
    local mf=Instance.new("Frame"); mf.Name="MainFrame"
    mf.AnchorPoint=Vector2.new(0,0)
    mf.Size=UDim2.new(0,0,0,0)
    mf.Position=UDim2.new(0.5,0,0.5,0)
    mf.BackgroundColor3=COLORS.PRIMARY; mf.BorderSizePixel=0
    mf.Active=true; mf.Draggable=false
    mf.Visible=false; mf.Parent=sg
    createCorner(mf,12); createStroke(mf,1,COLORS.BORDER)
    local tb=Instance.new("Frame"); tb.Name="TitleBar"
    tb.Size=UDim2.new(1,0,0,46); tb.BackgroundColor3=COLORS.SECONDARY
    tb.BorderSizePixel=0; tb.Parent=mf; createCorner(tb,12)
    local tbFill=Instance.new("Frame"); tbFill.Name="TitleBarFill"
    tbFill.Size=UDim2.new(1,0,0,12); tbFill.Position=UDim2.new(0,0,1,-12)
    tbFill.BackgroundColor3=COLORS.SECONDARY; tbFill.BorderSizePixel=0; tbFill.Parent=tb
    local accent=Instance.new("Frame"); accent.Name="TitleAccent"
    accent.Size=UDim2.new(1,0,0,2); accent.Position=UDim2.new(0,0,1,-2)
    accent.BackgroundColor3=COLORS.ACCENT; accent.BackgroundTransparency=0.35
    accent.BorderSizePixel=0; accent.Parent=tb
    local iconImg=Instance.new("ImageLabel"); iconImg.Name="WindowIcon"
    iconImg.Size=UDim2.new(0,32,0,32); iconImg.Position=UDim2.new(0,10,0.5,-16)
    iconImg.BackgroundTransparency=1; iconImg.Image=""; iconImg.Visible=false
    iconImg.ImageColor3=Color3.new(1,1,1); iconImg.ImageTransparency=0
    iconImg.ScaleType=Enum.ScaleType.Fit; iconImg.ZIndex=5
    iconImg.Parent=tb; createCorner(iconImg,8)
    local titleLbl=Instance.new("TextLabel"); titleLbl.Name="TitleLabel"
    titleLbl.Size=UDim2.new(1,-210,1,0); titleLbl.Position=UDim2.new(0,16,0,0)
    titleLbl.BackgroundTransparency=1; titleLbl.Text=title; titleLbl.TextColor3=COLORS.TEXT
    titleLbl.TextSize=14; titleLbl.Font=Enum.Font.GothamBold
    titleLbl.TextXAlignment=Enum.TextXAlignment.Left; titleLbl.Parent=tb
    local function setIcon(asset)
        if asset==nil or asset==false or asset=="" or asset==0 then
            iconImg.Visible=false; iconImg.Image=""
            titleLbl.Position=UDim2.new(0,16,0,0)
            return
        end
        if type(asset)=="number" then
            asset="rbxthumb://type=Asset&id="..tostring(asset).."&w=420&h=420"
        elseif type(asset)=="string" and not asset:find("://",1,true) then
            local numStr = asset:match("^%d+$")
            if numStr then
                asset="rbxthumb://type=Asset&id="..numStr.."&w=420&h=420"
            else
                asset="rbxassetid://"..asset
            end
        end
        iconImg.Image=asset
        iconImg.ImageTransparency=0
        iconImg.ImageColor3=Color3.new(1,1,1)
        iconImg.Visible=true
        titleLbl.Position=UDim2.new(0,50,0,0)
    end
    if iconAsset then setIcon(iconAsset) end
    local fpsLbl=Instance.new("TextLabel"); fpsLbl.Name="FPSLabel"
    fpsLbl.Size=UDim2.new(0,58,0,26); fpsLbl.Position=UDim2.new(1,-186,0.5,-13)
    fpsLbl.BackgroundColor3=COLORS.HOVER; fpsLbl.TextColor3=COLORS.SUCCESS
    fpsLbl.TextSize=11; fpsLbl.Font=Enum.Font.GothamBold; fpsLbl.Text="FPS 60"
    fpsLbl.Visible=false; fpsLbl.Parent=tb; createCorner(fpsLbl,6)
    local settingsBtn=Instance.new("TextButton"); settingsBtn.Name="SettingsButton"
    settingsBtn.Size=UDim2.new(0,32,0,32); settingsBtn.Position=UDim2.new(1,-116,0.5,-16)
    settingsBtn.BackgroundColor3=COLORS.HOVER; settingsBtn.BackgroundTransparency=0.35
    settingsBtn.Text="⚙"; settingsBtn.TextColor3=COLORS.TEXT_MUTED
    settingsBtn.TextSize=15; settingsBtn.Font=Enum.Font.GothamBold
    settingsBtn.BorderSizePixel=0; settingsBtn.AutoButtonColor=false; settingsBtn.Parent=tb; createCorner(settingsBtn,8)
    local minBtn=Instance.new("TextButton"); minBtn.Name="MinimizeButton"
    minBtn.Size=UDim2.new(0,32,0,32); minBtn.Position=UDim2.new(1,-78,0.5,-16)
    minBtn.BackgroundColor3=COLORS.HOVER; minBtn.BackgroundTransparency=0.35
    minBtn.Text="—"; minBtn.TextColor3=COLORS.TEXT_MUTED
    minBtn.TextSize=15; minBtn.Font=Enum.Font.GothamBold
    minBtn.BorderSizePixel=0; minBtn.AutoButtonColor=false; minBtn.Parent=tb; createCorner(minBtn,8)
    local closeBtn=Instance.new("TextButton"); closeBtn.Name="CloseButton"
    closeBtn.Size=UDim2.new(0,32,0,32); closeBtn.Position=UDim2.new(1,-40,0.5,-16)
    closeBtn.BackgroundColor3=COLORS.DANGER; closeBtn.BackgroundTransparency=0.55
    closeBtn.Text="X"; closeBtn.TextColor3=Color3.new(1,1,1)
    closeBtn.TextSize=13; closeBtn.Font=Enum.Font.GothamBold
    closeBtn.BorderSizePixel=0; closeBtn.AutoButtonColor=false; closeBtn.Parent=tb; createCorner(closeBtn,8)
    local contentFrame=Instance.new("Frame"); contentFrame.Name="ContentFrame"
    contentFrame.Size=UDim2.new(1,0,1,-46); contentFrame.Position=UDim2.new(0,0,0,46)
    contentFrame.BackgroundTransparency=1; contentFrame.Parent=mf
    local tabBar=Instance.new("Frame"); tabBar.Name="TabBar"
    tabBar.Size=UDim2.new(1,0,0,42); tabBar.Position=UDim2.new(0,0,0,0)
    tabBar.BackgroundColor3=COLORS.SECONDARY; tabBar.BorderSizePixel=0
    tabBar.Parent=contentFrame
    local tabBarSep=Instance.new("Frame"); tabBarSep.Name="TabBarSeparator"
    tabBarSep.Size=UDim2.new(1,0,0,1); tabBarSep.Position=UDim2.new(0,0,1,-1)
    tabBarSep.BackgroundColor3=COLORS.BORDER; tabBarSep.BorderSizePixel=0
    tabBarSep.Parent=tabBar
    local tabsCont=Instance.new("ScrollingFrame"); tabsCont.Name="TabsContainer"
    tabsCont.Size=UDim2.new(1,-20,1,-8); tabsCont.Position=UDim2.new(0,10,0,4)
    tabsCont.BackgroundTransparency=1
    tabsCont.BorderSizePixel=0
    tabsCont.ScrollingDirection=Enum.ScrollingDirection.X
    tabsCont.ScrollBarThickness=0
    tabsCont.CanvasSize=UDim2.new(0,0,0,0)
    tabsCont.ClipsDescendants=true
    tabsCont.ScrollingEnabled=true
    tabsCont.Active=true
    tabsCont.Parent=tabBar
    local tabsLayout=Instance.new("UIListLayout"); tabsLayout.FillDirection=Enum.FillDirection.Horizontal
    tabsLayout.SortOrder=Enum.SortOrder.LayoutOrder; tabsLayout.Padding=UDim.new(0,6)
    tabsLayout.VerticalAlignment=Enum.VerticalAlignment.Center; tabsLayout.Parent=tabsCont
    tabsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabsCont.CanvasSize = UDim2.new(0, tabsLayout.AbsoluteContentSize.X, 0, 0)
    end)
    local tabContent=Instance.new("Frame"); tabContent.Name="TabContentContainer"
    tabContent.Size=UDim2.new(1,-20,1,-50); tabContent.Position=UDim2.new(0,10,0,46)
    tabContent.BackgroundTransparency=1; tabContent.ClipsDescendants=true; tabContent.Parent=contentFrame
    local resizeHandle=Instance.new("Frame"); resizeHandle.Name="ResizeHandle"
    resizeHandle.Size=UDim2.new(0,20,0,20); resizeHandle.Position=UDim2.new(1,-22,1,-22)
    resizeHandle.BackgroundTransparency=1; resizeHandle.ZIndex=20; resizeHandle.Parent=mf
    local gripPos={{12,4},{8,8},{12,8},{4,12},{8,12},{12,12}}
    for _,gp in ipairs(gripPos) do
        local d=Instance.new("Frame"); d.Size=UDim2.new(0,3,0,3); d.Position=UDim2.new(0,gp[1],0,gp[2])
        d.BackgroundColor3=COLORS.BORDER; d.BorderSizePixel=0; d.ZIndex=21; d.Parent=resizeHandle; createCorner(d,1.5)
    end
    local resizeBtn=Instance.new("TextButton"); resizeBtn.Name="ResizeButton"
    resizeBtn.Size=UDim2.new(1,0,1,0); resizeBtn.BackgroundTransparency=1; resizeBtn.Text=""
    resizeBtn.BorderSizePixel=0; resizeBtn.ZIndex=22; resizeBtn.AutoButtonColor=false; resizeBtn.Parent=resizeHandle
    local window={
        ScreenGui=sg, MainFrame=mf, ContentFrame=contentFrame,
        TabsContainer=tabsCont, TabContentContainer=tabContent,
        Tabs={}, CurrentTab=nil, CurrentSize=size, FPSLabel=fpsLbl,
        LockPosition=false, SavedPosition=nil, ESPPreview=nil,
    }
    GuiLibrary.CurrentWindow=window
    local isVisible=true
    local minimized=false
    local fpsConn=RunService.RenderStepped:Connect(function(dt)
        if fpsLbl.Visible then fpsLbl.Text="FPS "..math.round(1/dt) end
    end); table.insert(activeInputConnections,fpsConn)
    tb.Active=true; mf.Active=true
    local dragActive=false; local dragStart=Vector2.new(); local dragOrigPos=Vector2.new()
    local dragInput=nil
    -- Keep the window on-screen so its title bar can never be dragged out of
    -- reach. The old code had no clamp, so the bar could slide past the top
    -- edge and the window got "stuck" in a corner with nothing left to grab.
    -- Works in Position.Offset space, converting through the ScreenGui's
    -- constant inset delta so it is correct regardless of GuiInset.
    local function clampOffset(offX, offY, w, h)
        local cam=workspace.CurrentCamera
        local vp=(cam and cam.ViewportSize) or sg.AbsoluteSize
        w = w or mf.AbsoluteSize.X; h = h or mf.AbsoluteSize.Y
        local m=6
        local cx=mf.Position.X.Offset - mf.AbsolutePosition.X
        local cy=mf.Position.Y.Offset - mf.AbsolutePosition.Y
        local sx=math.clamp(offX-cx, m, math.max(m, vp.X - w - m))
        local sy=math.clamp(offY-cy, m, math.max(m, vp.Y - h - m))
        return sx+cx, sy+cy
    end
    window.ClampOffset=clampOffset
    -- Drag from anywhere on the window, not only the title bar, EXCEPT when the
    -- press lands on a real control (button / textbox / slider / colour widget)
    -- so nothing that used to be clickable starts dragging the window instead.
    local dragMoved=false
    local NODRAG_CLASS={TextButton=true, ImageButton=true, TextBox=true}
    local NODRAG_WIDGET={Slider=true, ColorPicker=true, ColorGradient=true}
    local function shown(d)
        local p=d
        while p and p~=mf do
            if p:IsA("GuiObject") and not p.Visible then return false end
            p=p.Parent
        end
        return p==mf
    end
    -- true if d sits anywhere inside a drag-based widget (slider / colour picker
    -- / gradient), including their pop-out panels that extend past the row.
    local function inNoDragWidget(d)
        local p=d
        while p and p~=mf do
            if NODRAG_WIDGET[p:GetAttribute("WidgetType")] then return true end
            p=p.Parent
        end
        return false
    end
    local function pointOverControl(px, py)
        for _,d in ipairs(mf:GetDescendants()) do
            if d:IsA("GuiObject") and d.Visible then
                local ap,as=d.AbsolutePosition, d.AbsoluteSize
                if as.X>0 and as.Y>0 and px>=ap.X and px<=ap.X+as.X and py>=ap.Y and py<=ap.Y+as.Y and shown(d) then
                    if NODRAG_CLASS[d.ClassName] or inNoDragWidget(d) then return true end
                end
            end
        end
        return false
    end
    -- Begin a drag from a global input hook rather than a frame event, so it
    -- works no matter which inner frame "sinks" the press (title bar, content
    -- container, scroll frame): we simply test the press is inside the window
    -- and not on a control.
    local beginConn=UserInputService.InputBegan:Connect(function(inp)
        if inp.UserInputType~=Enum.UserInputType.MouseButton1 and inp.UserInputType~=Enum.UserInputType.Touch then return end
        if not mf.Visible or window.LockPosition or dragActive then return end
        local px,py=inp.Position.X, inp.Position.Y
        local ap,as=mf.AbsolutePosition, mf.AbsoluteSize
        if px<ap.X or px>ap.X+as.X or py<ap.Y or py>ap.Y+as.Y then return end
        if pointOverControl(px,py) then return end
        dragActive=true; dragMoved=false
        dragInput=inp
        dragStart=Vector2.new(px, py)
        dragOrigPos=Vector2.new(mf.Position.X.Offset, mf.Position.Y.Offset)
    end); table.insert(activeInputConnections,beginConn)
    local dragEndConn=UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            if dragActive then
                dragActive=false
                if dragMoved then
                    window.LastOffset=Vector2.new(mf.Position.X.Offset, mf.Position.Y.Offset)
                    if not isInitializing then saveConfig(nil,false) end
                end
            end
        end
    end); table.insert(activeInputConnections,dragEndConn)
    -- Follow any mouse movement while dragging (not just the exact input object),
    -- so a fast drag that leaves the window doesn't stall; touch tracks its own
    -- finger. Every move is clamped back on-screen.
    local dragMoveConn=UserInputService.InputChanged:Connect(function(inp)
        if not dragActive then return end
        if inp.UserInputType==Enum.UserInputType.MouseMovement or inp==dragInput then
            dragMoved=true
            local x=dragOrigPos.X + (inp.Position.X - dragStart.X)
            local y=dragOrigPos.Y + (inp.Position.Y - dragStart.Y)
            x,y=clampOffset(x,y)
            mf.Position=UDim2.new(0, x, 0, y)
        end
    end); table.insert(activeInputConnections,dragMoveConn)
    local vpConn=workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if mf.Visible and not dragActive then
            local nx,ny=clampOffset(mf.Position.X.Offset, mf.Position.Y.Offset)
            mf.Position=UDim2.new(0,nx,0,ny)
        end
    end); table.insert(activeInputConnections,vpConn)
    local resizing=false; local resStart=Vector3.new(); local resStartSz=Vector2.new()
    local resInput=nil
    local minW,minH=380,280
    resizeBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            resizing=true; resStart=inp.Position
            resStartSz=Vector2.new(mf.AbsoluteSize.X,mf.AbsoluteSize.Y)
        end
    end)
    resizeBtn.InputChanged:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch then
            resInput=inp
        end
    end)
    resizeBtn.MouseEnter:Connect(function() for _,d in ipairs(resizeHandle:GetChildren()) do if d:IsA("Frame") then createTween(d,{BackgroundColor3=COLORS.ACCENT}) end end end)
    resizeBtn.MouseLeave:Connect(function() for _,d in ipairs(resizeHandle:GetChildren()) do if d:IsA("Frame") then createTween(d,{BackgroundColor3=COLORS.BORDER}) end end end)
    local resEndConn=UserInputService.InputEnded:Connect(function(inp)
        if (inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch) and resizing then
            resizing=false; window.CurrentSize=mf.Size; saveConfig(nil,false)
        end
    end); table.insert(activeInputConnections,resEndConn)
    local resMoveConn=UserInputService.InputChanged:Connect(function(inp)
        if resizing and inp==resInput then
            local d=inp.Position-resStart
            local nw=math.max(resStartSz.X+d.X,minW); local nh=math.max(resStartSz.Y+d.Y,minH)
            mf.Size=UDim2.new(0,nw,0,nh); window.CurrentSize=mf.Size
            -- keep the grown window from spilling off-screen
            local nx,ny=clampOffset(mf.Position.X.Offset, mf.Position.Y.Offset, nw, nh)
            mf.Position=UDim2.new(0,nx,0,ny)
            window.LastOffset=Vector2.new(nx,ny)
        end
    end); table.insert(activeInputConnections,resMoveConn)
    local function hideWindow()
        if not isVisible then return end; isVisible=false
        window.CurrentSize=mf.Size
        window.LastOffset=Vector2.new(mf.Position.X.Offset, mf.Position.Y.Offset)
        local curAbsPos=mf.AbsolutePosition; local curAbsSz=mf.AbsoluteSize
        createTween(mf,{
            Size=UDim2.new(0,0,0,0),
            Position=UDim2.new(0,curAbsPos.X+curAbsSz.X/2,0,curAbsPos.Y+curAbsSz.Y/2),
            BackgroundTransparency=1
        },ANIM_TIME)
        task.wait(ANIM_TIME+0.05); mf.Visible=false
    end
    local function showWindow()
        if isVisible then return end; isVisible=true
        mf.Visible=true
        local sz=window.CurrentSize
        -- Reopen where the user last left it, not re-centred every time.
        local ox, oy
        if window.LastOffset then
            ox, oy = window.LastOffset.X, window.LastOffset.Y
        else
            local vp=workspace.CurrentCamera.ViewportSize
            ox=math.max((vp.X-sz.X.Offset)/2,0); oy=math.max((vp.Y-sz.Y.Offset)/2,0)
        end
        ox, oy = clampOffset(ox, oy, sz.X.Offset, sz.Y.Offset)
        mf.Size=UDim2.new(0,0,0,0); mf.Position=UDim2.new(0,ox+sz.X.Offset/2,0,oy+sz.Y.Offset/2)
        mf.BackgroundTransparency=1
        local backInfo=TweenInfo.new(ANIM_TIME+0.08,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
        TweenService:Create(mf,backInfo,{Size=sz,Position=UDim2.new(0,ox,0,oy),BackgroundTransparency=0}):Play()
    end
    local function switchToTab(targetName)
        if window.CurrentTab==targetName then return end
        for _,closer in pairs(dropdownClosers) do pcall(closer) end
        local target=window.Tabs[targetName]; if not target then return end
        local prev=window.CurrentTab and window.Tabs[window.CurrentTab] or nil
        local goingRight=true
        if prev and prev.Order and target.Order then goingRight = target.Order > prev.Order end
        local outX = goingRight and -1 or 1
        local inX  = goingRight and 1 or -1
        if prev and prev.Content then
            if prev.Button then
                createTween(prev.Button,{BackgroundTransparency=1,TextColor3=COLORS.TEXT_MUTED})
                prev.Button.Font=Enum.Font.Gotham
                local ind=prev.Button:FindFirstChild("TabIndicator")
                if ind then createTween(ind,{BackgroundTransparency=1}) end
            end
            local pc=prev.Content
            createTween(pc,{Position=UDim2.new(outX,0,0,0)},ANIM_TIME)
            local nm=prev.Name
            task.delay(ANIM_TIME, function()
                if window.CurrentTab~=nm then pc.Visible=false; pc.Position=UDim2.new(0,0,0,0) end
            end)
        end
        window.CurrentTab=targetName
        if target.Button then
            createTween(target.Button,{BackgroundTransparency=1,TextColor3=COLORS.TEXT})
            target.Button.Font=Enum.Font.GothamBold
            local ind=target.Button:FindFirstChild("TabIndicator")
            if ind then createTween(ind,{BackgroundTransparency=0}) end
        end
        target.Content.Position=UDim2.new(inX,0,0,0)
        target.Content.Visible=true
        createTween(target.Content,{Position=UDim2.new(0,0,0,0)},ANIM_TIME)
    end
    window.SwitchTab=switchToTab
    settingsBtn.MouseButton1Click:Connect(function()
        if window.Tabs["Settings"] then switchToTab("Settings") end
    end)
    settingsBtn.MouseEnter:Connect(function() createTween(settingsBtn,{BackgroundTransparency=0,TextColor3=COLORS.TEXT}) end)
    settingsBtn.MouseLeave:Connect(function() createTween(settingsBtn,{BackgroundTransparency=0.35,TextColor3=COLORS.TEXT_MUTED}) end)
    local destroyed=false
    local function destroyWindow()
        if destroyed then return end
        pcall(function() saveConfig(window,true) end)
        destroyed=true
        disconnectConnections(activeInputConnections)
        if GuiLibrary.CurrentWindow==window then GuiLibrary.CurrentWindow=nil end
        if sg.Parent then sg:Destroy() end
    end
    window.Destroy=destroyWindow
    table.insert(activeInputConnections,sg.Destroying:Connect(function()
        if destroyed then return end
        pcall(function() saveConfig(window,true) end)
        destroyed=true
        disconnectConnections(activeInputConnections)
        if GuiLibrary.CurrentWindow==window then GuiLibrary.CurrentWindow=nil end
    end))
    closeBtn.MouseButton1Click:Connect(destroyWindow)
    closeBtn.MouseEnter:Connect(function() createTween(closeBtn,{BackgroundTransparency=0.1}) end)
    closeBtn.MouseLeave:Connect(function() createTween(closeBtn,{BackgroundTransparency=0.55}) end)
    -- Minimize collapses the window down to just the title bar so it stays
    -- draggable and restorable without needing a keyboard (mobile friendly).
    local function setMinimized(state)
        if minimized==state then return end
        minimized=state
        if state then
            window.PreMinSize=mf.Size
            contentFrame.Visible=false; resizeHandle.Visible=false
            createTween(mf,{Size=UDim2.new(mf.Size.X.Scale,mf.Size.X.Offset,0,46)},ANIM_TIME)
            minBtn.Text="□"
        else
            local sz=window.PreMinSize or window.CurrentSize
            createTween(mf,{Size=sz},ANIM_TIME)
            task.delay(ANIM_TIME*0.5,function()
                if not minimized then contentFrame.Visible=true; resizeHandle.Visible=true end
            end)
            minBtn.Text="—"
        end
    end
    minBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end)
    minBtn.MouseEnter:Connect(function() createTween(minBtn,{BackgroundTransparency=0,TextColor3=COLORS.TEXT}) end)
    minBtn.MouseLeave:Connect(function() createTween(minBtn,{BackgroundTransparency=0.35,TextColor3=COLORS.TEXT_MUTED}) end)
    window.Minimize=function() setMinimized(true) end
    window.Restore=function() setMinimized(false) end
    window.ToggleMinimize=function() setMinimized(not minimized) end
    window.Hide=hideWindow; window.Show=showWindow
    window.Toggle=function() if isVisible then hideWindow() else showWindow() end end
    window.SetIcon=setIcon
    window.SetTitle=function(t) titleLbl.Text=tostring(t or "") end
    window.SetESPPreview=function(enabled,previewOptions)
        if destroyed then return nil end
        if enabled then
            return GuiLibrary:CreateESPPreview(window,previewOptions or {})
        end
        if window.ESPPreview then window.ESPPreview.SetEnabled(false) end
        return window.ESPPreview
    end
    window.GetESPPreview=function() return window.ESPPreview end
    isInitializing=true
    GuiLibrary:CreateSettingsTab(window)
    GuiLibrary.LoadConfig(window)
    isInitializing=false
    task.wait(1.5); if loader.Parent then loader:Destroy() end
    mf.Visible=true
    local sz = window.CurrentSize or size
    local vp = workspace.CurrentCamera.ViewportSize
    -- Clamp the window to the viewport so it never opens larger than a phone screen.
    local maxW=math.max(vp.X-20,minW); local maxH=math.max(vp.Y-20,minH)
    local clampedW=math.clamp(sz.X.Offset,minW,maxW)
    local clampedH=math.clamp(sz.Y.Offset,minH,maxH)
    sz=UDim2.new(0,clampedW,0,clampedH)
    window.CurrentSize=sz
    local targetX, targetY
    if window.SavedPosition then
        targetX = window.SavedPosition.X.Offset
        targetY = window.SavedPosition.Y.Offset
    else
        targetX = math.max((vp.X-sz.X.Offset)/2,0)
        targetY = math.max((vp.Y-sz.Y.Offset)/2,0)
    end
    -- never open off-screen (e.g. a stale saved position from a bigger monitor)
    targetX, targetY = clampOffset(targetX, targetY, sz.X.Offset, sz.Y.Offset)
    window.LastOffset=Vector2.new(targetX, targetY)
    mf.Size=UDim2.new(0,0,0,0)
    mf.Position=UDim2.new(0, targetX+sz.X.Offset/2, 0, targetY+sz.Y.Offset/2)
    local openInfo=TweenInfo.new(0.55,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
    TweenService:Create(mf,openInfo,{Size=sz, Position=UDim2.new(0,targetX,0,targetY)}):Play()
    updateElementColors(window)
    -- Give the caller time to synchronously create its tabs/widgets. Any
    -- constructor-triggered autosaves are coalesced and flushed afterward.
    setupGraceUntil=os.clock()+3
    local previewEnabled=options.ESPPreview
    if previewEnabled==nil then previewEnabled=GuiLibrary.ESPPreviewEnabled end
    if previewEnabled==true then window.SetESPPreview(true,options.PreviewOptions) end
    return window
end
function GuiLibrary:CreateTab(window, name)
    if type(window)~="table" or not window.TabsContainer or not window.TabContentContainer then
        warn("[GuiLibrary] CreateTab: invalid window")
        return nil
    end
    name=tostring(name or "Tab")
    local tabBtn=Instance.new("TextButton"); tabBtn.Name=name.."Tab"
    tabBtn.AutomaticSize=Enum.AutomaticSize.X
    tabBtn.Size=UDim2.new(0,0,0,28)
    tabBtn.BackgroundColor3=COLORS.HOVER; tabBtn.BackgroundTransparency=1
    tabBtn.Text=name; tabBtn.TextColor3=COLORS.TEXT_MUTED; tabBtn.TextSize=12
    tabBtn.Font=Enum.Font.Gotham; tabBtn.BorderSizePixel=0; tabBtn.AutoButtonColor=false
    tabBtn.TextXAlignment=Enum.TextXAlignment.Center
    tabBtn.Parent=window.TabsContainer; createCorner(tabBtn,6)
    local pad=Instance.new("UIPadding"); pad.PaddingLeft=UDim.new(0,14); pad.PaddingRight=UDim.new(0,14)
    pad.Parent=tabBtn
    local tabInd=Instance.new("Frame"); tabInd.Name="TabIndicator"
    tabInd.Size=UDim2.new(1,-8,0,2); tabInd.Position=UDim2.new(0,4,1,-2)
    tabInd.BackgroundColor3=COLORS.ACCENT; tabInd.BackgroundTransparency=1
    tabInd.BorderSizePixel=0; tabInd.ZIndex=3; tabInd.Parent=tabBtn
    createCorner(tabInd,1)
    task.defer(function()
        local tc=window.TabsContainer; if tc then
            local layout=tc:FindFirstChildWhichIsA("UIListLayout")
            if layout then tc.CanvasSize=UDim2.new(0,layout.AbsoluteContentSize.X,0,0) end
        end
    end)
    local tabScroll=Instance.new("ScrollingFrame"); tabScroll.Name=name.."Content"
    tabScroll.Size=UDim2.new(1,0,1,0); tabScroll.BackgroundTransparency=1
    tabScroll.BorderSizePixel=0; tabScroll.ScrollBarThickness=4
    tabScroll.ScrollBarImageColor3=COLORS.ACCENT; tabScroll.Visible=false
    tabScroll.Parent=window.TabContentContainer
    local cl=Instance.new("UIListLayout"); cl.SortOrder=Enum.SortOrder.LayoutOrder; cl.Padding=UDim.new(0,5); cl.Parent=tabScroll
    local cp=Instance.new("UIPadding"); cp.PaddingTop=UDim.new(0,12); cp.PaddingLeft=UDim.new(0,12); cp.PaddingRight=UDim.new(0,12); cp.PaddingBottom=UDim.new(0,12); cp.Parent=tabScroll
    local function updateCanvas()
        local extraH = cp.PaddingTop.Offset + cp.PaddingBottom.Offset
        tabScroll.CanvasSize = UDim2.new(0, 0, 0, cl.AbsoluteContentSize.Y + extraH)
    end
    cl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
    tabScroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateCanvas)
    updateCanvas()
    window.TabCount=(window.TabCount or 0)+1
    local tab={Button=tabBtn,Content=tabScroll,Name=name,Elements={},Order=window.TabCount}
    window.Tabs[name]=tab
    tabBtn.MouseButton1Click:Connect(function()
        if window.SwitchTab then window.SwitchTab(name) end
    end)
    tabBtn.MouseEnter:Connect(function()
        if window.CurrentTab~=name then
            createTween(tabBtn,{BackgroundColor3=COLORS.HOVER,BackgroundTransparency=0.55,TextColor3=COLORS.TEXT})
        end
    end)
    tabBtn.MouseLeave:Connect(function()
        if window.CurrentTab~=name then
            createTween(tabBtn,{BackgroundTransparency=1,TextColor3=COLORS.TEXT_MUTED})
        end
    end)
    if not window.CurrentTab then
        window.CurrentTab=name
        tabBtn.BackgroundTransparency=1
        tabBtn.TextColor3=COLORS.TEXT
        tabBtn.Font=Enum.Font.GothamBold
        local ind=tabBtn:FindFirstChild("TabIndicator"); if ind then ind.BackgroundTransparency=0 end
        tabScroll.Visible=true
    end
    updateElementColors(window)
    return tab
end

-- Idempotent teardown for reloads and callers that remove the whole library.
-- Existing window.Destroy() remains available for single-window cleanup.
function GuiLibrary:Destroy()
    local current=GuiLibrary.CurrentWindow
    if current then pcall(function() saveConfig(current,true) end) end
    disconnectConnections(activeInputConnections)
    disconnectConnections(libraryConnections)
    for gui in pairs(rootGuis) do
        if gui and gui.Parent then pcall(function() gui:Destroy() end) end
        rootGuis[gui]=nil
    end
    table.clear(activeNotifs)
    GuiLibrary.CurrentWindow=nil
end
return GuiLibrary
