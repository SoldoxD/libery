            end
        end)
    end)
    local kbConn=UserInputService.InputBegan:Connect(function(inp,gp)
        if gp or listening then return end
        if tick()-lastTrig<0.2 then return end; lastTrig=tick()
        if curKey and inp.KeyCode==curKey then if callback then callback() end end
    end); table.insert(activeInputConnections,kbConn)

    f:SetAttribute("ElementID",(tab.Name or "Tab").."_"..text:gsub("%s+","_").."_Keybind")
    f:SetAttribute("WidgetType","Keybind"); f:SetAttribute("KeybindValue",curKey and curKey.Name or "None")
    elementSetters[f]=function(v) if setKeybind(v) and not isInitializing then saveConfig(nil,true) end end
    local eid=f:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="Keybind" then
        if setKeybind(restorationQueue[eid].Value) then restorationQueue[eid]=nil end
    end
    table.insert(tab.Elements,f)
    return {Frame=f, GetKey=function() return curKey end, SetKey=setKeybind}
end

