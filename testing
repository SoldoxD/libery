local function createTween(object, properties, time)
    if not object or not object.Parent then return nil end
    time = time or ANIM_TIME
    local tweenInfo = TweenInfo.new(time, EASING_STYLE, EASING_DIRECTION)
    local tween = TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

local function createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
    return corner
end

local function createStroke(parent, thickness, color)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 1
    stroke.Color = color or COLORS.BORDER
    stroke.Parent = parent
    return stroke
end

-- instant=true skips tweens (used during load/restore)
local function updateElementColors(window, instant)
    local function apply(obj, props)
        if not obj then return end
        if instant then
            for k, v in pairs(props) do obj[k] = v end
        else
            createTween(obj, props)
        end
    end

    if window.MainFrame then
        apply(window.MainFrame, {BackgroundColor3 = COLORS.PRIMARY})
        local uiStroke = window.MainFrame:FindFirstChildWhichIsA("UIStroke")
        if uiStroke then apply(uiStroke, {Color = COLORS.BORDER}) end
    end

    local titleBar = window.MainFrame and window.MainFrame:FindFirstChild("TitleBar")
    if titleBar then
        apply(titleBar, {BackgroundColor3 = COLORS.SECONDARY})
        apply(titleBar:FindFirstChild("TitleLabel"),    {TextColor3 = COLORS.TEXT})
        apply(titleBar:FindFirstChild("TitleAccent"),   {BackgroundColor3 = COLORS.ACCENT})
        apply(titleBar:FindFirstChild("FPSLabel"),      {BackgroundColor3 = COLORS.HOVER, TextColor3 = COLORS.SUCCESS})
        apply(titleBar:FindFirstChild("SettingsButton"),{TextColor3 = COLORS.TEXT_MUTED})
        apply(titleBar:FindFirstChild("CloseButton"),   {TextColor3 = COLORS.DANGER})
    end

    for tabName, tab in pairs(window.Tabs or {}) do
        if tab.Button then
            if window.CurrentTab == tabName then
                apply(tab.Button, {BackgroundColor3 = COLORS.ACCENT, TextColor3 = COLORS.TEXT})
            else
                apply(tab.Button, {BackgroundColor3 = COLORS.HOVER, TextColor3 = COLORS.TEXT_MUTED})
            end
        end
        if tab.Content then apply(tab.Content, {ScrollBarImageColor3 = COLORS.ACCENT}) end
        for _, element in ipairs(tab.Elements or {}) do
            if element and element:IsA("GuiObject") then
                if element.Name:match("Button") and not element.Name:match("Tab") then
                    apply(element, {BackgroundColor3 = COLORS.ACCENT, TextColor3 = COLORS.TEXT})

                elseif element.Name:match("Toggle") then
                    apply(element, {BackgroundColor3 = COLORS.HOVER})
                    local tb = element:FindFirstChild("ToggleSwitch")
                    if tb then
                        local ind = tb:FindFirstChild("Indicator")
                        if ind then
                            local isOn = element:GetAttribute("ToggleState") == 1
                            apply(tb,  {BackgroundColor3 = isOn and COLORS.SUCCESS or COLORS.BORDER})
                            apply(ind, {BackgroundColor3 = Color3.new(1,1,1)})
                        end
                    end
                    apply(element:FindFirstChildWhichIsA("TextLabel"), {TextColor3 = COLORS.TEXT})

                elseif element.Name:match("Slider") then
                    apply(element, {BackgroundColor3 = COLORS.HOVER})
                    local track = element:FindFirstChild("SliderTrack")
                    if track then
                        apply(track, {BackgroundColor3 = COLORS.BORDER})
                        local fill = track:FindFirstChild("SliderFill")
                        if fill then apply(fill, {BackgroundColor3 = COLORS.ACCENT}) end
                        local handle = track:FindFirstChild("SliderHandle")
                        if handle then apply(handle, {BackgroundColor3 = Color3.new(1,1,1)}) end
                    end
                    apply(element:FindFirstChild("SliderLabel"), {TextColor3 = COLORS.TEXT})
                    apply(element:FindFirstChild("SliderValue"), {TextColor3 = COLORS.ACCENT})

                elseif element.Name:match("Section") then
                    local bar = element:FindFirstChild("AccentBar")
                    if bar then apply(bar, {BackgroundColor3 = COLORS.ACCENT}) end
                    apply(element:FindFirstChildWhichIsA("TextLabel"), {TextColor3 = COLORS.ACCENT})

                elseif element.Name:match("Label") then
                    apply(element, {TextColor3 = COLORS.TEXT_MUTED})

                elseif element.Name:match("Dropdown") then
                    apply(element, {BackgroundColor3 = COLORS.HOVER})
                    local btn = element:FindFirstChild("DropdownButton")
                    if btn then
                        apply(btn, {BackgroundColor3 = COLORS.PRIMARY, TextColor3 = COLORS.TEXT})
                        apply(btn:FindFirstChild("DropdownArrow"), {TextColor3 = COLORS.TEXT_MUTED})
                    end
                    local list = element:FindFirstChild("DropdownList")
                    if list then
                        apply(list, {BackgroundColor3 = COLORS.PRIMARY, ScrollBarImageColor3 = COLORS.ACCENT})
                        local stroke = list:FindFirstChildWhichIsA("UIStroke")
                        if stroke then apply(stroke, {Color = COLORS.BORDER}) end
                    end

                elseif element.Name:match("Input") then
                    apply(element, {BackgroundColor3 = COLORS.HOVER})
                    local tb = element:FindFirstChildWhichIsA("TextBox")
                    if tb then
                        apply(tb, {BackgroundColor3 = COLORS.PRIMARY, TextColor3 = COLORS.TEXT, PlaceholderColor3 = COLORS.TEXT_MUTED})
                    end

                elseif element.Name:match("Keybind") then
                    apply(element, {BackgroundColor3 = COLORS.HOVER})
                    apply(element:FindFirstChildWhichIsA("TextLabel"), {TextColor3 = COLORS.TEXT})
                    local btn = element:FindFirstChild("KeybindButton")
                    if btn then apply(btn, {BackgroundColor3 = COLORS.PRIMARY, TextColor3 = COLORS.TEXT}) end

                elseif element.Name:match("ColorPicker") then
                    apply(element, {BackgroundColor3 = COLORS.HOVER})
                    apply(element:FindFirstChildWhichIsA("TextLabel"), {TextColor3 = COLORS.TEXT})
                end
            end
        end
    end
end

local function createLoader(parent, size)
    local loaderFrame = Instance.new("Frame")
    loaderFrame.Size = UDim2.new(0, size, 0, size)
    loaderFrame.Position = UDim2.new(0.5, -size/2, 0.5, -size/2)
    loaderFrame.BackgroundTransparency = 1
    loaderFrame.Parent = parent

    local dots = {}
    local numDots = 8
    local radius = size * 0.3
    for i = 1, numDots do
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 8, 0, 8)
        dot.BackgroundColor3 = COLORS.ACCENT
        dot.BorderSizePixel = 0
        dot.Parent = loaderFrame
        createCorner(dot, 4)
        local angle = (i - 1) * (2 * math.pi / numDots)
        dot.Position = UDim2.new(0.5, math.cos(angle) * radius - 4, 0.5, math.sin(angle) * radius - 4)
        dot.BackgroundTransparency = 1 - (i / numDots)
        table.insert(dots, dot)
    end

    task.spawn(function()
        local idx = 1
        while loaderFrame.Parent do
            createTween(dots[idx], {BackgroundTransparency = 0}, 0.1)
            task.wait(0.08)
            createTween(dots[idx], {BackgroundTransparency = 0.85}, 0.4)
            idx = (idx % numDots) + 1
        end
    end)

    return loaderFrame
end

