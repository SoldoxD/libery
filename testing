function GuiLibrary:CreateButton(tab, text, callback)
    local btn=Instance.new("TextButton"); btn.Name=text.."Button"
    btn.Size=UDim2.new(1,0,0,38); btn.BackgroundColor3=COLORS.ACCENT
    btn.Text=text; btn.TextColor3=Color3.new(1,1,1); btn.TextSize=13
    btn.Font=Enum.Font.GothamBold; btn.BorderSizePixel=0; btn.AutoButtonColor=false
    btn.Parent=tab.Content; createCorner(btn,8)
    -- inner highlight
    local hl=Instance.new("Frame"); hl.Size=UDim2.new(1,0,0.5,0)
    hl.BackgroundColor3=Color3.new(1,1,1); hl.BackgroundTransparency=0.92
    hl.BorderSizePixel=0; hl.ZIndex=2; hl.Parent=btn; createCorner(hl,8)

    local function accentLighter()
        return Color3.fromRGB(math.min(math.floor(COLORS.ACCENT.R*255)+20,255),math.min(math.floor(COLORS.ACCENT.G*255)+20,255),math.min(math.floor(COLORS.ACCENT.B*255)+20,255))
    end
    local function accentDarker()
        return Color3.fromRGB(math.max(math.floor(COLORS.ACCENT.R*255)-25,0),math.max(math.floor(COLORS.ACCENT.G*255)-25,0),math.max(math.floor(COLORS.ACCENT.B*255)-25,0))
    end
    btn.MouseButton1Click:Connect(function()
        if callback then
            createTween(btn,{BackgroundColor3=accentDarker()},0.06); task.wait(0.09)
            createTween(btn,{BackgroundColor3=COLORS.ACCENT},0.18); callback()
        end
    end)
    btn.MouseEnter:Connect(function() createTween(btn,{BackgroundColor3=accentLighter()}) end)
    btn.MouseLeave:Connect(function() createTween(btn,{BackgroundColor3=COLORS.ACCENT}) end)
    table.insert(tab.Elements,btn)

    local api
    api = {
        Instance = btn,
        Frame    = btn,
        GetText  = function() return btn.Text end,
        SetText  = function(newText)
            btn.Text = tostring(newText or "")
            return api
        end,
        SetCallback = function(cb) callback = cb; return api end,
        SetVisible  = function(v) btn.Visible = v and true or false; return api end,
    }
    return api
end

function GuiLibrary:CreateToggle(tab, text, default, callback)
    local f=Instance.new("Frame"); f.Name=text.."Toggle"
    f.Size=UDim2.new(1,0,0,40); f.BackgroundColor3=COLORS.HOVER
    f.BorderSizePixel=0; f.Parent=tab.Content; createCorner(f,8); createStroke(f,1,COLORS.BORDER)

    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-70,1,0)
    lbl.Position=UDim2.new(0,14,0,0); lbl.BackgroundTransparency=1; lbl.Text=text
    lbl.TextColor3=COLORS.TEXT; lbl.TextSize=13; lbl.Font=Enum.Font.Gotham
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=f

    local sw=Instance.new("TextButton"); sw.Name="ToggleSwitch"
    sw.Size=UDim2.new(0,44,0,24); sw.Position=UDim2.new(1,-54,0.5,-12)
    sw.BackgroundColor3=default and COLORS.SUCCESS or COLORS.BORDER
    sw.Text=""; sw.BorderSizePixel=0; sw.AutoButtonColor=false; sw.Parent=f; createCorner(sw,12)

    local ind=Instance.new("Frame"); ind.Name="Indicator"
    ind.Size=UDim2.new(0,18,0,18)
    ind.Position=default and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
    ind.BackgroundColor3=Color3.new(1,1,1); ind.BorderSizePixel=0; ind.Parent=sw; createCorner(ind,9)

    local isToggled=default or false
    local eid=(tab.Name or "Tab").."_"..text:gsub("%s+","_").."_Toggle"
    f:SetAttribute("ElementID",eid); f:SetAttribute("WidgetType","Toggle"); f:SetAttribute("ToggleState",isToggled and 1 or 0)

    local function setState(state, instant)
        isToggled = state and true or false
        if instant or isInitializing then
            sw.BackgroundColor3 = isToggled and COLORS.SUCCESS or COLORS.BORDER
            ind.Position = isToggled and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
        else
            createTween(sw,{BackgroundColor3=isToggled and COLORS.SUCCESS or COLORS.BORDER})
            createTween(ind,{Position=isToggled and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)})
        end
        f:SetAttribute("ToggleState", isToggled and 1 or 0)
    end
    sw.MouseButton1Click:Connect(function()
        setState(not isToggled)
        if callback then callback(isToggled) end
        saveConfig(nil,false)
    end)

    elementSetters[f]=function(v)
        setState(v)
