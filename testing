    dropLbl.TextColor3=COLORS.TEXT; dropLbl.TextSize=12; dropLbl.Font=Enum.Font.Gotham
    dropLbl.TextXAlignment=Enum.TextXAlignment.Left; dropLbl.ZIndex=3; dropLbl.Parent=dropBtn

    local dropArrow=Instance.new("TextLabel"); dropArrow.Name="DropdownArrow"
    dropArrow.Size=UDim2.new(0,20,1,0); dropArrow.Position=UDim2.new(1,-22,0,0)
    dropArrow.BackgroundTransparency=1; dropArrow.Text="v"; dropArrow.TextColor3=COLORS.TEXT_MUTED
    dropArrow.TextSize=11; dropArrow.Font=Enum.Font.GothamBold; dropArrow.ZIndex=3; dropArrow.Parent=dropBtn

    -- Floating list lives in mainFrame so it's never clipped by the tab ScrollingFrame
    local dropList=Instance.new("ScrollingFrame"); dropList.Name="DropdownList_"..text
    dropList.Size=UDim2.new(0,0,0,0); dropList.BackgroundColor3=COLORS.PRIMARY
    dropList.Visible=false; dropList.ZIndex=600; dropList.ScrollBarThickness=4
    dropList.ScrollBarImageColor3=COLORS.ACCENT; dropList.BorderSizePixel=0
    dropList.Parent=mf or tab.Content; createCorner(dropList,8); createStroke(dropList,1,COLORS.BORDER)
    dropdownLists[dropFrame]=dropList

    local listLayout=Instance.new("UIListLayout"); listLayout.SortOrder=Enum.SortOrder.LayoutOrder; listLayout.Parent=dropList
    local listPad=Instance.new("UIPadding"); listPad.PaddingTop=UDim.new(0,4); listPad.PaddingBottom=UDim.new(0,4)
    listPad.PaddingLeft=UDim.new(0,4); listPad.PaddingRight=UDim.new(0,4); listPad.Parent=dropList

    local curOpts={table.unpack(options)}; local curSel=curOpts[1] or "None"; local isOpen=false

    local function getListRect()
        -- position & size the floating list relative to mainFrame
        local btnAbs = dropBtn.AbsolutePosition
        local mfAbs  = mf and mf.AbsolutePosition or Vector2.new(0,0)
        local w      = dropBtn.AbsoluteSize.X
        local h      = math.min(#curOpts*28+8, 136)
        local relX   = btnAbs.X - mfAbs.X
        local relY   = btnAbs.Y - mfAbs.Y + dropBtn.AbsoluteSize.Y + 6
        return relX, relY, w, h
    end

    local function closeInstant()
        isOpen=false; dropArrow.Text="v"; dropList.Visible=false
        dropList.Size=UDim2.new(0,dropList.Size.X.Offset,0,0)
        dropArrow.Rotation=0
    end
    dropdownClosers[dropFrame]=closeInstant

    local function buildOptions(opts)
        for _,c in ipairs(dropList:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        dropList.CanvasSize=UDim2.new(0,0,0,#opts*28+8)
        for i,opt in ipairs(opts) do
            local ob=Instance.new("TextButton"); ob.Size=UDim2.new(1,0,0,28)
            ob.BackgroundColor3=COLORS.ACCENT; ob.BackgroundTransparency=1
            ob.Text=""; ob.BorderSizePixel=0; ob.LayoutOrder=i; ob.ZIndex=601; ob.Parent=dropList
            createCorner(ob,5)
            local ol=Instance.new("TextLabel"); ol.Size=UDim2.new(1,-12,1,0); ol.Position=UDim2.new(0,10,0,0)
            ol.BackgroundTransparency=1; ol.Text=opt; ol.TextColor3=COLORS.TEXT_MUTED; ol.TextSize=12
            ol.Font=Enum.Font.Gotham; ol.TextXAlignment=Enum.TextXAlignment.Left; ol.ZIndex=602; ol.Parent=ob
            ob.MouseButton1Click:Connect(function()
                curSel=opt; dropLbl.Text=text..":  "..opt; dropFrame:SetAttribute("DropdownValue",opt)
                closeInstant()
                if callback then callback(opt) end; saveConfig(nil,false)
            end)
            ob.MouseEnter:Connect(function() createTween(ob,{BackgroundTransparency=0.82}); createTween(ol,{TextColor3=COLORS.TEXT}) end)
            ob.MouseLeave:Connect(function() createTween(ob,{BackgroundTransparency=1}); createTween(ol,{TextColor3=COLORS.TEXT_MUTED}) end)
        end
    end
    buildOptions(curOpts)

    dropBtn.MouseButton1Click:Connect(function()
        isOpen=not isOpen
        if isOpen then
            local rx,ry,w,h=getListRect()
            dropList.Position=UDim2.new(0,rx,0,ry)
            dropList.Size=UDim2.new(0,w,0,0)
            dropList.CanvasSize=UDim2.new(0,0,0,#curOpts*28+8)
            dropList.Visible=true
            createTween(dropArrow,{Rotation=180}); createTween(dropList,{Size=UDim2.new(0,w,0,h)})
        else
            createTween(dropArrow,{Rotation=0})
            createTween(dropList,{Size=UDim2.new(0,dropList.Size.X.Offset,0,0)})
            task.wait(ANIM_TIME); dropList.Visible=false; dropArrow.Rotation=0; isOpen=false
        end
    end)

    -- Clean up floating list if dropdown is destroyed
    dropFrame.AncestryChanged:Connect(function()
        if not dropFrame:IsDescendantOf(game) then pcall(function() dropList:Destroy() end) end
    end)

    local function setVal(v)
        if not v then return end
        for _,opt in ipairs(curOpts) do
            if opt==v then curSel=opt; dropLbl.Text=text..":  "..opt; dropFrame:SetAttribute("DropdownValue",opt); if callback then callback(opt) end; return end
        end
    end

    local function updateOptions(newOpts, keep)
        if isOpen then closeInstant() end
        curOpts={table.unpack(newOpts)}; buildOptions(curOpts)
        local valid=false
        if keep then for _,o in ipairs(curOpts) do if o==curSel then valid=true;break end end end
        if valid then
            dropLbl.Text=text..":  "..curSel; dropFrame:SetAttribute("DropdownValue",curSel)
        else
            curSel=curOpts[1] or "None"; dropLbl.Text=text..":  "..curSel
            dropFrame:SetAttribute("DropdownValue",curSel); if callback then callback(curSel) end
        end
    end

    dropFrame:SetAttribute("ElementID",(tab.Name or "Tab").."_"..text:gsub("%s+","_").."_Dropdown")
    dropFrame:SetAttribute("WidgetType","Dropdown"); dropFrame:SetAttribute("DropdownValue",curSel)
    elementSetters[dropFrame]=function(v) setVal(v); if not isInitializing then saveConfig(nil,false) end end
    elementCallbacks[dropFrame]=callback

    dropFrame.AncestryChanged:Connect(function()
        if not dropFrame:IsDescendantOf(game) then
            dropdownLists[dropFrame]=nil
            dropdownClosers[dropFrame]=nil
        end
    end)

    local eid=dropFrame:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type=="Dropdown" then
        setVal(restorationQueue[eid].Value); restorationQueue[eid]=nil
    end

    table.insert(tab.Elements,dropFrame)
    return {Frame=dropFrame, GetValue=function() return curSel end, SetValue=setVal, UpdateOptions=updateOptions}
end

