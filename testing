    box.BackgroundColor3=COLORS.PRIMARY; box.PlaceholderText=placeholder; box.PlaceholderColor3=COLORS.TEXT_MUTED
    box.Text=""; box.TextColor3=COLORS.TEXT; box.TextSize=12; box.Font=Enum.Font.Gotham
    box.BorderSizePixel=0; box.ClearTextOnFocus=false; box.Parent=f; createCorner(box,6)
