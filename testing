-- ==================== LOADER ====================

local function createLoader(parent, size)
    local f=Instance.new("Frame"); f.Size=UDim2.new(0,size,0,size)
    f.Position=UDim2.new(0.5,-size/2,0.5,-size/2); f.BackgroundTransparency=1; f.Parent=parent
    local dots={}; local n=8; local r=size*0.3
    for i=1,n do
        local d=Instance.new("Frame"); d.Size=UDim2.new(0,8,0,8); d.BackgroundColor3=COLORS.ACCENT
        d.BorderSizePixel=0; d.BackgroundTransparency=1-i/n; d.Parent=f; createCorner(d,4)
        local a=(i-1)*(2*math.pi/n)
        d.Position=UDim2.new(0.5,math.cos(a)*r-4,0.5,math.sin(a)*r-4)
        table.insert(dots,d)
    end
    task.spawn(function()
        local idx=1
        while f.Parent do
            createTween(dots[idx],{BackgroundTransparency=0},0.1); task.wait(0.08)
            createTween(dots[idx],{BackgroundTransparency=0.85},0.4); idx=(idx%n)+1
        end
    end)
    return f
end

