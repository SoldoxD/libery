        local valPos = (1 - value) * svFrame.AbsoluteSize.Y
        svMarker.Position = UDim2.new(0, satPos, 0, valPos)
        hueMarker.Position = UDim2.new(0, -2, hue, -2)
    end

    local function updateSVAndHue()
        svFrame.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        updatePopupMarkers()
    end

    local function setHSV(newH, newS, newV)
        hue = math.clamp(newH or hue, 0, 1)
        saturation = math.clamp(newS or saturation, 0, 1)
        value = math.clamp(newV or value, 0, 1)
        currentColor = Color3.fromHSV(hue, saturation, value)
        rInput.Text = tostring(math.floor(currentColor.R * 255))
        gInput.Text = tostring(math.floor(currentColor.G * 255))
        bInput.Text = tostring(math.floor(currentColor.B * 255))
        colorDisplay.BackgroundColor3 = currentColor
        colorFrame:SetAttribute("ColorValue", currentColor)
        updateSVAndHue()
        if callback then callback(currentColor) end
        if not isInitializing then saveConfig(nil, true) end
    end

    local function setColor(valueInput)
        local parsed = nil
        if typeof(valueInput) == "Color3" then
            parsed = valueInput
        elseif type(valueInput) == "table" and valueInput.R and valueInput.G and valueInput.B then
            parsed = Color3.new(valueInput.R, valueInput.G, valueInput.B)
        end
        if parsed then
            currentColor = parsed
            hue, saturation, value = Color3.toHSV(currentColor)
            rInput.Text = tostring(math.floor(currentColor.R * 255))
            gInput.Text = tostring(math.floor(currentColor.G * 255))
            bInput.Text = tostring(math.floor(currentColor.B * 255))
            colorDisplay.BackgroundColor3 = currentColor
            colorFrame:SetAttribute("ColorValue", currentColor)
            updateSVAndHue()
            if callback then callback(currentColor) end
            if not isInitializing then saveConfig(nil, true) end
            return true
        end
        return false
    end

    local function screenPos(input)
        local pos = (input and input.Position) and input.Position or UserInputService:GetMouseLocation()
        if typeof(pos) == "Vector3" then return Vector2.new(pos.X, pos.Y) end
        if typeof(pos) == "Vector2" then return pos end
        return UserInputService:GetMouseLocation()
    end

    local function pickSV(source)
        local c = screenPos(source)
        local lx = math.clamp((c.X - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
        local ly = math.clamp((c.Y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
        setHSV(hue, lx, 1 - ly)
    end

    local function pickHue(source)
        local c = screenPos(source)
        local ly = math.clamp((c.Y - hueFrame.AbsolutePosition.Y) / hueFrame.AbsoluteSize.Y, 0, 1)
        setHSV(ly, saturation, value)
    end

    svFrame.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingSV = true; pickSV(i) end end)
    svFrame.InputChanged:Connect(function(i) if isDraggingSV and i.UserInputType == Enum.UserInputType.MouseMovement then pickSV(i) end end)
    svFrame.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingSV = false end end)

    hueFrame.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingHue = true; pickHue(i) end end)
    hueFrame.InputChanged:Connect(function(i) if isDraggingHue and i.UserInputType == Enum.UserInputType.MouseMovement then pickHue(i) end end)
    hueFrame.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingHue = false end end)

    local function onRGBFocusLost()
        local r = math.clamp(tonumber(rInput.Text) or 0, 0, 255)
        local g = math.clamp(tonumber(gInput.Text) or 0, 0, 255)
        local b = math.clamp(tonumber(bInput.Text) or 0, 0, 255)
        setColor(Color3.new(r/255, g/255, b/255))
    end
    rInput.FocusLost:Connect(onRGBFocusLost)
    gInput.FocusLost:Connect(onRGBFocusLost)
    bInput.FocusLost:Connect(onRGBFocusLost)

    local baseHeight = 50
    colorDisplay.MouseButton1Click:Connect(function()
        popupOpen = not popupOpen
        if popupOpen then
            createTween(colorFrame, {Size = UDim2.new(1, 0, 0, baseHeight + popupFrame.Size.Y.Offset + 8)})
            popupFrame.Visible = true
        else
            createTween(colorFrame, {Size = UDim2.new(1, 0, 0, baseHeight)})
            popupFrame.Visible = false
        end
    end)

    colorFrame:SetAttribute("ElementID", (tab.Name or "Tab") .. "_" .. text:gsub("%s+", "_") .. "_ColorPicker")
    colorFrame:SetAttribute("WidgetType", "ColorPicker")
    colorFrame:SetAttribute("ColorValue", currentColor)
    elementSetters[colorFrame] = setColor

    local eid = colorFrame:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type == "ColorPicker" then
        if setColor(restorationQueue[eid].Value) then
            dprint("Restored ColorPicker:", eid)
            restorationQueue[eid] = nil
        end
    end

    table.insert(tab.Elements, colorFrame)
    return {Frame = colorFrame, GetValue = function() return currentColor end, SetColor = setColor}
end

