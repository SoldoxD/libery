function GuiLibrary:CreateTab(window, name)
    local tabBtn=Instance.new("TextButton"); tabBtn.Name=name.."Tab"
    tabBtn.Size=UDim2.new(0,90,1,0); tabBtn.BackgroundColor3=COLORS.HOVER
    tabBtn.Text=name; tabBtn.TextColor3=COLORS.TEXT_MUTED; tabBtn.TextSize=12
    tabBtn.Font=Enum.Font.GothamBold; tabBtn.BorderSizePixel=0; tabBtn.AutoButtonColor=false
    tabBtn.Parent=window.TabsContainer; createCorner(tabBtn,8)

    local tabScroll=Instance.new("ScrollingFrame"); tabScroll.Name=name.."Content"
    tabScroll.Size=UDim2.new(1,0,1,0); tabScroll.BackgroundTransparency=1
    tabScroll.BorderSizePixel=0; tabScroll.ScrollBarThickness=4
    tabScroll.ScrollBarImageColor3=COLORS.ACCENT; tabScroll.Visible=false
    tabScroll.Parent=window.TabContentContainer

    local cl=Instance.new("UIListLayout"); cl.SortOrder=Enum.SortOrder.LayoutOrder; cl.Padding=UDim.new(0,8); cl.Parent=tabScroll
    local cp=Instance.new("UIPadding"); cp.PaddingTop=UDim.new(0,12); cp.PaddingLeft=UDim.new(0,12); cp.PaddingRight=UDim.new(0,12); cp.PaddingBottom=UDim.new(0,12); cp.Parent=tabScroll

    local function updateCanvas()
        local h=cp.PaddingTop.Offset+cp.PaddingBottom.Offset
        for _,c in ipairs(tabScroll:GetChildren()) do if c:IsA("GuiObject") then h=h+c.Size.Y.Offset+cl.Padding.Offset end end
        tabScroll.CanvasSize=UDim2.new(0,0,0,h)
    end
    cl.Changed:Connect(updateCanvas); tabScroll.ChildAdded:Connect(updateCanvas); tabScroll.ChildRemoved:Connect(updateCanvas); updateCanvas()

    local tab={Button=tabBtn,Content=tabScroll,Name=name,Elements={}}
    window.Tabs[name]=tab

    local function switchTo()
        if window.CurrentTab==name then return end
        if window.CurrentTab and window.Tabs[window.CurrentTab] then
            local cur=window.Tabs[window.CurrentTab]
            if cur.Button then createTween(cur.Button,{BackgroundColor3=COLORS.HOVER,TextColor3=COLORS.TEXT_MUTED}) end
            cur.Content.Visible=false
        end
        window.CurrentTab=name
        createTween(tabBtn,{BackgroundColor3=COLORS.ACCENT,TextColor3=Color3.new(1,1,1)})
        tabScroll.Visible=true
    end

    tabBtn.MouseButton1Click:Connect(switchTo)
    tabBtn.MouseEnter:Connect(function() if window.CurrentTab~=name then createTween(tabBtn,{BackgroundColor3=COLORS.BORDER}) end end)
    tabBtn.MouseLeave:Connect(function() if window.CurrentTab~=name then createTween(tabBtn,{BackgroundColor3=COLORS.HOVER}) end end)

    if not window.CurrentTab then
        window.CurrentTab=name
        createTween(tabBtn,{BackgroundColor3=COLORS.ACCENT,TextColor3=Color3.new(1,1,1)})
        tabScroll.Visible=true
    end

    updateElementColors(window)
    return tab
end

return GuiLibrary
