    keybindLabel.TextColor3 = COLORS.TEXT
    keybindLabel.TextSize = 13
    keybindLabel.Font = Enum.Font.Gotham
    keybindLabel.TextXAlignment = Enum.TextXAlignment.Left
    keybindLabel.Parent = keybindFrame

    local keybindButton = Instance.new("TextButton")
    keybindButton.Name = "KeybindButton"
    keybindButton.Size = UDim2.new(0, 72, 0, 26)
    keybindButton.Position = UDim2.new(1, -80, 0.5, -13)
    keybindButton.BackgroundColor3 = COLORS.PRIMARY
    keybindButton.Text = defaultKey and defaultKey.Name or "None"
    keybindButton.TextColor3 = COLORS.TEXT
    keybindButton.TextSize = 11
    keybindButton.Font = Enum.Font.GothamBold
    keybindButton.BorderSizePixel = 0
    keybindButton.AutoButtonColor = false
    keybindButton.Parent = keybindFrame
    createCorner(keybindButton, 6)
    createStroke(keybindButton, 1, COLORS.BORDER)

    local currentKey = defaultKey
    local listening = false
    local lastTrigger = 0

    local function setKeybind(value)
        if value and Enum.KeyCode[value] then
            currentKey = Enum.KeyCode[value]
            keybindButton.Text = currentKey.Name
            keybindFrame:SetAttribute("KeybindValue", currentKey.Name)
            return true
        elseif value == "None" or not value then
            currentKey = nil
            keybindButton.Text = "None"
            keybindFrame:SetAttribute("KeybindValue", "None")
            return true
        end
        return false
    end

    keybindButton.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        keybindButton.Text = "..."
        createTween(keybindButton, {BackgroundColor3 = COLORS.WARNING})
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                keybindButton.Text = input.KeyCode.Name
                keybindFrame:SetAttribute("KeybindValue", input.KeyCode.Name)
                listening = false
                createTween(keybindButton, {BackgroundColor3 = COLORS.PRIMARY})
                if conn then conn:Disconnect() end
                saveConfig(nil, true)
            end
        end)
    end)

    local keybindConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or listening then return end
        if tick() - lastTrigger < 0.2 then return end
        lastTrigger = tick()
        if currentKey and input.KeyCode == currentKey then
            if callback then callback() end
        end
    end)
    table.insert(activeInputConnections, keybindConn)

    keybindFrame:SetAttribute("ElementID", (tab.Name or "Tab") .. "_" .. text:gsub("%s+", "_") .. "_Keybind")
    keybindFrame:SetAttribute("WidgetType", "Keybind")
    keybindFrame:SetAttribute("KeybindValue", currentKey and currentKey.Name or "None")

    elementSetters[keybindFrame] = function(value)
        if setKeybind(value) and not isInitializing then saveConfig(nil, true) end
    end

    local eid = keybindFrame:GetAttribute("ElementID")
    if restorationQueue[eid] and restorationQueue[eid].Type == "Keybind" then
        if setKeybind(restorationQueue[eid].Value) then
            dprint("Restored Keybind:", eid, "=", restorationQueue[eid].Value)
            restorationQueue[eid] = nil
        end
    end

    table.insert(tab.Elements, keybindFrame)
    return {Frame = keybindFrame, GetKey = function() return currentKey end, SetKey = setKeybind}
end

