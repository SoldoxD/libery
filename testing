    sliderValue.TextSize = 13
    sliderValue.Font = Enum.Font.GothamBold
    sliderValue.TextXAlignment = Enum.TextXAlignment.Right
    sliderValue.Parent = sliderFrame

    local sliderTrack = Instance.new("Frame")
    sliderTrack.Name = "SliderTrack"
    sliderTrack.Size = UDim2.new(1, -28, 0, 6)
    sliderTrack.Position = UDim2.new(0, 14, 1, -20)
    sliderTrack.BackgroundColor3 = COLORS.BORDER
    sliderTrack.BorderSizePixel = 0
    sliderTrack.Parent = sliderFrame
    createCorner(sliderTrack, 3)

    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "SliderFill"
    sliderFill.Size = UDim2.new(0, 0, 1, 0)
    sliderFill.BackgroundColor3 = COLORS.ACCENT
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderTrack
    createCorner(sliderFill, 3)

    local sliderHandle = Instance.new("TextButton")
    sliderHandle.Name = "SliderHandle"
    sliderHandle.Size = UDim2.new(0, 18, 0, 18)
    sliderHandle.Position = UDim2.new(0, -9, 0.5, -9)
    sliderHandle.BackgroundColor3 = Color3.new(1, 1, 1)
    sliderHandle.Text = ""
    sliderHandle.BorderSizePixel = 0
    sliderHandle.AutoButtonColor = false
    sliderHandle.ZIndex = 2
    sliderHandle.Parent = sliderTrack
    createCorner(sliderHandle, 9)
    createStroke(sliderHandle, 1.5, COLORS.ACCENT)

    sliderFrame:SetAttribute("ElementID", (tab.Name or "Tab") .. "_" .. text:gsub("%s+", "_") .. "_Slider")
    sliderFrame:SetAttribute("WidgetType", "Slider")
    sliderFrame:SetAttribute("SliderMin", min)
    sliderFrame:SetAttribute("SliderMax", max)

    local elementID = sliderFrame:GetAttribute("ElementID")
    local currentValue = default or min
    local dragging = false

    local function updateSlider(value, shouldSave)
        shouldSave = shouldSave == nil and true or shouldSave
        currentValue = math.clamp(value, min, max)
        local pct = (currentValue - min) / (max - min)
        sliderFill.Size = UDim2.new(pct, 0, 1, 0)
        sliderHandle.Position = UDim2.new(pct, -9, 0.5, -9)
        sliderValue.Text = string.format("%.1f", currentValue)
        sliderFrame:SetAttribute("SliderValue", currentValue)
        if callback then callback(currentValue) end
        if shouldSave and not isInitializing then saveConfig(nil, true) end
    end

    sliderHandle.MouseButton1Down:Connect(function() dragging = true end)

    local inputEndedConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
        end
    end)
    table.insert(activeInputConnections, inputEndedConn)

    local inputChangedConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = input.Position.X
            local trackPos = sliderTrack.AbsolutePosition.X
            local trackSize = sliderTrack.AbsoluteSize.X
            local pct = math.clamp((mousePos - trackPos) / trackSize, 0, 1)
            updateSlider(min + (max - min) * pct)
        end
    end)
    table.insert(activeInputConnections, inputChangedConn)

    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local pct = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
            updateSlider(min + (max - min) * pct)
            dragging = true
        end
    end)

    elementSetters[sliderFrame] = updateSlider

    if restorationQueue[elementID] and restorationQueue[elementID].Type == "Slider" then
        local savedValue = tonumber(restorationQueue[elementID].Value)
        updateSlider(savedValue ~= nil and savedValue or currentValue, false)
        dprint("Restored Slider:", elementID, "=", savedValue)
        restorationQueue[elementID] = nil
    else
        updateSlider(currentValue, false)
    end

    table.insert(tab.Elements, sliderFrame)
    return {
        Frame    = sliderFrame,
        GetValue = function() return currentValue end,
        SetValue = function(value) updateSlider(value, false) end,
    }
end

