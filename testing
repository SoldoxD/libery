    dropdownLabel.Size = UDim2.new(1, -32, 1, 0)
    dropdownLabel.Position = UDim2.new(0, 10, 0, 0)
    dropdownLabel.BackgroundTransparency = 1
    dropdownLabel.Text = text .. ":  " .. (options[1] or "None")
    dropdownLabel.TextColor3 = COLORS.TEXT
    dropdownLabel.TextSize = 12
    dropdownLabel.Font = Enum.Font.Gotham
    dropdownLabel.TextXAlignment = Enum.TextXAlignment.Left
    dropdownLabel.ZIndex = 111
    dropdownLabel.Parent = dropdownButton

    local dropdownArrow = Instance.new("TextLabel")
    dropdownArrow.Name = "DropdownArrow"
    dropdownArrow.Size = UDim2.new(0, 22, 1, 0)
    dropdownArrow.Position = UDim2.new(1, -22, 0, 0)
    dropdownArrow.BackgroundTransparency = 1
    dropdownArrow.Text = "‹"
    dropdownArrow.TextColor3 = COLORS.TEXT_MUTED
    dropdownArrow.TextSize = 16
    dropdownArrow.Font = Enum.Font.GothamBold
    dropdownArrow.Rotation = -90
    dropdownArrow.ZIndex = 112
    dropdownArrow.Parent = dropdownButton

    local dropdownList = Instance.new("ScrollingFrame")
    dropdownList.Name = "DropdownList"
    dropdownList.Size = UDim2.new(1, -16, 0, 0)
    dropdownList.Position = UDim2.new(0, 8, 0, 44)
    dropdownList.BackgroundColor3 = COLORS.PRIMARY
    dropdownList.BorderSizePixel = 0
    dropdownList.Visible = false
    dropdownList.ZIndex = 100
    dropdownList.ScrollBarThickness = 4
    dropdownList.ScrollBarImageColor3 = COLORS.ACCENT
    dropdownList.Parent = dropdownFrame
    createCorner(dropdownList, 6)
    createStroke(dropdownList, 1, COLORS.BORDER)

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = dropdownList

    local listPadding = Instance.new("UIPadding")
    listPadding.PaddingTop    = UDim.new(0, 4)
    listPadding.PaddingBottom = UDim.new(0, 4)
    listPadding.PaddingLeft   = UDim.new(0, 4)
    listPadding.PaddingRight  = UDim.new(0, 4)
    listPadding.Parent = dropdownList

    local currentOptions  = {table.unpack(options)}
    local currentSelection = currentOptions[1] or "None"
    local isOpen = false

    local originalPositions = {}
    local baseY = dropdownFrame.Position.Y.Offset + dropdownFrame.Size.Y.Offset
    for _, element in ipairs(tab.Content:GetChildren()) do
        if element:IsA("GuiObject") and element ~= dropdownFrame and element.Position.Y.Offset >= baseY then
            originalPositions[element] = element.Position
        end
    end

    local function closeInstant()
        isOpen = false
        dropdownArrow.Rotation = -90
        dropdownList.Size = UDim2.new(1, -16, 0, 0)
        dropdownList.Visible = false
        dropdownFrame.Size = UDim2.new(1, 0, 0, 40)
        for element, pos in pairs(originalPositions) do
            element.Position = pos
        end
    end

    local function buildOptionButtons(opts)
        for _, child in ipairs(dropdownList:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        dropdownList.CanvasSize = UDim2.new(0, 0, 0, #opts * 28 + 8)

        for i, opt in ipairs(opts) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, 0, 0, 28)
            optBtn.BackgroundColor3 = COLORS.ACCENT
            optBtn.BackgroundTransparency = 1
            optBtn.Text = opt
            optBtn.TextColor3 = COLORS.TEXT_MUTED
            optBtn.TextSize = 12
            optBtn.Font = Enum.Font.Gotham
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.BorderSizePixel = 0
            optBtn.LayoutOrder = i
            optBtn.ZIndex = 101
            optBtn.Parent = dropdownList

            local optPad = Instance.new("UIPadding")
            optPad.PaddingLeft = UDim.new(0, 8)
            optPad.Parent = optBtn

            createCorner(optBtn, 4)

            optBtn.MouseButton1Click:Connect(function()
                currentSelection = opt
                dropdownLabel.Text = text .. ":  " .. opt
                dropdownFrame:SetAttribute("DropdownValue", opt)
                isOpen = false
                createTween(dropdownArrow, {Rotation = -90})
                createTween(dropdownList, {Size = UDim2.new(1, -16, 0, 0)})
                for element, pos in pairs(originalPositions) do
                    createTween(element, {Position = pos})
                end
                task.wait(ANIM_TIME)
                dropdownList.Visible = false
                dropdownFrame.Size = UDim2.new(1, 0, 0, 40)
                if callback then callback(opt) end
                saveConfig(nil, true)
            end)
            optBtn.MouseEnter:Connect(function()
                createTween(optBtn, {BackgroundTransparency = 0.85, TextColor3 = COLORS.TEXT})
            end)
            optBtn.MouseLeave:Connect(function()
                createTween(optBtn, {BackgroundTransparency = 1, TextColor3 = COLORS.TEXT_MUTED})
            end)
        end
    end

    buildOptionButtons(currentOptions)

    dropdownButton.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            local dropdownHeight = math.min(#currentOptions * 28 + 8, 130)
            dropdownFrame.Size = UDim2.new(1, 0, 0, 40 + 4 + dropdownHeight)
            dropdownList.CanvasSize = UDim2.new(0, 0, 0, #currentOptions * 28 + 8)
            dropdownList.Visible = true
            createTween(dropdownArrow, {Rotation = 90})
            createTween(dropdownList, {Size = UDim2.new(1, -16, 0, dropdownHeight)})
            for element, pos in pairs(originalPositions) do
                createTween(element, {Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + dropdownHeight + 4)})
            end
        else
            createTween(dropdownArrow, {Rotation = -90})
            createTween(dropdownList, {Size = UDim2.new(1, -16, 0, 0)})
            for element, pos in pairs(originalPositions) do
                createTween(element, {Position = pos})
            end
            task.wait(ANIM_TIME)
            dropdownList.Visible = false
            dropdownFrame.Size = UDim2.new(1, 0, 0, 40)
        end
    end)

    local function setDropdownValue(value)
        if not value then return end
        for _, opt in ipairs(currentOptions) do
            if opt == value then
                currentSelection = opt
                dropdownLabel.Text = text .. ":  " .. opt
                dropdownFrame:SetAttribute("DropdownValue", opt)
                if callback then callback(opt) end
                return
            end
        end
    end

    local function updateOptions(newOptions, keepSelection)
        if isOpen then closeInstant() end
        currentOptions = {table.unpack(newOptions)}
        buildOptionButtons(currentOptions)

        local stillValid = false
        if keepSelection then
            for _, opt in ipairs(currentOptions) do
                if opt == currentSelection then stillValid = true; break end
            end
        end

        if stillValid then
            dropdownLabel.Text = text .. ":  " .. currentSelection
            dropdownFrame:SetAttribute("DropdownValue", currentSelection)
        else
            currentSelection = currentOptions[1] or "None"
            dropdownLabel.Text = text .. ":  " .. currentSelection
            dropdownFrame:SetAttribute("DropdownValue", currentSelection)
            if callback then callback(currentSelection) end
        end
    end

    dropdownFrame:SetAttribute("ElementID", (tab.Name or "Tab") .. "_" .. text:gsub("%s+", "_") .. "_Dropdown")
    dropdownFrame:SetAttribute("WidgetType", "Dropdown")
    dropdownFrame:SetAttribute("DropdownValue", currentSelection)

    elementSetters[dropdownFrame] = setDropdownValue

    local elementID = dropdownFrame:GetAttribute("ElementID")
    if restorationQueue[elementID] and restorationQueue[elementID].Type == "Dropdown" then
        local savedValue = restorationQueue[elementID].Value
        setDropdownValue(savedValue)
        dprint("Restored Dropdown:", elementID, "=", savedValue)
        restorationQueue[elementID] = nil
    end

    table.insert(tab.Elements, dropdownFrame)
    return {
        Frame         = dropdownFrame,
        GetValue      = function() return currentSelection end,
        SetValue      = setDropdownValue,
        UpdateOptions = updateOptions,
    }
end

