    dropBtn.BackgroundColor3=COLORS.PRIMARY; dropBtn.Text=""
    dropBtn.BorderSizePixel=0; dropBtn.AutoButtonColor=false; dropBtn.ZIndex=2; dropBtn.Parent=dropFrame
    createCorner(dropBtn,6)

    local dropLbl=Instance.new("TextLabel"); dropLbl.Name="DropdownLabel"
    dropLbl.Size=UDim2.new(1,-30,1,0); dropLbl.Position=UDim2.new(0,10,0,0)
