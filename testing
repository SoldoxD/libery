local function saveConfig(window, force)
    if not force and not autoSaveEnabled then return end
    if isInitializing then return end
    window = window or GuiLibrary.CurrentWindow
    if not window or not window.CurrentSize then return end

    local ok = pcall(function()
        if not isfolder(AUTO_SAVE_FOLDER) then makefolder(AUTO_SAVE_FOLDER) end
    end)
    if not ok then return end

    local config = {
        UIScale        = window.CurrentSize.X.Offset / 600,
        AnimationsEnabled = (ANIM_TIME > 0.05),
        AutoSaveEnabled   = autoSaveEnabled,
        Theme = nil,
        Components = {}
    }

    for name, theme in pairs(themes) do
        local match = true
        for k, v in pairs(theme) do
            if not COLORS[k] or COLORS[k] ~= v then match = false; break end
        end
        if match then config.Theme = name; break end
    end

    for _, tab in pairs(window.Tabs or {}) do
        for _, element in ipairs(tab.Elements or {}) do
            local id = element:GetAttribute("ElementID")
            if not id then
                local n = element.Name or ""
                local base = n:gsub("Toggle$","_Toggle"):gsub("Slider$","_Slider"):gsub("Dropdown$","_Dropdown"):gsub("ColorPicker$","_ColorPicker"):gsub("Input$","_Input"):gsub("Keybind$","_Keybind"):gsub("%s+","_")
                id = (tab.Name or "Tab") .. "_" .. base
                element:SetAttribute("ElementID", id)
            end

            local data = {Type=nil, Value=nil}
            local wt = element:GetAttribute("WidgetType")
            if wt == "Toggle" then
                local isOn = element:GetAttribute("ToggleState") == 1
                data = {Type="Toggle", Value=isOn}
            elseif wt == "Slider" then
                data = {Type="Slider", Value=element:GetAttribute("SliderValue") or 0}
            elseif wt == "Dropdown" then
                local v = element:GetAttribute("DropdownValue")
                if v then data = {Type="Dropdown", Value=v} end
            elseif wt == "ColorPicker" then
                local v = element:GetAttribute("ColorValue")
                if v then
                    if typeof(v) == "Color3" then
                        data = {Type="ColorPicker", Value={R=v.R, G=v.G, B=v.B}}
                    elseif type(v) == "table" then
                        data = {Type="ColorPicker", Value=v}
                    end
                end
            elseif wt == "Input" then
                local v = element:GetAttribute("InputValue")
                if v then data = {Type="Input", Value=v} end
            elseif wt == "Keybind" then
                local v = element:GetAttribute("KeybindValue")
                if v and v ~= "None" then data = {Type="Keybind", Value=v} end
            end
            if data.Type then
                table.insert(config.Components, {ID=id, Data=data})
            end
        end
    end

    local jsonStr = HttpService:JSONEncode(config)
    local writeOk, writeErr = pcall(function() writefile(getAutoSavePath(), jsonStr) end)
    if writeOk then dprint("Config saved to:", getAutoSavePath())
    else warn("[GuiLibrary] Failed to save config: " .. tostring(writeErr)) end
end
GuiLibrary.SaveConfig = saveConfig

local function loadConfig(window)
    if not window then return false end
    local path = getAutoSavePath()
    dprint("Loading config from:", path)

    local fileExists = false
    pcall(function() fileExists = isfile(path) end)
    if not fileExists then dprint("No save file found"); return false end

    local readOk, config = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not readOk or not config then dprint("Failed to read/decode config"); return false end

    if config.AnimationsEnabled ~= nil then
        ANIM_TIME = config.AnimationsEnabled and 0.25 or 0.01
        dprint("Restored AnimationsEnabled:", config.AnimationsEnabled)
    end
    if config.AutoSaveEnabled ~= nil then
        autoSaveEnabled = config.AutoSaveEnabled == true
        dprint("Restored AutoSaveEnabled:", autoSaveEnabled)
    end
    if config.Theme and themes[config.Theme] then
        for k, v in pairs(themes[config.Theme]) do COLORS[k] = v end
        dprint("Restored Theme:", config.Theme)
    end
    if config.UIScale then
        local newSize = UDim2.new(0, 600 * config.UIScale, 0, 400 * config.UIScale)
        window.CurrentSize = newSize
        if window.MainFrame then window.MainFrame.Size = newSize end
        dprint("Restored UIScale:", config.UIScale)
    end

    restorationQueue = {}
    if autoSaveEnabled then
        for _, entry in ipairs(config.Components or {}) do
            restorationQueue[entry.ID] = entry.Data
            dprint("Queued:", entry.ID, "(" .. entry.Data.Type .. ")")
        end
        for _, tab in pairs(window.Tabs or {}) do
            for _, el in ipairs(tab.Elements or {}) do
                local id = el:GetAttribute("ElementID")
                if id and restorationQueue[id] then
                    local data = restorationQueue[id]
                    local setter = elementSetters[el]
                    if setter and data.Value ~= nil then
                        setter(data.Value, false)
                        dprint("Applied:", id, "=", data.Value)
                    end
                    restorationQueue[id] = nil
                end
            end
        end
    else
        dprint("Auto-save disabled — keeping defaults")
    end

    if window.Tabs and window.Tabs.Settings then
        for _, el in ipairs(window.Tabs.Settings.Elements or {}) do
            if el.Name == "Auto Save ConfigToggle" then
                local setFunc = elementSetters[el]
                if setFunc then setFunc(autoSaveEnabled) end
                break
            end
        end
    end

    updateElementColors(window, true)
    dprint("Config loaded successfully")
    return true
end
GuiLibrary.LoadConfig = loadConfig

function GuiLibrary:TestFileSaving()
    print("[GuiLibrary] ===== FILE I/O DIAGNOSTIC TEST =====")
    local testFolder = "GuiLibrary_AutoSaves"
    local testFile = testFolder .. "/test_" .. tostring(game.PlaceId) .. ".json"
    local testData = {test = true, timestamp = os.time()}

    print("[TEST 1] Creating folder: " .. testFolder)
    local folderOk, folderErr = pcall(function()
        if not isfolder(testFolder) then makefolder(testFolder) print("✓ Folder created")
        else print("✓ Folder already exists") end
    end)
    if not folderOk then print("✗ Folder creation failed:", folderErr); return false end

    print("[TEST 2] Writing test file: " .. testFile)
    local writeOk, writeErr = pcall(function()
        writefile(testFile, HttpService:JSONEncode(testData))
        print("✓ File written successfully")
    end)
    if not writeOk then print("✗ File write failed:", writeErr); return false end

    print("[TEST 3] Checking if file exists: " .. testFile)
    local checkOk, checkErr = pcall(function()
        local exists = isfile(testFile)
        if exists then print("✓ File exists") else print("✗ File does not exist after write!") end
    end)
    if not checkOk then print("✗ File check failed:", checkErr); return false end

    print("[TEST 4] Reading test file: " .. testFile)
    local readOk, readData = pcall(function() return HttpService:JSONDecode(readfile(testFile)) end)
    if not readOk then print("✗ File read failed:", readData); return false end
    if readData and readData.test then print("✓ File read and verified") else print("✗ File data is invalid"); return false end

    print("[TEST 5] Deleting test file: " .. testFile)
    local delOk, delErr = pcall(function() delfile(testFile); print("✓ File deleted") end)
    if not delOk then print("⚠ delfile failed (may not be supported):", delErr) end

    print("[GuiLibrary] ===== ALL TESTS PASSED =====")
    return true
end

