local function getAutoSavePath() return AUTO_SAVE_FOLDER .. "/" .. currentPlaceId .. ".json" end

local function createTween(obj, props, t)
    if not obj or not obj.Parent then return nil end
    local ti = TweenInfo.new(t or ANIM_TIME, EASING_STYLE, EASING_DIR)
    local tw = TweenService:Create(obj, ti, props)
    tw:Play(); return tw
end

local function createCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent; return c
end

local function createStroke(parent, thickness, color)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Color = color or COLORS.BORDER
    s.Parent = parent; return s
end

-- ==================== THEME RECOLOR ====================

local function updateElementColors(window, instant)
    local function apply(obj, props)
        if not obj then return end
        if instant then for k,v in pairs(props) do obj[k]=v end else createTween(obj,props) end
    end

    if window.MainFrame then
        apply(window.MainFrame, {BackgroundColor3=COLORS.PRIMARY})
        local s = window.MainFrame:FindFirstChildWhichIsA("UIStroke")
        if s then apply(s,{Color=COLORS.BORDER}) end
    end

    local tb = window.MainFrame and window.MainFrame:FindFirstChild("TitleBar")
    if tb then
        apply(tb,  {BackgroundColor3=COLORS.SECONDARY})
        apply(tb:FindFirstChild("TitleBarFill"), {BackgroundColor3=COLORS.SECONDARY})
        apply(tb:FindFirstChild("TitleAccent"),  {BackgroundColor3=COLORS.ACCENT})
        apply(tb:FindFirstChild("TitleLabel"),   {TextColor3=COLORS.TEXT})
        local fps = tb:FindFirstChild("FPSLabel")
        if fps then apply(fps,{BackgroundColor3=COLORS.HOVER,TextColor3=COLORS.SUCCESS}) end
        local sb = tb:FindFirstChild("SettingsButton")
        if sb then apply(sb,{TextColor3=COLORS.TEXT_MUTED}) end
        local cb = tb:FindFirstChild("CloseButton")
        if cb then apply(cb,{BackgroundColor3=COLORS.DANGER}) end
    end

    for tabName, tab in pairs(window.Tabs or {}) do
        if tab.Button then
            local isActive = window.CurrentTab == tabName
            apply(tab.Button, {BackgroundColor3=isActive and COLORS.ACCENT or COLORS.HOVER, TextColor3=isActive and Color3.new(1,1,1) or COLORS.TEXT_MUTED})
        end
        if tab.Content then apply(tab.Content,{ScrollBarImageColor3=COLORS.ACCENT}) end
        for _, el in ipairs(tab.Elements or {}) do
            if el and el:IsA("GuiObject") then
                local n = el.Name
                if n:match("Button") and not n:match("Tab") then
                    apply(el,{BackgroundColor3=COLORS.ACCENT,TextColor3=Color3.new(1,1,1)})
                elseif n:match("Toggle") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local sw = el:FindFirstChild("ToggleSwitch")
                    if sw then
                        local ind = sw:FindFirstChild("Indicator")
                        local isOn = el:GetAttribute("ToggleState")==1
                        apply(sw,{BackgroundColor3=isOn and COLORS.SUCCESS or COLORS.BORDER})
                        if ind then apply(ind,{BackgroundColor3=Color3.new(1,1,1)}) end
                    end
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.TEXT})
                elseif n:match("Slider") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local tr = el:FindFirstChild("SliderTrack")
                    if tr then
                        apply(tr,{BackgroundColor3=COLORS.BORDER})
                        local fill = tr:FindFirstChild("SliderFill")
                        if fill then apply(fill,{BackgroundColor3=COLORS.ACCENT}) end
                        local h = tr:FindFirstChild("SliderHandle")
                        if h then apply(h,{BackgroundColor3=Color3.new(1,1,1)}) end
                    end
                    apply(el:FindFirstChild("SliderLabel"),{TextColor3=COLORS.TEXT})
                    apply(el:FindFirstChild("SliderValue"),{TextColor3=COLORS.ACCENT})
                elseif n:match("Section") then
                    local bar = el:FindFirstChild("AccentBar")
                    if bar then apply(bar,{BackgroundColor3=COLORS.ACCENT}) end
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.ACCENT})
                elseif n:match("Label") then
                    apply(el,{TextColor3=COLORS.TEXT_MUTED})
                elseif n:match("Dropdown") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local btn = el:FindFirstChild("DropdownButton")
                    if btn then
                        apply(btn,{BackgroundColor3=COLORS.PRIMARY})
                        local lbl = btn:FindFirstChildWhichIsA("TextLabel")
                        if lbl then apply(lbl,{TextColor3=COLORS.TEXT}) end
                        local arrow = btn:FindFirstChild("DropdownArrow")
                        if arrow then apply(arrow,{TextColor3=COLORS.TEXT_MUTED}) end
                    end
                elseif n:match("Input") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    local box = el:FindFirstChildWhichIsA("TextBox")
                    if box then apply(box,{BackgroundColor3=COLORS.PRIMARY,TextColor3=COLORS.TEXT,PlaceholderColor3=COLORS.TEXT_MUTED}) end
                elseif n:match("Keybind") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.TEXT})
                    local kb = el:FindFirstChild("KeybindButton")
                    if kb then apply(kb,{BackgroundColor3=COLORS.PRIMARY,TextColor3=COLORS.TEXT}) end
                elseif n:match("ColorPicker") then
                    apply(el,{BackgroundColor3=COLORS.HOVER})
                    apply(el:FindFirstChildWhichIsA("TextLabel"),{TextColor3=COLORS.TEXT})
                end
            end
        end
    end
end

-- ==================== CONFIG SYSTEM ====================

local function saveConfig(window, force)
    if not force and not autoSaveEnabled then return end
    if isInitializing then return end
    window = window or GuiLibrary.CurrentWindow
    if not window or not window.CurrentSize then return end

    local ok = pcall(function()
        if not isfolder(AUTO_SAVE_FOLDER) then makefolder(AUTO_SAVE_FOLDER) end
    end)
    if not ok then return end

    local config = { UIScale=window.CurrentSize.X.Offset/600, AnimationsEnabled=(ANIM_TIME>0.05), AutoSaveEnabled=autoSaveEnabled, Theme=nil, Components={} }

    for name, theme in pairs(themes) do
        local match=true
        for k,v in pairs(theme) do if not COLORS[k] or COLORS[k]~=v then match=false;break end end
        if match then config.Theme=name;break end
    end

    for _, tab in pairs(window.Tabs or {}) do
        for _, el in ipairs(tab.Elements or {}) do
            local id = el:GetAttribute("ElementID")
            if not id then
                local n = el.Name or ""
                id = (tab.Name or "Tab").."_"..n:gsub("%s+","_")
                el:SetAttribute("ElementID",id)
            end
            local wt = el:GetAttribute("WidgetType")
            local data = nil
            if wt=="Toggle" then data={Type="Toggle",Value=el:GetAttribute("ToggleState")==1}
            elseif wt=="Slider" then data={Type="Slider",Value=el:GetAttribute("SliderValue") or 0}
            elseif wt=="Dropdown" then local v=el:GetAttribute("DropdownValue"); if v then data={Type="Dropdown",Value=v} end
            elseif wt=="ColorPicker" then local v=el:GetAttribute("ColorValue"); if v then data={Type="ColorPicker",Value=typeof(v)=="Color3" and {R=v.R,G=v.G,B=v.B} or v} end
            elseif wt=="Input" then local v=el:GetAttribute("InputValue"); if v then data={Type="Input",Value=v} end
            elseif wt=="Keybind" then local v=el:GetAttribute("KeybindValue"); if v and v~="None" then data={Type="Keybind",Value=v} end end
            if data then table.insert(config.Components,{ID=id,Data=data}) end
        end
    end

    local wOk,wErr=pcall(function() writefile(getAutoSavePath(), HttpService:JSONEncode(config)) end)
    if wOk then dprint("Config saved") else warn("[GuiLibrary] Save failed: "..tostring(wErr)) end
end
GuiLibrary.SaveConfig = saveConfig

local function loadConfig(window)
    if not window then return false end
    local fileExists=false; pcall(function() fileExists=isfile(getAutoSavePath()) end)
    if not fileExists then dprint("No save file"); return false end
    local rOk,config=pcall(function() return HttpService:JSONDecode(readfile(getAutoSavePath())) end)
    if not rOk or not config then return false end
    if config.AnimationsEnabled~=nil then ANIM_TIME=config.AnimationsEnabled and 0.25 or 0.01 end
    if config.AutoSaveEnabled~=nil then autoSaveEnabled=config.AutoSaveEnabled==true end
    if config.Theme and themes[config.Theme] then for k,v in pairs(themes[config.Theme]) do COLORS[k]=v end end
    if config.UIScale then
        local ns=UDim2.new(0,600*config.UIScale,0,400*config.UIScale)
        window.CurrentSize=ns; if window.MainFrame then window.MainFrame.Size=ns end
    end
    restorationQueue={}
    if autoSaveEnabled then
        for _,entry in ipairs(config.Components or {}) do restorationQueue[entry.ID]=entry.Data end
        for _,tab in pairs(window.Tabs or {}) do
            for _,el in ipairs(tab.Elements or {}) do
                local id=el:GetAttribute("ElementID")
                if id and restorationQueue[id] then
                    local setter=elementSetters[el]
                    if setter and restorationQueue[id].Value~=nil then setter(restorationQueue[id].Value,false) end
                    restorationQueue[id]=nil
                end
            end
        end
    end
    if window.Tabs and window.Tabs.Settings then
        for _,el in ipairs(window.Tabs.Settings.Elements or {}) do
            if el.Name=="Auto Save ConfigToggle" then
                local sf=elementSetters[el]; if sf then sf(autoSaveEnabled) end; break
            end
        end
    end
    updateElementColors(window,true); return true
end
GuiLibrary.LoadConfig = loadConfig

